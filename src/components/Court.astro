<figure class:list={['court', { multi, still }]} style={`--cols: ${Math.min(panels.length, 4)}`}>
	{
		multi && (
			<div class="anim" data-court-anim>
				<div class="anim-stage">
					{panels.map((pn, i) => (
						<CourtFrame
							figures={pn.figures}
							lines={pn.lines}
							viewBox={viewBox}
							zones={diagram.zones}
							fences={diagram.fences}
							uid={`${uid}a${i}`}
							playerR={PLAYER_R}
							title={`${title}（アニメーション ${i + 1}）`}
							animated
							side={side}
							step={i}
							score={scores?.[i]}
							win={diagram.score && scores && Math.abs(scores[i].after) >= diagram.score.to && Math.abs(scores[i].before) < diagram.score.to
								? (scores[i].after > 0 ? diagram.score.plus : diagram.score.minus)
								: undefined}
						/>
					))}
				</div>
