---
import type { Diagram } from '../content.config';
import {
	COURT,
	shotLabels,
	shotCurve,
	animMs,
	heightLevels,
	shotHeights,
	defaultReceiveHeight,
	type HeightLevel,
	type ShotType,
	reactionMs,
	WAIST_FT,
} from '../config/court';
import CourtFrame from './CourtFrame.astro';
import '../styles/court.css';

interface Props {
	diagram: Diagram;
	title?: string;
	/** すべての手を1枚の止まった図に重ねて描く（共有のプレビュー画像用）。線の名前に①②を付ける */
	still?: boolean;
}
const { diagram, title = 'コート図', still = false } = Astro.props;

/**
 * 人・腕・パドルは見やすさ優先で、コートの縮尺より大きく描く（単位はフィート相当）。
 * 共有のプレビュー画像（still）は、LINE などで小さく出るので、さらに FIG 倍で描く（styles/court.css の .court.still と合わせる）
 */
const FIG = still ? 1.5 : 1;
const PLAYER_R = 1.3 * FIG;
const uid = `c${Math.random().toString(36).slice(2, 8)}`;
const k1 = COURT.net - COURT.kitchen;
const k2 = COURT.net + COURT.kitchen;

type Point = [number, number];
type Player = Diagram['players'][number];
type Shot = Diagram['shots'][number];

/** 人の体・腕・パドルの位置を計算する（上から見た図。右利きなら本人から見て右手にパドル） */
function figureOf(p: Player, pos: Point) {
	const [x, y] = pos;
	const facing = p.facing ?? (y < COURT.net ? 'down' : 'up');
	const f: Point = facing === 'up' ? [0, -1] : [0, 1]; // 前
	const side = p.lefty ? -1 : 1;
	// 本人から見た右（上向きなら +x、下向きなら -x）。左利きなら逆側
	const r: Point = [-f[1] * side, f[0] * side];
	const at = (dr: number, df: number): Point => [x + (r[0] * dr + f[0] * df) * FIG, y + (r[1] * dr + f[1] * df) * FIG];
	// 構えごとの、肩・手・パドルの先の位置（体の中心からの「右」「前」の距離）
	// 腕 = 肩→手の細線、パドル = 手→先の太線。体から斜め前へ開くように描く
	const pose = {
		ready: { shoulder: [0.9, 0.5], hand: [1.55, 1.15], tip: [2.05, 1.6] }, // 右肩から右斜め前へ開く
		fh: { shoulder: [1.2, 0.3], hand: [2.0, 0.65], tip: [2.65, 0.9] }, // フォア側（右）へ大きく開く
		bh: { shoulder: [-0.9, 0.5], hand: [-1.55, 1.15], tip: [-2.05, 1.6] }, // バック側（左）斜め前へ開く
	}[p.paddle];
	const shoulder = at(pose.shoulder[0], pose.shoulder[1]);
	const hand = at(pose.hand[0], pose.hand[1]);
	const tip = at(pose.tip[0], pose.tip[1]);
	// 打球の線はパドルの真ん中から出す
	const face: Point = [(hand[0] + tip[0]) / 2, (hand[1] + tip[1]) / 2];
	return { ...p, x, y, shoulder, hand, tip, face };
}
type Figure = ReturnType<typeof figureOf>;

/** 端を縮める量（体の円・パドルの太線と重ならないように） */
const inset = { body: PLAYER_R + 0.3, paddle: 0.45 * FIG, point: 0 } as const;

/**
 * 打球・動きの線を計算する。人を指す参照は、打球ならパドルの真ん中、人の動きなら体の中心へ。
 * 弧の大きさは打球の種類で決める（config/court.ts の shotCurve）。
 * データの curve は重なりよけ用なので、1コマに1手のコマ割り（straight=true）では使わない。
 */
function lineOf(s: Shot, byId: Map<string, Figure>, straight: boolean, byIdTo: Map<string, Figure> = byId) {
	const target = s.type === 'move' ? 'body' : 'paddle';
	const resolve = (ref: string | Point, map = byId) => {
		if (typeof ref === 'string') {
			const p = map.get(ref);
			if (!p) throw new Error(`コート図: 人 "${ref}" が players にありません`);
			return target === 'paddle'
				? { pt: p.face, anchor: 'paddle' as const }
				: { pt: [p.x, p.y] as Point, anchor: 'body' as const };
		}
		return { pt: ref, anchor: 'point' as const };
	};
	const a = resolve(s.from);
	// 打球の行き先の人は、同じ手で動く（move）なら動いた先で受ける
	const b = resolve(s.to, s.type === 'move' ? byId : byIdTo);
	let [x1, y1] = a.pt;
	let [x2, y2] = b.pt;
	const len = Math.hypot(x2 - x1, y2 - y1) || 1;
	const ux = (x2 - x1) / len;
	const uy = (y2 - y1) / len;
	const startInset = a.anchor === 'body' ? PLAYER_R : 0;
	[x1, y1] = [x1 + ux * startInset, y1 + uy * startInset];
	[x2, y2] = [x2 - ux * inset[b.anchor], y2 - uy * inset[b.anchor]];
	const typeCurve = shotCurve[s.type];
	const curve = straight ? typeCurve : (s.curve ?? typeCurve);
	// 曲げる量は距離に比例。正で進行方向の左側へふくらむ
	const cx = (x1 + x2) / 2 - uy * len * curve;
	const cy = (y1 + y2) / 2 + ux * len * curve;
	const d = curve ? `M${x1} ${y1} Q${cx} ${cy} ${x2} ${y2}` : `M${x1} ${y1} L${x2} ${y2}`;
	const pointAt = (t: number): Point =>
		curve
			? [(1 - t) ** 2 * x1 + 2 * (1 - t) * t * cx + t ** 2 * x2, (1 - t) ** 2 * y1 + 2 * (1 - t) * t * cy + t ** 2 * y2]
			: [x1 + (x2 - x1) * t, y1 + (y2 - y1) * t];
	// 名前は線の真ん中に置く。ネットの線や人に重なるときは、線の上の別の位置にずらす
	const bodies = [...byId.values()].map((p) => [p.x, p.y] as Point);
	const clear = (p: Point) =>
		Math.abs(p[1] - COURT.net) >= 1.6 && bodies.every(([bx, by]) => Math.hypot(p[0] - bx, p[1] - by) >= PLAYER_R + 1.6);
	const candidates = [0.5, 0.4, 0.6, 0.3, 0.7, 0.2, 0.8].map(pointAt);
	const mid = candidates.find(clear) ?? candidates.find((p) => Math.abs(p[1] - COURT.net) >= 1.6) ?? candidates[0];
	// 人の動き（move）には名前を付けない（矢印だけで分かり、名前を置くと人に重なるため）
	const label = s.type === 'move' ? s.label : (s.label ?? (s.feed ? `球出し（${shotLabels[s.type]}）` : shotLabels[s.type]));
	const receiver = typeof s.to === 'string' ? byIdTo.get(s.to) : undefined;
	const bounces = bouncesOf(s, b.anchor, pointAt, receiver?.y);
	// ネットを越える位置（線の長さに対する割合）。越えなければ undefined
	const netAt = (y1 - COURT.net) * (y2 - COURT.net) < 0 ? (COURT.net - y1) / (y2 - y1) : undefined;
	// 飛ぶ時間は距離 ÷ 球の種類ごとの速さ（同じ種類の球は、距離によらず同じ速さに見える）
	const ms = animMs(s.type, Math.hypot(x2 - x1, y2 - y1));
	// 打つ前に一度弾ませる球（手から落とす球出し、トラップして弾ませる球）: パドルの真下で弾み、打点まで上がってから飛んでいく。
	// 弾む位置をパドルと同じ所にするので、上から見た図でボールが横に跳ばない
	const hitter = typeof s.from === 'string' ? byId.get(s.from) : undefined;
	const pre: Point | undefined = s.afterBounce && hitter ? [hitter.face[0], hitter.face[1]] : undefined;
	// トラップ: この人に向かってくる球（ループで前にある球も含む）があれば、その球を受けた高さから始め、
	// 面でポンと少し上げてから落とす。なければ手から落とす球出し
	const preFromH = pre ? trapFromHeight(s) : undefined;
	// 人の動きで、体の中心がどれだけ動くか。線は丸と重ならないよう両端を縮めて描くので、線の長さとは違う
	const shift: Point | undefined = s.type === 'move' ? [b.pt[0] - a.pt[0], b.pt[1] - a.pt[1]] : undefined;
	return { ...s, d, mid, label, ys: [y1, y2, curve ? cy : y1], bounces, heights: heightsOf(s, bounces, netAt), ms, pre, preFromH, shift };
}

/**
 * アニメーションのボールの高さ。打つ高さ → 山 → 着地（地面）または受ける高さ、を放物線でつなぎ、
 * 線の長さに沿って区切った高さ（ft）の列にする。script 側で、影を線の上に、ボールを高さの分だけ浮かせて大きく描く。高さの段階と既定値は config/court.ts の heightLevels・shotHeights。
 */
const ft = (l: HeightLevel) => heightLevels[l].ft;
// ブロックボレーはパドルを立てて取るので、腰より低い球には使わない（書き手と決めた規則）。
// 低い球にパドルを立てると、手を球より下に置くため、深くしゃがみ込んだ形になる。低い球はリセットなど、ヘッドを下げて取る打ち方にする
for (const s of diagram.shots) {
	if (s.type === 'block' && ft(s.hit ?? shotHeights.block.hit) < WAIST_FT)
		throw new Error(`コート図: ブロックボレーは腰より低い球（hit: ${s.hit}）には使わない。高さを上げるか、リセットなどにする`);
}
/** 受ける高さ: 受けた人が次に打つ球の打点。次がなければ既定の高さ */
function receiveHeight(s: Shot) {
	if (typeof s.to !== 'string') return ft(defaultReceiveHeight);
	const rest = diagram.shots.slice(diagram.shots.indexOf(s) + 1);
	const next = rest.find((n) => n.type !== 'move' && n.from === s.to);
	if (next && next.type !== 'move') return ft(next.hit ?? shotHeights[next.type].hit);
	// 次に打つ球が図にないとき: 弾んでから受ける球は低い位置（膝の高さ）、ノーバウンドで受ける球は既定の高さ
	return ft(s.bounce === 'front' ? 'knee' : defaultReceiveHeight);
}
/**
 * 打つ前に弾ませる球（afterBounce）が、トラップ（相手から来た球を面で受けて少し上げる）かどうか。
 * この人に向かってくる球を、打つ順を前へさかのぼって探す（最後まで見つからなければ、繰り返しの前の周の球も探す）。
 * 見つかればその球を受けた高さ（ft）を返す。手から落とす球出しなら undefined
 */
function trapFromHeight(s: Shot): number | undefined {
	// 球出しは新しいボールなので、トラップではない（手から落とす）
	if (s.feed) return undefined;
	const hits = diagram.shots.filter((t) => t.type !== 'move');
	const i = hits.indexOf(s);
	for (let k = 1; k < hits.length; k++) {
		const t = hits[(i - k + hits.length) % hits.length];
		if (t.to === s.from) return receiveHeight(t);
	}
	return undefined;
}
function heightsOf(s: Shot, bounces: { at: number }[], netAt?: number) {
	const height = heightFn(s, bounces, netAt);
	return height && Array.from({ length: 41 }, (_, i) => height(i / 40).toFixed(2)).join(',');
}

/** 線に沿った高さ（ft）を返す関数。t は線の長さに対する割合 */
function heightFn(s: Shot, bounces: { at: number }[], netAt?: number): ((t: number) => number) | undefined {
	if (s.type === 'move') return undefined;
	const h0 = ft(s.hit ?? shotHeights[s.type].hit);
	const peak = ft(s.peak ?? shotHeights[s.type].peak);
	const recv = receiveHeight(s);
	// 高さの放物線（2次ベジェ）。山が両端より低ければ、そのままつなぐ。
	// netU（この区間の中でネットを越える位置、0〜1）があれば、ネットの白帯より NET_CLEAR_FT 上を必ず通るように山を上げる
	// （ネットが区間の端に近いと、真ん中の山だけではネットの上で低くなりすぎるため）
	// fall（投げ下ろす弧）は、打った高さから水平に出て、だんだん速く下がる（制御点を打った高さに置く）
	const hop = (ha: number, hb: number, p: number, netU?: number, fall = false) => {
		let c = fall && ha > hb ? ha : p > Math.max(ha, hb) ? 2 * p - (ha + hb) / 2 : (ha + hb) / 2;
		if (netU !== undefined && netU > 0 && netU < 1) {
			const need = ft('tape') + NET_CLEAR_FT;
			const k = 2 * netU * (1 - netU);
			c = Math.max(c, (need - (1 - netU) ** 2 * ha - netU ** 2 * hb) / k);
		}
		return (u: number) => (1 - u) ** 2 * ha + 2 * u * (1 - u) * c + u ** 2 * hb;
	};
	const b = bounces[0]?.at;
	// ドライブ（ストローク）: 低く打ち出して少しだけ弧を描き、ネットの白帯を越える手前で山になり、
	// トップスピンでネットを越えたあとにぐっと沈む（前半はゆるやかに上がり、後半は加速して下がる）
	if (s.type === 'drive' || s.type === 'roll') {
		const end = b !== undefined && b < 0.999 ? b : 1;
		const hEnd = b !== undefined ? 0 : recv;
		const ta = Math.min(0.8, Math.max(0.2, (netAt ?? 0.5) * 0.9)) * end;
		const hA = Math.max(h0, hEnd, ft('tape')) + DRIVE_CLEAR_FT;
		const dip = (t: number) => {
			if (t <= ta) return h0 + (hA - h0) * (1 - (1 - t / ta) ** 2);
			return hA + (hEnd - hA) * ((t - ta) / (end - ta)) ** 2.4;
		};
		if (end < 1) {
			const after = hop(0, recv, recv);
			return (t) => (t <= end ? dip(t) : after((t - end) / (1 - end)));
		}
		return dip;
	}
	let height: (t: number) => number;
	if (b !== undefined && b <= 0.001) {
		// 打った直後に弾む（バウンド位置が打つ人のすぐそば）: 地面から受ける高さまで上がるだけにする
		height = hop(0, recv, recv);
	} else if (b !== undefined && b < 0.999) {
		// 途中で弾む: 着地まで1つ目の山、弾んでから受ける高さまで上がる
		const first = hop(h0, 0, peak, netAt !== undefined && netAt < b ? netAt / b : undefined, s.fall);
		const second = hop(0, recv, recv);
		height = (t) => (t <= b ? first(t / b) : second((t - b) / (1 - b)));
	} else {
		height = hop(h0, b !== undefined ? 0 : recv, peak, netAt, s.fall);
	}
	return height;
}

/** ドライブ以外の球が、ネットの上で白帯より少なくともどれだけ高く通るか（ft） */
const NET_CLEAR_FT = 0.3;
/** ドライブがネットの白帯の上をどれだけ越えるか（ft） */
const DRIVE_CLEAR_FT = 0.8;

/**
 * 「受ける人の手前で弾む」球のバウンド位置: 受ける人（のパドル）から何 ft 手前で弾むか。
 * ベースラインの後ろで受ける球（サーブ・リターン・深い球出し）は深く弾み、キッチンやトランで受ける球は少し手前で弾む。
 */
const BOUNCE_BEFORE = { baseline: 4.3, other: 2.1 } as const;

/**
 * バウンドの印の位置。at は線の長さに対する割合（アニメーションで、ボールがそこを通ったときに印を出す）。
 */
function bouncesOf(s: Shot, toAnchor: 'paddle' | 'body' | 'point', pointAt: (t: number) => Point, receiverY?: number) {
	if (s.type === 'move' || s.bounce === false) return [];
	// 線を細かく区切って、長さの割合と点の対応を作る
	const N = 200;
	const pts = Array.from({ length: N + 1 }, (_, i) => pointAt(i / N));
	const cum = [0];
	for (let i = 1; i <= N; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
	const total = cum[N] || 1;
	const at = (i: number) => ({ pt: pts[i], at: cum[i] / total });
	// 受ける人の手前で弾む（bounce: front、サーブ・リターンの既定）: 受ける人の位置から決まった距離だけ手前
	const front = () => {
		const behindBaseline = receiverY !== undefined && (receiverY < 0 || receiverY > COURT.length);
		const d = behindBaseline ? BOUNCE_BEFORE.baseline : BOUNCE_BEFORE.other;
		return [at(Math.max(0, cum.findIndex((c) => c >= total - d)))];
	};
	if (s.bounce === 'front') return front();
	if (s.bounce) {
		const [bx, by] = s.bounce;
		let best = 0;
		pts.forEach((p, i) => {
			if (Math.hypot(p[0] - bx, p[1] - by) < Math.hypot(pts[best][0] - bx, pts[best][1] - by)) best = i;
		});
		return [at(best)];
	}
	if (toAnchor === 'point') return [at(N)];
	if (s.type === 'serve' || s.type === 'return') return front();
	return [];
}

/**
 * コマ割り: 番号（n）ごとに1コマにする。番号のない線は、番号のある線がなければ1コマにまとめる。
 * 人の動き（move）で人が移動したら、次のコマからは移動先に描く。
 */
const numbered = [...new Set(diagram.shots.flatMap((s) => (s.n === undefined ? [] : [s.n])))].sort((a, b) => a - b);
const groups: { n?: number; shots: Shot[] }[] =
	numbered.length > 0
		? numbered.map((n) => ({ n, shots: diagram.shots.filter((s) => s.n === n) }))
		: [{ shots: diagram.shots }];
// 球が2つ以上同時に動く手: アニメーションで動かすボールは各手の最初の球なので、
// 前の手の最初の球を受けた人が打つ球を、その手の最初に並べる（ボールが前の手の続きになる）
{
	let prevTo: string | undefined;
	for (const g of groups) {
		const hits = g.shots.filter((s) => s.type !== 'move');
		const lead = (prevTo && hits.find((s) => s.from === prevTo)) || hits[0];
		if (lead) {
			g.shots = [lead, ...g.shots.filter((s) => s !== lead)];
			prevTo = typeof lead.to === 'string' ? lead.to : undefined;
		}
	}
}
// ゲーム形式: 点が決まった球（point）の次の球は新しいボール。繰り返しの最初の球も、最後の球で点が決まっていれば新しいボール
const freshShots = new Set<Shot>();
{
	const hits = groups.flatMap((g) => g.shots.filter((s) => s.type !== 'move'));
	hits.forEach((s, k) => {
		const prev = hits[(k - 1 + hits.length) % hits.length];
		if (hits.length > 1 && prev.point) freshShots.add(s);
	});
}
// ゲーム形式の点: 各手の前と後の点（打球の point で動く）
const scores = (() => {
	const sc = diagram.score;
	if (!sc) return undefined;
	let now = 0;
	return groups.map((g) => {
		const before = now;
		for (const s of g.shots) if (s.point) now += s.point === sc.plus ? 1 : s.point === sc.minus ? -1 : 0;
		return { before, after: now };
	});
})();
/** 重なる線をずらす量（ft）と、ずらし始める・終える位置（線の長さの割合） */
const BOW_OFFSET = 0.6;
const BOW_RAMP = 0.18;
/** 線の真ん中を、進む向きの右へ BOW_OFFSET だけずらす（両端は動かさない）。名前とバウンドの印も同じだけずらす */
function bowLine<L extends { d: string; mid: Point; bounces?: { pt: Point; at: number }[] }>(l: L): L {
	const m = l.d.match(/^M([-\d.]+) ([-\d.]+) L([-\d.]+) ([-\d.]+)$/);
	if (!m) return l;
	const [x1, y1, x2, y2] = m.slice(1).map(Number);
	const len = Math.hypot(x2 - x1, y2 - y1) || 1;
	const nx = (-(y2 - y1) / len) * BOW_OFFSET;
	const ny = ((x2 - x1) / len) * BOW_OFFSET;
	const at = (t: number): Point => [x1 + (x2 - x1) * t + nx, y1 + (y2 - y1) * t + ny];
	const [ax, ay] = at(BOW_RAMP);
	const [bx, by] = at(1 - BOW_RAMP);
	const ramp = (t: number) => Math.max(0, Math.min(1, t / BOW_RAMP, (1 - t) / BOW_RAMP));
	return {
		...l,
		d: `M${x1} ${y1} L${ax} ${ay} L${bx} ${by} L${x2} ${y2}`,
		mid: [l.mid[0] + nx, l.mid[1] + ny],
		bounces: l.bounces?.map((b) => ({ ...b, pt: [b.pt[0] + nx * ramp(b.at), b.pt[1] + ny * ramp(b.at)] as Point })),
	};
}
const positions = new Map<string, Point>(diagram.players.map((p) => [p.id, [p.x, p.y]]));
const panels = groups.map((g) => {
	const figures = diagram.players.map((p) => figureOf(p, positions.get(p.id)!));
	const byId = new Map(figures.map((f) => [f.id, f]));
	// 同じ手で動く人（打たれた球に合わせてサイドステップするなど）は、動いた先で球を受ける
	const movedTo = new Map(
		g.shots.flatMap((s) => (s.type === 'move' && typeof s.from === 'string' && typeof s.to !== 'string' ? [[s.from, s.to] as const] : [])),
	);
	const byIdTo = new Map(
		diagram.players.map((p) => [p.id, movedTo.has(p.id) ? figureOf(p, movedTo.get(p.id)!) : byId.get(p.id)!]),
	);
	// 同じ手に同じ名前の線が2本以上あるとき（球を2つ以上同時に使うドリル）は、名前を最初の1本にだけ付ける（重なって読めないため）
	const seenLabels = new Set<string>();
	// ゲーム形式: 点が決まった球では、点を失った人の上に「失点」を出す
	const loserOf = (s: Shot) => {
		const sc = diagram.score;
		if (!s.point || !sc) return undefined;
		const id = s.point === sc.plus ? sc.minus : s.point === sc.minus ? sc.plus : undefined;
		const f = id ? byIdTo.get(id) : undefined;
		// 人のネット側に出す（奥の人の上に出すと、図の上の端で切れるため）
		return f ? ([f.x, f.y + (f.y < COURT.net ? 1 : -1) * (PLAYER_R + 1.2)] as Point) : undefined;
	};
	const lines = g.shots.map((s) => ({
		...lineOf(s, byId, groups.length > 1, byIdTo),
		fresh: freshShots.has(s),
		lostAt: loserOf(s),
		// 相手の打球を見て動く人は、反応する時間だけ遅れて動き出す（自分で打ちながら動くときは遅れない）
		delay:
			s.type === 'move' && g.shots.some((o) => o.type !== 'move' && o.from !== s.from) ? reactionMs : undefined,
	})).map((l) => {
		if (l.type === 'move' || !l.label) return l;
		if (seenLabels.has(l.label)) return { ...l, label: undefined };
		seenLabels.add(l.label);
		return l;
	});
	// 横から見た図で描くパドルの高さ: この手で打つ人は打つ高さ、受ける人は受ける高さ、ほかは既定の高さ。
	// 同じ手で2つ以上打つときも、それぞれの打球から決める
	// この手で打ちも受けもしない人（動くだけ、待つだけ）は、次に打つか受ける手の構えで待つ。
	// あとの手になければ、ループで次に来る最初のほうの手から探す
	// （書き手の指摘: 決めの高さ（約1.2m）の構えで待つと、振り終わりのように腕を上げたまま走って見えた）
	const nextGroup = (id: string) => {
		const involved = (x: { shots: Shot[] }) => x.shots.some((s) => s.type !== 'move' && (s.from === id || s.to === id));
		if (involved(g)) return g;
		const i = groups.indexOf(g);
		return groups.slice(i + 1).find(involved) ?? groups.slice(0, i).find(involved) ?? g;
	};
	const sideH = (id: string) => {
		for (const s of nextGroup(id).shots) {
			if (s.type === 'move') continue;
			if (s.from === id) return ft(s.hit ?? shotHeights[s.type].hit);
			if (s.to === id) return receiveHeight(s);
		}
		return ft(defaultReceiveHeight);
	};
	// 横から見た図の構えに使う打ち方: この手で打つならその球、受けるなら次に打つ球（構えは打ち方で変わる。例: ロールは前に倒れて手を前へ）
	const sideType = (id: string): string | undefined => {
		const ng = nextGroup(id);
		for (const s of ng.shots) if (s.type !== 'move' && s.from === id) return s.type;
		const later = diagram.shots.filter((s) => s.type !== 'move' && (s.n ?? 0) > (ng.n ?? 0) && s.from === id);
		return ng.shots.some((s) => s.to === id) ? later[0]?.type : undefined;
	};
	for (const f of figures) Object.assign(f, { sideH: sideH(f.id), sideType: sideType(f.id) });
	for (const s of g.shots) {
		if (s.type === 'move' && typeof s.from === 'string' && typeof s.to !== 'string') positions.set(s.from, s.to);
	}
	// 同じ手で2本の線がほぼ同じ所を通るとき（球を2つ使うストレートの往復など）は、重なって読めないので、
	// どちらの線も進む向きの右へ少しずらす（両端はパドルのまま。真ん中だけをずらす）
	const hitsIdx = lines.flatMap((l, k) => (l.type === 'move' ? [] : [k]));
	const ends = (l: (typeof lines)[number]) => l.d.match(/^M([-\d.]+) ([-\d.]+) L([-\d.]+) ([-\d.]+)$/)?.slice(1).map(Number);
	const overlapping = new Set<number>();
	for (const i of hitsIdx)
		for (const j of hitsIdx) {
			if (i >= j) continue;
			const a = ends(lines[i]);
			const b = ends(lines[j]);
			if (!a || !b) continue;
			const near = (x1: number, y1: number, x2: number, y2: number) => Math.hypot(x1 - x2, y1 - y2) < 1.5;
			const same = near(a[0], a[1], b[0], b[1]) && near(a[2], a[3], b[2], b[3]);
			const reverse = near(a[0], a[1], b[2], b[3]) && near(a[2], a[3], b[0], b[1]);
			if (same || reverse) overlapping.add(i).add(j);
		}
	for (const k of overlapping) lines[k] = bowLine(lines[k]);
	return { n: g.n, figures, lines };
});
const multi = !still && panels.length > 1;

// 表示範囲: crop=auto なら、人と打球が入る縦の範囲だけを切り出す（横はコート全幅、ネットは必ず入れる）。
// ただし、トランが関わる側（人や打球がキッチンラインより3ft以上後ろにある）は
// 位置関係が分かるように必ずベースラインまで入れる。全コマで同じ範囲にそろえる。
const padX = multi ? 1.5 : still ? 2 : 3.5;
const pad = 3.5;
let top = -pad;
let bottom = COURT.length + pad;
if (diagram.crop === 'auto') {
	const ys = [
		COURT.net,
		...panels.flatMap((pn) => [...pn.figures.flatMap((p) => [p.y, p.face[1]]), ...pn.lines.flatMap((l) => l.ys)]),
	];
	const backTop = Math.min(...ys) <= k1 - 3;
	const backBottom = Math.max(...ys) >= k2 + 3;
	const baselineMargin = 1.5;
	top = backTop ? -baselineMargin : Math.max(-pad, Math.min(...ys) - 3.5);
	bottom = backBottom ? COURT.length + baselineMargin : Math.min(COURT.length + pad, Math.max(...ys) + 3.5);
	// ベースラインより後ろに人や打球があるときは、それも入れる
	top = Math.min(top, Math.max(-pad, Math.min(...ys) - 1.5));
	bottom = Math.max(bottom, Math.min(COURT.length + pad, Math.max(...ys) + 1.5));
}
// ベースラインの後ろに立つ人（サーブ・リターンなど）は、丸が切れないように全体を入れる
const figureYs = panels.flatMap((pn) => pn.figures.map((p) => p.y));
top = Math.min(top, Math.min(...figureYs) - PLAYER_R - 0.4);
bottom = Math.max(bottom, Math.max(...figureYs) + PLAYER_R + 0.4);
// アニメーションの図は、コートの右に「横から見た高さ」の帯を付ける（縦の位置はコートと同じ、横の位置が高さ）
// 高さはコートと同じ縮尺（1ft = 1）。人・ネット・球の高さが、コートの長さと同じ大きさで見える（書き手と決めた）。
// 帯の幅は、そのドリルでいちばん高い所（打つ高さ・山の高さ）まで入る長さ。人の背（約 5.6ft）とパドルが入るよう、最低 SIDE_MIN_FT
const SIDE_MIN_FT = 7.5;
const highest = Math.max(
	...diagram.shots.filter((s) => s.type !== 'move').flatMap((s) => [ft(s.hit ?? shotHeights[s.type as Exclude<ShotType, 'move'>].hit), ft(s.peak ?? shotHeights[s.type as Exclude<ShotType, 'move'>].peak)]),
	0,
);
// 帯の幅は最大 SIDE_MAX_FT。ロブの頂点（約4.3m）まで入れると、スマホでコートが小さくなりすぎるので、それより高い所は帯の端で止める
const SIDE_MAX_FT = 10;
const SIDE = { gap: 1.2, width: Math.min(SIDE_MAX_FT, Math.max(SIDE_MIN_FT, highest + 0.5)), unitPerFt: 1 };
const side = multi ? { x0: COURT.width + padX + SIDE.gap, k: SIDE.unitPerFt, width: SIDE.width, top, bottom } : undefined;
const viewBox = `${-padX} ${top} ${COURT.width + padX * 2 + (side ? SIDE.gap + SIDE.width : 0)} ${bottom - top}`;

// 線の名前が図の左右からはみ出さないよう、横位置を内側に寄せる。
// 文字幅は全角1文字 ≒ フォントサイズとして見積もる（styles/court.css の .shot-label と合わせる）
const labelFont = multi ? 1.7 : still ? 2 : 1.3;
for (const pn of panels) {
	for (const l of pn.lines) {
		if (!l.label) continue;
		const half = ([...l.label].length * labelFont) / 2 + 0.3;
		const minX = -padX + half;
		const maxX = COURT.width + padX - half;
		l.mid = [minX > maxX ? COURT.width / 2 : Math.min(Math.max(l.mid[0], minX), maxX), l.mid[1]];
	}
}
const circled = (n: number) => (n >= 1 && n <= 20 ? String.fromCodePoint(0x2460 + n - 1) : `${n}.`);
// 止まった1枚の図: 各手の線を、その手の時点の位置から引いて重ねる。人は最後の手の時点の位置に描く。
// 行きと帰りの線が重ならないよう、どの線も進む向きの右側へ少しずらす（逆向きの線は反対側にずれて離れる）
const STILL_OFFSET = 0.6;
const offsetLine = <L extends { d: string; mid: Point; bounces?: { pt: Point; at: number }[] }>(l: L): L => {
	const m = l.d.match(/^M([-\d.]+) ([-\d.]+) L([-\d.]+) ([-\d.]+)$/);
	if (!m) return l;
	const [x1, y1, x2, y2] = m.slice(1).map(Number);
	const len = Math.hypot(x2 - x1, y2 - y1) || 1;
	// 進む向きの右側（画面の座標で y は下向き）
	const ox = (-(y2 - y1) / len) * STILL_OFFSET;
	const oy = ((x2 - x1) / len) * STILL_OFFSET;
	const sh = (p: Point): Point => [p[0] + ox, p[1] + oy];
	return {
		...l,
		d: `M${x1 + ox} ${y1 + oy} L${x2 + ox} ${y2 + oy}`,
		mid: sh(l.mid),
		bounces: l.bounces?.map((b) => ({ ...b, pt: sh(b.pt) })),
	};
};
const stillPanel = still
	? {
			figures: panels[panels.length - 1].figures,
			lines: panels.flatMap((pn) =>
				pn.lines.map((l) =>
					offsetLine(l.type !== 'move' && l.label && pn.n !== undefined ? { ...l, label: `${circled(pn.n)}${l.label}` } : l),
				),
			),
		}
	: undefined;
// 止まった1枚の図では、線の名前どうしが重ならないように、あとの名前を上下にずらす。
// 名前の箱は「文字数 × 文字の大きさ」の幅と、文字の大きさの 1.25 倍の高さで見積もる
if (stillPanel) {
	const h = labelFont * 1.25;
	const placed: { x: number; y: number; half: number }[] = [];
	const hits = (x: number, y: number, half: number) =>
		placed.some((b) => Math.abs(b.x - x) < b.half + half && Math.abs(b.y - y) < h);
	for (const l of stillPanel.lines) {
		if (!l.label) continue;
		const half = ([...l.label].length * labelFont) / 2 + 0.3;
		// 番号（①など）が付いて長くなった分も、図の左右からはみ出さないように寄せ直す
		const minX = -padX + half;
		const maxX = COURT.width + padX - half;
		const x = minX > maxX ? COURT.width / 2 : Math.min(Math.max(l.mid[0], minX), maxX);
		const y0 = l.mid[1];
		// 元の位置から近い順に、下・上・下・上… と1段ずつ試す
		let y = y0;
		for (let i = 1; hits(x, y, half) && i <= 8; i++) y = y0 + Math.ceil(i / 2) * h * (i % 2 ? 1 : -1);
		l.mid = [x, y];
		placed.push({ x, y, half });
	}
}
