---
import type { Diagram } from '../content.config';
import {
	COURT,
	roleLabels,
	shotLabels,
	shotCurve,
	heightLevels,
	shotHeights,
	defaultReceiveHeight,
	type HeightLevel,
} from '../config/court';
import CourtFrame from './CourtFrame.astro';
import '../styles/court.css';

interface Props {
	diagram: Diagram;
	title?: string;
}
const { diagram, title = 'コート図' } = Astro.props;

/** 人・腕・パドルは見やすさ優先で、コートの縮尺より大きく描く（単位はフィート相当） */
const PLAYER_R = 1.3;
const uid = `c${Math.random().toString(36).slice(2, 8)}`;
const k1 = COURT.net - COURT.kitchen;
const k2 = COURT.net + COURT.kitchen;

type Point = [number, number];
type Player = Diagram['players'][number];
type Shot = Diagram['shots'][number];

/** 人の体・腕・パドルの位置を計算する（上から見た図。右利きなら本人から見て右手にパドル） */
function figureOf(p: Player, pos: Point) {
	const [x, y] = pos;
	const facing = p.facing ?? (y < COURT.net ? 'down' : 'up');
	const f: Point = facing === 'up' ? [0, -1] : [0, 1]; // 前
	const side = p.lefty ? -1 : 1;
	// 本人から見た右（上向きなら +x、下向きなら -x）。左利きなら逆側
	const r: Point = [-f[1] * side, f[0] * side];
	const at = (dr: number, df: number): Point => [x + r[0] * dr + f[0] * df, y + r[1] * dr + f[1] * df];
	// 構えごとの、肩・手・パドルの先の位置（体の中心からの「右」「前」の距離）
	// 腕 = 肩→手の細線、パドル = 手→先の太線。体から斜め前へ開くように描く
	const pose = {
		ready: { shoulder: [0.9, 0.5], hand: [1.55, 1.15], tip: [2.05, 1.6] }, // 右肩から右斜め前へ開く
		fh: { shoulder: [1.2, 0.3], hand: [2.0, 0.65], tip: [2.65, 0.9] }, // フォア側（右）へ大きく開く
		bh: { shoulder: [-0.9, 0.5], hand: [-1.55, 1.15], tip: [-2.05, 1.6] }, // バック側（左）斜め前へ開く
	}[p.paddle];
	const shoulder = at(pose.shoulder[0], pose.shoulder[1]);
	const hand = at(pose.hand[0], pose.hand[1]);
	const tip = at(pose.tip[0], pose.tip[1]);
	// 打球の線はパドルの真ん中から出す
	const face: Point = [(hand[0] + tip[0]) / 2, (hand[1] + tip[1]) / 2];
	return { ...p, x, y, shoulder, hand, tip, face };
}
type Figure = ReturnType<typeof figureOf>;

/** 端を縮める量（体の円・パドルの太線と重ならないように） */
const inset = { body: PLAYER_R + 0.3, paddle: 0.45, point: 0 } as const;

/**
 * 打球・動きの線を計算する。人を指す参照は、打球ならパドルの真ん中、人の動きなら体の中心へ。
 * 弧の大きさは打球の種類で決める（config/court.ts の shotCurve）。
 * データの curve は重なりよけ用なので、1コマに1手のコマ割り（straight=true）では使わない。
 */
function lineOf(s: Shot, byId: Map<string, Figure>, straight: boolean) {
	const target = s.type === 'move' ? 'body' : 'paddle';
	const resolve = (ref: string | Point) => {
		if (typeof ref === 'string') {
			const p = byId.get(ref);
			if (!p) throw new Error(`コート図: 人 "${ref}" が players にありません`);
			return target === 'paddle'
				? { pt: p.face, anchor: 'paddle' as const }
				: { pt: [p.x, p.y] as Point, anchor: 'body' as const };
		}
		return { pt: ref, anchor: 'point' as const };
	};
	const a = resolve(s.from);
	const b = resolve(s.to);
	let [x1, y1] = a.pt;
	let [x2, y2] = b.pt;
	const len = Math.hypot(x2 - x1, y2 - y1) || 1;
	const ux = (x2 - x1) / len;
	const uy = (y2 - y1) / len;
	const startInset = a.anchor === 'body' ? PLAYER_R : 0;
	[x1, y1] = [x1 + ux * startInset, y1 + uy * startInset];
	[x2, y2] = [x2 - ux * inset[b.anchor], y2 - uy * inset[b.anchor]];
	const typeCurve = shotCurve[s.type];
	const curve = straight ? typeCurve : (s.curve ?? typeCurve);
	// 曲げる量は距離に比例。正で進行方向の左側へふくらむ
	const cx = (x1 + x2) / 2 - uy * len * curve;
	const cy = (y1 + y2) / 2 + ux * len * curve;
	const d = curve ? `M${x1} ${y1} Q${cx} ${cy} ${x2} ${y2}` : `M${x1} ${y1} L${x2} ${y2}`;
	const pointAt = (t: number): Point =>
		curve
			? [(1 - t) ** 2 * x1 + 2 * (1 - t) * t * cx + t ** 2 * x2, (1 - t) ** 2 * y1 + 2 * (1 - t) * t * cy + t ** 2 * y2]
			: [x1 + (x2 - x1) * t, y1 + (y2 - y1) * t];
	// 名前は線の真ん中に置く。ネットの線や人に重なるときは、線の上の別の位置にずらす
	const bodies = [...byId.values()].map((p) => [p.x, p.y] as Point);
	const clear = (p: Point) =>
		Math.abs(p[1] - COURT.net) >= 1.6 && bodies.every(([bx, by]) => Math.hypot(p[0] - bx, p[1] - by) >= PLAYER_R + 1.6);
	const candidates = [0.5, 0.4, 0.6, 0.3, 0.7, 0.2, 0.8].map(pointAt);
	const mid = candidates.find(clear) ?? candidates.find((p) => Math.abs(p[1] - COURT.net) >= 1.6) ?? candidates[0];
	const label =
		s.label ?? (s.type === 'move' ? '移動' : s.feed ? `球出し（${shotLabels[s.type]}）` : shotLabels[s.type]);
	const bounces = bouncesOf(s, b.anchor, pointAt);
	return { ...s, d, mid, label, ys: [y1, y2, curve ? cy : y1], bounces, heights: heightsOf(s, bounces) };
}

/**
 * アニメーションのボールの高さ。打つ高さ → 山 → 着地（地面）または受ける高さ、を放物線でつなぎ、
 * 線の長さに沿って区切った高さ（ft）の列にする。script 側で、影を線の上に、ボールを高さの分だけ浮かせて大きく描く。高さの段階と既定値は config/court.ts の heightLevels・shotHeights。
 */
const ft = (l: HeightLevel) => heightLevels[l].ft;
/** 受ける高さ: 受けた人が次に打つ球の打点。次がなければ既定の高さ */
function receiveHeight(s: Shot) {
	if (typeof s.to !== 'string') return ft(defaultReceiveHeight);
	const rest = diagram.shots.slice(diagram.shots.indexOf(s) + 1);
	const next = rest.find((n) => n.type !== 'move' && n.from === s.to);
	return next && next.type !== 'move' ? ft(next.hit ?? shotHeights[next.type].hit) : ft(defaultReceiveHeight);
}
function heightsOf(s: Shot, bounces: { at: number }[]) {
	if (s.type === 'move') return undefined;
	const h0 = ft(s.hit ?? shotHeights[s.type].hit);
	const peak = ft(s.peak ?? shotHeights[s.type].peak);
	const recv = receiveHeight(s);
	// 高さの放物線（2次ベジェ）。山が両端より低ければ、そのままつなぐ
	const hop = (ha: number, hb: number, p: number) => {
		const c = p > Math.max(ha, hb) ? 2 * p - (ha + hb) / 2 : (ha + hb) / 2;
		return (u: number) => (1 - u) ** 2 * ha + 2 * u * (1 - u) * c + u ** 2 * hb;
	};
	const b = bounces[0]?.at;
	let height: (t: number) => number;
	if (b !== undefined && b < 0.999) {
		// 途中で弾む: 着地まで1つ目の山、弾んでから受ける高さまで上がる
		const first = hop(h0, 0, peak);
		const second = hop(0, recv, recv);
		height = (t) => (t <= b ? first(t / b) : second((t - b) / (1 - b)));
	} else {
		height = hop(h0, b !== undefined ? 0 : recv, peak);
	}
	return Array.from({ length: 41 }, (_, i) => height(i / 40).toFixed(2)).join(',');
}

/** サーブ・リターンでバウンド位置を書かなかったときの位置（線の長さに対する割合） */
const AUTO_BOUNCE = 0.82;

/**
 * バウンドの印の位置。at は線の長さに対する割合（アニメーションで、ボールがそこを通ったときに印を出す）。
 */
function bouncesOf(s: Shot, toAnchor: 'paddle' | 'body' | 'point', pointAt: (t: number) => Point) {
	if (s.type === 'move' || s.bounce === false) return [];
	// 線を細かく区切って、長さの割合と点の対応を作る
	const N = 200;
	const pts = Array.from({ length: N + 1 }, (_, i) => pointAt(i / N));
	const cum = [0];
	for (let i = 1; i <= N; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
	const total = cum[N] || 1;
	const at = (i: number) => ({ pt: pts[i], at: cum[i] / total });
	if (s.bounce) {
		const [bx, by] = s.bounce;
		let best = 0;
		pts.forEach((p, i) => {
			if (Math.hypot(p[0] - bx, p[1] - by) < Math.hypot(pts[best][0] - bx, pts[best][1] - by)) best = i;
		});
		return [at(best)];
	}
	if (toAnchor === 'point') return [at(N)];
	if (s.type === 'serve' || s.type === 'return') return [at(cum.findIndex((c) => c / total >= AUTO_BOUNCE))];
	return [];
}

/**
 * コマ割り: 番号（n）ごとに1コマにする。番号のない線は、番号のある線がなければ1コマにまとめる。
 * 人の動き（move）で人が移動したら、次のコマからは移動先に描く。
 */
const numbered = [...new Set(diagram.shots.flatMap((s) => (s.n === undefined ? [] : [s.n])))].sort((a, b) => a - b);
const groups: { n?: number; shots: Shot[] }[] =
	numbered.length > 0
		? numbered.map((n) => ({ n, shots: diagram.shots.filter((s) => s.n === n) }))
		: [{ shots: diagram.shots }];
const positions = new Map<string, Point>(diagram.players.map((p) => [p.id, [p.x, p.y]]));
const panels = groups.map((g) => {
	const figures = diagram.players.map((p) => figureOf(p, positions.get(p.id)!));
	const byId = new Map(figures.map((f) => [f.id, f]));
	const lines = g.shots.map((s) => lineOf(s, byId, groups.length > 1));
	for (const s of g.shots) {
		if (s.type === 'move' && typeof s.from === 'string' && typeof s.to !== 'string') positions.set(s.from, s.to);
	}
	return { n: g.n, figures, lines };
});
const multi = panels.length > 1;

// 表示範囲: crop=auto なら、人と打球が入る縦の範囲だけを切り出す（横はコート全幅、ネットは必ず入れる）。
// ただし、トランが関わる側（人や打球がキッチンラインより3ft以上後ろにある）は
// 位置関係が分かるように必ずベースラインまで入れる。全コマで同じ範囲にそろえる。
const padX = multi ? 1.5 : 3.5;
const pad = 3.5;
let top = -pad;
let bottom = COURT.length + pad;
if (diagram.crop === 'auto') {
	const ys = [
		COURT.net,
		...panels.flatMap((pn) => [...pn.figures.flatMap((p) => [p.y, p.face[1]]), ...pn.lines.flatMap((l) => l.ys)]),
	];
	const backTop = Math.min(...ys) <= k1 - 3;
	const backBottom = Math.max(...ys) >= k2 + 3;
	const baselineMargin = 1.5;
	top = backTop ? -baselineMargin : Math.max(-pad, Math.min(...ys) - 3.5);
	bottom = backBottom ? COURT.length + baselineMargin : Math.min(COURT.length + pad, Math.max(...ys) + 3.5);
	// ベースラインより後ろに人や打球があるときは、それも入れる
	top = Math.min(top, Math.max(-pad, Math.min(...ys) - 1.5));
	bottom = Math.max(bottom, Math.min(COURT.length + pad, Math.max(...ys) + 1.5));
}
// ベースラインの後ろに立つ人（サーブ・リターンなど）は、丸が切れないように全体を入れる
const figureYs = panels.flatMap((pn) => pn.figures.map((p) => p.y));
top = Math.min(top, Math.min(...figureYs) - PLAYER_R - 0.4);
bottom = Math.max(bottom, Math.max(...figureYs) + PLAYER_R + 0.4);
const viewBox = `${-padX} ${top} ${COURT.width + padX * 2} ${bottom - top}`;

// 線の名前が図の左右からはみ出さないよう、横位置を内側に寄せる。
// 文字幅は全角1文字 ≒ フォントサイズとして見積もる（styles/court.css の .shot-label と合わせる）
const labelFont = multi ? 1.7 : 1.3;
for (const pn of panels) {
	for (const l of pn.lines) {
		if (!l.label) continue;
		const half = ([...l.label].length * labelFont) / 2 + 0.3;
		const minX = -padX + half;
		const maxX = COURT.width + padX - half;
		l.mid = [minX > maxX ? COURT.width / 2 : Math.min(Math.max(l.mid[0], minX), maxX), l.mid[1]];
	}
}
const usedRoles = [...new Set(diagram.players.map((p) => p.role))];
const circled = (n: number) => (n >= 1 && n <= 20 ? String.fromCodePoint(0x2460 + n - 1) : `${n}.`);
---

<figure class:list={['court', { multi }]} style={`--cols: ${Math.min(panels.length, 4)}`}>
	{
		multi && (
			<div class="anim" data-court-anim>
				<div class="anim-stage">
					{panels.map((pn, i) => (
						<CourtFrame
							figures={pn.figures}
							lines={pn.lines}
							viewBox={viewBox}
							zones={diagram.zones}
							fences={diagram.fences}
							uid={`${uid}a${i}`}
							playerR={PLAYER_R}
							title={`${title}（アニメーション ${i + 1}）`}
							animated
							step={i}
						/>
					))}
				</div>
				<div class="anim-controls">
					<button type="button" data-act="prev" aria-label="前の手">◀</button>
					<button type="button" data-act="toggle" aria-label="一時停止">❚❚</button>
					<button type="button" data-act="next" aria-label="次の手">▶</button>
					<span class="anim-steps">
						{panels.map((pn, i) => (
							<span class="anim-step" data-step-dot={i}>
								{pn.n !== undefined ? circled(pn.n) : i + 1}
							</span>
						))}
					</span>
				</div>
			</div>
		)
	}
	{/* 複数の手がある図はアニメーションだけを出す。コマ割りは1手だけの図のときに使う */}
	{!multi && (
	<div class="panels">
		{
			panels.map((pn, i) => (
				<div class="panel">
					{multi && pn.n !== undefined && <div class="panel-no">{circled(pn.n)}</div>}
					<CourtFrame
						figures={pn.figures}
						lines={pn.lines}
						viewBox={viewBox}
						zones={diagram.zones}
							fences={diagram.fences}
						uid={`${uid}p${i}`}
						playerR={PLAYER_R}
						title={multi ? `${title} ${i + 1}` : title}
					/>
				</div>
			))
		}
	</div>
	)}
	<figcaption>
		<ul class="legend">
			{
				usedRoles.map((r) => (
					<li>
						<span class={`swatch role-${r}`} />
						{roleLabels[r]}
					</li>
				))
			}
			{
				diagram.fences.length > 0 && (
					<li>
						<svg class="fence-swatch" viewBox="0 0 3 1" aria-hidden="true">
							<g class="fence">
								<line x1="0.25" y1="0.5" x2="2.75" y2="0.5" />
								<rect x="0.05" y="0.3" width="0.4" height="0.4" rx="0.05" />
								<rect x="1.3" y="0.3" width="0.4" height="0.4" rx="0.05" />
								<rect x="2.55" y="0.3" width="0.4" height="0.4" rx="0.05" />
							</g>
						</svg>
						柵
					</li>
				)
			}
		</ul>
		{diagram.caption && <p class="caption">{diagram.caption}</p>}
	</figcaption>
</figure>

<script>
	/**
	 * コート図のアニメーション。場面（.frame）を1つずつ表示し、
	 * 打球はボールを線に沿って動かし（線も伸ばして描く）、人の動きは人を移動先まで動かす。
	 */
	const SHOT_MS = 900;
	/** 影のずらし方とボールの大きさ（高さ 1ft あたり）。影との距離と大きさで高さを見せる */
	const LIFT_PER_FT = 0.3;
	const BALL_R_GROUND = 0.4;
	const BALL_R_PER_FT = 0.1;
	const BALL_R_MAX = 1.3;
	const PAUSE_MS = 700;
	const LOOP_PAUSE_MS = 1600;

	function setup(root: HTMLElement) {
		const frames = [...root.querySelectorAll<SVGSVGElement>('svg.frame')];
		const dots = [...root.querySelectorAll<HTMLElement>('[data-step-dot]')];
		const toggleBtn = root.querySelector<HTMLButtonElement>('[data-act="toggle"]')!;
		let current = 0;
		// 「視差効果を減らす」設定のときは自動再生せず、ボタンで1手ずつ切り替えて静止した図を見せる
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let playing = !reduce;
		let raf = 0;
		let timer = 0;

		const stop = () => {
			cancelAnimationFrame(raf);
			clearTimeout(timer);
		};

		/** 場面 i を表示し、その手を動かす。終わったら done を呼ぶ */
		/** 線 path の長さの割合 ratio の位置にあるボール（地面の位置と高さ ft） */
		type BallPos = { x: number; y: number; h: number };
		const ballAt = (path: SVGPathElement, ratio: number): BallPos => {
			const p = path.getPointAtLength(path.getTotalLength() * ratio);
			// 高さ（data-h: 線に沿った高さ ft の列）を補間する
			const hs = path.dataset.h?.split(',').map(Number);
			let h = 0;
			if (hs) {
				const x = ratio * (hs.length - 1);
				const i = Math.min(Math.floor(x), hs.length - 2);
				h = hs[i] + (hs[i + 1] - hs[i]) * (x - i);
			}
			return { x: p.x, y: p.y, h };
		};
		/** 1手の終わりにボールがあった位置。次の手でも同じ位置から見せて、手と手のつながりを見せる */
		let lastBall: BallPos | undefined;

		function show(i: number, animate: boolean, done?: () => void) {
			stop();
			current = i;
			frames.forEach((f, k) => (f.style.display = k === i ? '' : 'none'));
			dots.forEach((d, k) => d.classList.toggle('active', k === i));
			const frame = frames[i];
			const ball = frame.querySelector<SVGCircleElement>('.ball')!;
			const shadow = frame.querySelector<SVGEllipseElement>('.ball-shadow')!;
			const pole = frame.querySelector<SVGLineElement>('.ball-pole')!;
			const balls = [...frame.querySelectorAll<SVGPathElement>('path[data-kind="ball"]')];
			const moves = [...frame.querySelectorAll<SVGPathElement>('path[data-kind="move"]')];
			const movers = moves.map((m) => {
				const g = frame.querySelector<SVGGElement>(`[data-player-id="${m.dataset.player}"]`);
				const len = m.getTotalLength();
				const start = m.getPointAtLength(0);
				const end = m.getPointAtLength(len);
				return { g, dx: end.x - start.x, dy: end.y - start.y };
			});
			const lens = balls.map((b) => b.getTotalLength());
			// 線はマスク側の線（.reveal）を伸ばして見せる。本体の線は点線・破線のまま描ける
			const reveals = balls.map((b) => frame.querySelector<SVGPathElement>(`path.reveal[data-i="${b.dataset.i}"]`));
			// 伸びている途中は、線の先端をボールの位置にぴったり合わせる（端は丸めない）。
			// 伸び切ったら全体を見せ、矢印の先も表示する（端を丸めて矢印の先まで覆う）
			const setReveal = (k: number, ratio: number) => {
				const r = reveals[k];
				if (!r) return;
				if (ratio >= 1) {
					r.style.strokeDasharray = 'none';
					r.style.strokeLinecap = 'round';
				} else {
					r.style.strokeDasharray = `${lens[k] * ratio} ${lens[k] + 10}`;
					r.style.strokeLinecap = 'butt';
				}
				r.style.strokeDashoffset = '0';
			};
			// バウンドの印: ボールがその位置を通ったときに出す（data-at = 線の長さに対する割合）
			const marks = [...frame.querySelectorAll<SVGGElement>('.bounce')];
			const showMarks = (ratio: number) =>
				marks.forEach((m) => {
					const on = ratio >= Number(m.dataset.at) - 0.001;
					if (on && !m.classList.contains('on')) m.classList.add('on', ...(animate ? ['pop'] : []));
					if (!on) m.classList.remove('on', 'pop');
				});
			// ボールを描く: ボールは線の上（打つ人・受ける人のパドルの位置）に置き、高いほど大きく描く。
			// 影はボールの真下の地面として、高さの分だけ画面の下へずらして描く。
			// ボールが影に重なったところがバウンド。pos がなければ隠す
			const drawBall = (pos?: BallPos) => {
				if (!pos) {
					ball.setAttribute('cx', '-10');
					shadow.setAttribute('cx', '-10');
					pole.setAttribute('x1', '-10');
					pole.setAttribute('x2', '-10');
					return;
				}
				const r = Math.min(BALL_R_MAX, BALL_R_GROUND + pos.h * BALL_R_PER_FT);
				// 図の下端からはみ出さないよう、ずらす量を抑える
				const vb = frame.viewBox.baseVal;
				const drop = Math.min(pos.h * LIFT_PER_FT, Math.max(0, vb.y + vb.height - 0.5 - pos.y));
				ball.setAttribute('cx', `${pos.x}`);
				ball.setAttribute('cy', `${pos.y}`);
				ball.setAttribute('r', `${r}`);
				shadow.setAttribute('cx', `${pos.x}`);
				shadow.setAttribute('cy', `${pos.y + drop}`);
				pole.setAttribute('x1', `${pos.x}`);
				pole.setAttribute('x2', `${pos.x}`);
				pole.setAttribute('y1', `${pos.y + drop}`);
				pole.setAttribute('y2', `${pos.y}`);
			};
			const reset = () => {
				showMarks(animate ? -1 : 1);
				balls.forEach((_, k) => setReveal(k, animate ? 0 : 1));
				movers.forEach(({ g }) => g?.setAttribute('transform', ''));
				// 打つ手なら打つ人のパドルから、人が動くだけの手なら前の手の終わりの位置にボールを置く
				drawBall(balls[0] ? ballAt(balls[0], animate ? 0 : 1) : lastBall);
				if (balls[0] && !animate) lastBall = ballAt(balls[0], 1);
			};
			reset();
			if (!animate) {
				movers.forEach(({ g, dx, dy }) => g?.setAttribute('transform', `translate(${dx} ${dy})`));
				return;
			}
			// 打球の種類ごとの時間（data-ms）。1つの場面に複数あるときは一番長いものに合わせる
			const durations = [...balls, ...moves].map((p) => Number(p.dataset.ms) || SHOT_MS);
			const duration = durations.length ? Math.max(...durations) : SHOT_MS;
			const t0 = performance.now();
			const tick = (now: number) => {
				const t = Math.min(1, (now - t0) / duration);
				const e = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2; // 人の動き: ease-in-out
				const eb = Math.sin((t * Math.PI) / 2); // ボール: 打った瞬間が速く、少しずつ減速する
				showMarks(eb);
				balls.forEach((b, k) => {
					setReveal(k, eb);
					if (k === 0) drawBall(ballAt(b, eb));
				});
				movers.forEach(({ g, dx, dy }) => g?.setAttribute('transform', `translate(${dx * e} ${dy * e})`));
				if (t < 1) raf = requestAnimationFrame(tick);
				else {
					balls.forEach((_, k) => setReveal(k, 1));
					showMarks(1);
					// ボールは消さずに、届いた位置に残す（次の手はそこから始まる）
					if (balls[0]) {
						lastBall = ballAt(balls[0], 1);
						drawBall(lastBall);
					}
					done?.();
				}
			};
			raf = requestAnimationFrame(tick);
		}

		function playFrom(i: number) {
			show(i, true, () => {
				if (!playing) return;
				const last = i === frames.length - 1;
				timer = window.setTimeout(() => playFrom(last ? 0 : i + 1), last ? LOOP_PAUSE_MS : PAUSE_MS);
			});
		}

		function setPlaying(p: boolean) {
			playing = p;
			toggleBtn.textContent = p ? '❚❚' : '▶︎';
			toggleBtn.setAttribute('aria-label', p ? '一時停止' : '再生');
			toggleBtn.classList.toggle('paused', !p);
		}

		root.querySelector('[data-act="prev"]')!.addEventListener('click', () => {
			setPlaying(false);
			show((current - 1 + frames.length) % frames.length, !reduce);
		});
		root.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			setPlaying(false);
			show((current + 1) % frames.length, !reduce);
		});
		toggleBtn.addEventListener('click', () => {
			if (playing) {
				setPlaying(false);
				stop();
			} else {
				setPlaying(true);
				playFrom(current);
			}
		});
		dots.forEach((d, k) =>
			d.addEventListener('click', () => {
				setPlaying(false);
				show(k, !reduce);
			}),
		);

		// 画面に見えている間だけ動かす
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (e.isIntersecting && playing) playFrom(current);
				else if (!e.isIntersecting) stop();
			}
		});
		io.observe(root);
		if (reduce) {
			toggleBtn.hidden = true;
			setPlaying(false);
		}
		show(0, false);
	}

	document.querySelectorAll<HTMLElement>('[data-court-anim]').forEach(setup);
</script>

