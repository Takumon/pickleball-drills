---
import type { Diagram } from '../content.config';
import {
	COURT,
	roleLabels,
	shotLabels,
	shotCurve,
	animMs,
	heightLevels,
	shotHeights,
	defaultReceiveHeight,
	type HeightLevel,
} from '../config/court';
import CourtFrame from './CourtFrame.astro';
import '../styles/court.css';

interface Props {
	diagram: Diagram;
	title?: string;
}
const { diagram, title = 'コート図' } = Astro.props;

/** 人・腕・パドルは見やすさ優先で、コートの縮尺より大きく描く（単位はフィート相当） */
const PLAYER_R = 1.3;
const uid = `c${Math.random().toString(36).slice(2, 8)}`;
const k1 = COURT.net - COURT.kitchen;
const k2 = COURT.net + COURT.kitchen;

type Point = [number, number];
type Player = Diagram['players'][number];
type Shot = Diagram['shots'][number];

/** 人の体・腕・パドルの位置を計算する（上から見た図。右利きなら本人から見て右手にパドル） */
function figureOf(p: Player, pos: Point) {
	const [x, y] = pos;
	const facing = p.facing ?? (y < COURT.net ? 'down' : 'up');
	const f: Point = facing === 'up' ? [0, -1] : [0, 1]; // 前
	const side = p.lefty ? -1 : 1;
	// 本人から見た右（上向きなら +x、下向きなら -x）。左利きなら逆側
	const r: Point = [-f[1] * side, f[0] * side];
	const at = (dr: number, df: number): Point => [x + r[0] * dr + f[0] * df, y + r[1] * dr + f[1] * df];
	// 構えごとの、肩・手・パドルの先の位置（体の中心からの「右」「前」の距離）
	// 腕 = 肩→手の細線、パドル = 手→先の太線。体から斜め前へ開くように描く
	const pose = {
		ready: { shoulder: [0.9, 0.5], hand: [1.55, 1.15], tip: [2.05, 1.6] }, // 右肩から右斜め前へ開く
		fh: { shoulder: [1.2, 0.3], hand: [2.0, 0.65], tip: [2.65, 0.9] }, // フォア側（右）へ大きく開く
		bh: { shoulder: [-0.9, 0.5], hand: [-1.55, 1.15], tip: [-2.05, 1.6] }, // バック側（左）斜め前へ開く
	}[p.paddle];
	const shoulder = at(pose.shoulder[0], pose.shoulder[1]);
	const hand = at(pose.hand[0], pose.hand[1]);
	const tip = at(pose.tip[0], pose.tip[1]);
	// 打球の線はパドルの真ん中から出す
	const face: Point = [(hand[0] + tip[0]) / 2, (hand[1] + tip[1]) / 2];
	return { ...p, x, y, shoulder, hand, tip, face };
}
type Figure = ReturnType<typeof figureOf>;

/** 端を縮める量（体の円・パドルの太線と重ならないように） */
const inset = { body: PLAYER_R + 0.3, paddle: 0.45, point: 0 } as const;

/**
 * 打球・動きの線を計算する。人を指す参照は、打球ならパドルの真ん中、人の動きなら体の中心へ。
 * 弧の大きさは打球の種類で決める（config/court.ts の shotCurve）。
 * データの curve は重なりよけ用なので、1コマに1手のコマ割り（straight=true）では使わない。
 */
function lineOf(s: Shot, byId: Map<string, Figure>, straight: boolean) {
	const target = s.type === 'move' ? 'body' : 'paddle';
	const resolve = (ref: string | Point) => {
		if (typeof ref === 'string') {
			const p = byId.get(ref);
			if (!p) throw new Error(`コート図: 人 "${ref}" が players にありません`);
			return target === 'paddle'
				? { pt: p.face, anchor: 'paddle' as const }
				: { pt: [p.x, p.y] as Point, anchor: 'body' as const };
		}
		return { pt: ref, anchor: 'point' as const };
	};
	const a = resolve(s.from);
	const b = resolve(s.to);
	let [x1, y1] = a.pt;
	let [x2, y2] = b.pt;
	const len = Math.hypot(x2 - x1, y2 - y1) || 1;
	const ux = (x2 - x1) / len;
	const uy = (y2 - y1) / len;
	const startInset = a.anchor === 'body' ? PLAYER_R : 0;
	[x1, y1] = [x1 + ux * startInset, y1 + uy * startInset];
	[x2, y2] = [x2 - ux * inset[b.anchor], y2 - uy * inset[b.anchor]];
	const typeCurve = shotCurve[s.type];
	const curve = straight ? typeCurve : (s.curve ?? typeCurve);
	// 曲げる量は距離に比例。正で進行方向の左側へふくらむ
	const cx = (x1 + x2) / 2 - uy * len * curve;
	const cy = (y1 + y2) / 2 + ux * len * curve;
	const d = curve ? `M${x1} ${y1} Q${cx} ${cy} ${x2} ${y2}` : `M${x1} ${y1} L${x2} ${y2}`;
	const pointAt = (t: number): Point =>
		curve
			? [(1 - t) ** 2 * x1 + 2 * (1 - t) * t * cx + t ** 2 * x2, (1 - t) ** 2 * y1 + 2 * (1 - t) * t * cy + t ** 2 * y2]
			: [x1 + (x2 - x1) * t, y1 + (y2 - y1) * t];
	// 名前は線の真ん中に置く。ネットの線や人に重なるときは、線の上の別の位置にずらす
	const bodies = [...byId.values()].map((p) => [p.x, p.y] as Point);
	const clear = (p: Point) =>
		Math.abs(p[1] - COURT.net) >= 1.6 && bodies.every(([bx, by]) => Math.hypot(p[0] - bx, p[1] - by) >= PLAYER_R + 1.6);
	const candidates = [0.5, 0.4, 0.6, 0.3, 0.7, 0.2, 0.8].map(pointAt);
	const mid = candidates.find(clear) ?? candidates.find((p) => Math.abs(p[1] - COURT.net) >= 1.6) ?? candidates[0];
	const label =
		s.label ?? (s.type === 'move' ? '移動' : s.feed ? `球出し（${shotLabels[s.type]}）` : shotLabels[s.type]);
	const receiver = typeof s.to === 'string' ? byId.get(s.to) : undefined;
	const bounces = bouncesOf(s, b.anchor, pointAt, receiver?.y);
	// ネットを越える位置（線の長さに対する割合）。越えなければ undefined
	const netAt = (y1 - COURT.net) * (y2 - COURT.net) < 0 ? (COURT.net - y1) / (y2 - y1) : undefined;
	// 飛ぶ時間は距離 ÷ 球の種類ごとの速さ（同じ種類の球は、距離によらず同じ速さに見える）
	const ms = animMs(s.type, Math.hypot(x2 - x1, y2 - y1));
	// 打つ前に一度弾ませる球: 打つ人の手前（打つ向き）で弾み、打点まで上がってから飛んでいく
	const pre: Point | undefined = s.afterBounce ? [x1 + ux * PRE_BOUNCE_FT, y1 + uy * PRE_BOUNCE_FT] : undefined;
	return { ...s, d, mid, label, ys: [y1, y2, curve ? cy : y1], bounces, heights: heightsOf(s, bounces, netAt), ms, pre };
}

/**
 * アニメーションのボールの高さ。打つ高さ → 山 → 着地（地面）または受ける高さ、を放物線でつなぎ、
 * 線の長さに沿って区切った高さ（ft）の列にする。script 側で、影を線の上に、ボールを高さの分だけ浮かせて大きく描く。高さの段階と既定値は config/court.ts の heightLevels・shotHeights。
 */
const ft = (l: HeightLevel) => heightLevels[l].ft;
/** 受ける高さ: 受けた人が次に打つ球の打点。次がなければ既定の高さ */
function receiveHeight(s: Shot) {
	if (typeof s.to !== 'string') return ft(defaultReceiveHeight);
	const rest = diagram.shots.slice(diagram.shots.indexOf(s) + 1);
	const next = rest.find((n) => n.type !== 'move' && n.from === s.to);
	if (next && next.type !== 'move') return ft(next.hit ?? shotHeights[next.type].hit);
	// 次に打つ球が図にないとき: 弾んでから受ける球は低い位置（膝の高さ）、ノーバウンドで受ける球は既定の高さ
	return ft(s.bounce === 'front' ? 'knee' : defaultReceiveHeight);
}
function heightsOf(s: Shot, bounces: { at: number }[], netAt?: number) {
	const height = heightFn(s, bounces, netAt);
	return height && Array.from({ length: 41 }, (_, i) => height(i / 40).toFixed(2)).join(',');
}

/** 線に沿った高さ（ft）を返す関数。t は線の長さに対する割合 */
function heightFn(s: Shot, bounces: { at: number }[], netAt?: number): ((t: number) => number) | undefined {
	if (s.type === 'move') return undefined;
	const h0 = ft(s.hit ?? shotHeights[s.type].hit);
	const peak = ft(s.peak ?? shotHeights[s.type].peak);
	const recv = receiveHeight(s);
	// 高さの放物線（2次ベジェ）。山が両端より低ければ、そのままつなぐ
	const hop = (ha: number, hb: number, p: number) => {
		const c = p > Math.max(ha, hb) ? 2 * p - (ha + hb) / 2 : (ha + hb) / 2;
		return (u: number) => (1 - u) ** 2 * ha + 2 * u * (1 - u) * c + u ** 2 * hb;
	};
	const b = bounces[0]?.at;
	// ドライブ（ストローク）: 低く打ち出して少しだけ弧を描き、ネットの白帯を越える手前で山になり、
	// トップスピンでネットを越えたあとにぐっと沈む（前半はゆるやかに上がり、後半は加速して下がる）
	if (s.type === 'drive' || s.type === 'roll') {
		const end = b !== undefined && b < 0.999 ? b : 1;
		const hEnd = b !== undefined ? 0 : recv;
		const ta = Math.min(0.8, Math.max(0.2, (netAt ?? 0.5) * 0.9)) * end;
		const hA = Math.max(h0, hEnd, ft('tape')) + DRIVE_CLEAR_FT;
		const dip = (t: number) => {
			if (t <= ta) return h0 + (hA - h0) * (1 - (1 - t / ta) ** 2);
			return hA + (hEnd - hA) * ((t - ta) / (end - ta)) ** 2.4;
		};
		if (end < 1) {
			const after = hop(0, recv, recv);
			return (t) => (t <= end ? dip(t) : after((t - end) / (1 - end)));
		}
		return dip;
	}
	let height: (t: number) => number;
	if (b !== undefined && b <= 0.001) {
		// 打った直後に弾む（バウンド位置が打つ人のすぐそば）: 地面から受ける高さまで上がるだけにする
		height = hop(0, recv, recv);
	} else if (b !== undefined && b < 0.999) {
		// 途中で弾む: 着地まで1つ目の山、弾んでから受ける高さまで上がる
		const first = hop(h0, 0, peak);
		const second = hop(0, recv, recv);
		height = (t) => (t <= b ? first(t / b) : second((t - b) / (1 - b)));
	} else {
		height = hop(h0, b !== undefined ? 0 : recv, peak);
	}
	return height;
}

/** ドライブがネットの白帯の上をどれだけ越えるか（ft） */
const DRIVE_CLEAR_FT = 0.8;

/**
 * 「受ける人の手前で弾む」球のバウンド位置: 受ける人（のパドル）から何 ft 手前で弾むか。
 * ベースラインの後ろで受ける球（サーブ・リターン・深い球出し）は深く弾み、キッチンやトランで受ける球は少し手前で弾む。
 */
const BOUNCE_BEFORE = { baseline: 4.3, other: 2.1 } as const;
/** 打つ前に一度弾ませる球（afterBounce）が、打つ人の何 ft 手前で弾むか */
const PRE_BOUNCE_FT = 1.8;

/**
 * バウンドの印の位置。at は線の長さに対する割合（アニメーションで、ボールがそこを通ったときに印を出す）。
 */
function bouncesOf(s: Shot, toAnchor: 'paddle' | 'body' | 'point', pointAt: (t: number) => Point, receiverY?: number) {
	if (s.type === 'move' || s.bounce === false) return [];
	// 線を細かく区切って、長さの割合と点の対応を作る
	const N = 200;
	const pts = Array.from({ length: N + 1 }, (_, i) => pointAt(i / N));
	const cum = [0];
	for (let i = 1; i <= N; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
	const total = cum[N] || 1;
	const at = (i: number) => ({ pt: pts[i], at: cum[i] / total });
	// 受ける人の手前で弾む（bounce: front、サーブ・リターンの既定）: 受ける人の位置から決まった距離だけ手前
	const front = () => {
		const behindBaseline = receiverY !== undefined && (receiverY < 0 || receiverY > COURT.length);
		const d = behindBaseline ? BOUNCE_BEFORE.baseline : BOUNCE_BEFORE.other;
		return [at(Math.max(0, cum.findIndex((c) => c >= total - d)))];
	};
	if (s.bounce === 'front') return front();
	if (s.bounce) {
		const [bx, by] = s.bounce;
		let best = 0;
		pts.forEach((p, i) => {
			if (Math.hypot(p[0] - bx, p[1] - by) < Math.hypot(pts[best][0] - bx, pts[best][1] - by)) best = i;
		});
		return [at(best)];
	}
	if (toAnchor === 'point') return [at(N)];
	if (s.type === 'serve' || s.type === 'return') return front();
	return [];
}

/**
 * コマ割り: 番号（n）ごとに1コマにする。番号のない線は、番号のある線がなければ1コマにまとめる。
 * 人の動き（move）で人が移動したら、次のコマからは移動先に描く。
 */
const numbered = [...new Set(diagram.shots.flatMap((s) => (s.n === undefined ? [] : [s.n])))].sort((a, b) => a - b);
const groups: { n?: number; shots: Shot[] }[] =
	numbered.length > 0
		? numbered.map((n) => ({ n, shots: diagram.shots.filter((s) => s.n === n) }))
		: [{ shots: diagram.shots }];
const positions = new Map<string, Point>(diagram.players.map((p) => [p.id, [p.x, p.y]]));
const panels = groups.map((g) => {
	const figures = diagram.players.map((p) => figureOf(p, positions.get(p.id)!));
	const byId = new Map(figures.map((f) => [f.id, f]));
	const lines = g.shots.map((s) => lineOf(s, byId, groups.length > 1));
	// 横から見た図で描くパドルの高さ: この手で打つ人は打つ高さ、受ける人は受ける高さ、ほかは既定の高さ。
	// 同じ手で2つ以上打つときも、それぞれの打球から決める
	const sideH = (id: string) => {
		for (const s of g.shots) {
			if (s.type === 'move') continue;
			if (s.from === id) return ft(s.hit ?? shotHeights[s.type].hit);
			if (s.to === id) return receiveHeight(s);
		}
		return ft(defaultReceiveHeight);
	};
	for (const f of figures) Object.assign(f, { sideH: sideH(f.id) });
	for (const s of g.shots) {
		if (s.type === 'move' && typeof s.from === 'string' && typeof s.to !== 'string') positions.set(s.from, s.to);
	}
	return { n: g.n, figures, lines };
});
const multi = panels.length > 1;

// 表示範囲: crop=auto なら、人と打球が入る縦の範囲だけを切り出す（横はコート全幅、ネットは必ず入れる）。
// ただし、トランが関わる側（人や打球がキッチンラインより3ft以上後ろにある）は
// 位置関係が分かるように必ずベースラインまで入れる。全コマで同じ範囲にそろえる。
const padX = multi ? 1.5 : 3.5;
const pad = 3.5;
let top = -pad;
let bottom = COURT.length + pad;
if (diagram.crop === 'auto') {
	const ys = [
		COURT.net,
		...panels.flatMap((pn) => [...pn.figures.flatMap((p) => [p.y, p.face[1]]), ...pn.lines.flatMap((l) => l.ys)]),
	];
	const backTop = Math.min(...ys) <= k1 - 3;
	const backBottom = Math.max(...ys) >= k2 + 3;
	const baselineMargin = 1.5;
	top = backTop ? -baselineMargin : Math.max(-pad, Math.min(...ys) - 3.5);
	bottom = backBottom ? COURT.length + baselineMargin : Math.min(COURT.length + pad, Math.max(...ys) + 3.5);
	// ベースラインより後ろに人や打球があるときは、それも入れる
	top = Math.min(top, Math.max(-pad, Math.min(...ys) - 1.5));
	bottom = Math.max(bottom, Math.min(COURT.length + pad, Math.max(...ys) + 1.5));
}
// ベースラインの後ろに立つ人（サーブ・リターンなど）は、丸が切れないように全体を入れる
const figureYs = panels.flatMap((pn) => pn.figures.map((p) => p.y));
top = Math.min(top, Math.min(...figureYs) - PLAYER_R - 0.4);
bottom = Math.max(bottom, Math.max(...figureYs) + PLAYER_R + 0.4);
// アニメーションの図は、コートの右に「横から見た高さ」の帯を付ける（縦の位置はコートと同じ、横の位置が高さ）
const SIDE = { gap: 1.2, width: 8, unitPerFt: 0.8 };
const side = multi ? { x0: COURT.width + padX + SIDE.gap, k: SIDE.unitPerFt, width: SIDE.width, top, bottom } : undefined;
const viewBox = `${-padX} ${top} ${COURT.width + padX * 2 + (side ? SIDE.gap + SIDE.width : 0)} ${bottom - top}`;

// 線の名前が図の左右からはみ出さないよう、横位置を内側に寄せる。
// 文字幅は全角1文字 ≒ フォントサイズとして見積もる（styles/court.css の .shot-label と合わせる）
const labelFont = multi ? 1.7 : 1.3;
for (const pn of panels) {
	for (const l of pn.lines) {
		if (!l.label) continue;
		const half = ([...l.label].length * labelFont) / 2 + 0.3;
		const minX = -padX + half;
		const maxX = COURT.width + padX - half;
		l.mid = [minX > maxX ? COURT.width / 2 : Math.min(Math.max(l.mid[0], minX), maxX), l.mid[1]];
	}
}
const circled = (n: number) => (n >= 1 && n <= 20 ? String.fromCodePoint(0x2460 + n - 1) : `${n}.`);
---

<figure class:list={['court', { multi }]} style={`--cols: ${Math.min(panels.length, 4)}`}>
	{
		multi && (
			<div class="anim" data-court-anim>
				<div class="anim-stage">
					{panels.map((pn, i) => (
						<CourtFrame
							figures={pn.figures}
							lines={pn.lines}
							viewBox={viewBox}
							zones={diagram.zones}
							fences={diagram.fences}
							uid={`${uid}a${i}`}
							playerR={PLAYER_R}
							title={`${title}（アニメーション ${i + 1}）`}
							animated
							side={side}
							step={i}
						/>
					))}
				</div>
				<div class="anim-controls">
					<button type="button" data-act="prev" aria-label="前の手">◀</button>
					<button type="button" data-act="toggle" aria-label="一時停止">❚❚</button>
					<button type="button" data-act="next" aria-label="次の手">▶</button>
					<span class="anim-steps">
						{panels.map((pn, i) => (
							<button type="button" class="anim-step" data-step-dot={i} aria-label={`${i + 1}手目を見る`}>
								{pn.n !== undefined ? circled(pn.n) : i + 1}
							</button>
						))}
					</span>
				</div>
			</div>
		)
	}
	{/* 複数の手がある図はアニメーションだけを出す。1手だけの図は、止まった図を1枚出す */}
	{!multi && (
	<div class="panels">
		{
			panels.map((pn, i) => (
				<div class="panel">
					<CourtFrame
						figures={pn.figures}
						lines={pn.lines}
						viewBox={viewBox}
						zones={diagram.zones}
							fences={diagram.fences}
						uid={`${uid}p${i}`}
						playerR={PLAYER_R}
						title={title}
					/>
				</div>
			))
		}
	</div>
	)}
	<figcaption>
		<ul class="legend">
			{
				// 誰がどの役かは、色ではなく文字で書く（例: A 球出し役　B 練習役。同じ役は「A・B 練習役」とまとめる）
				[...new Set(diagram.players.map((p) => p.role))].map((r) => (
					<li>
						<span class="who">
							{diagram.players
								.filter((p) => p.role === r)
								.map((p) => p.label ?? p.id)
								.sort()
								.join('・')}
						</span>
						{roleLabels[r]}
					</li>
				))
			}
			{
				diagram.fences.length > 0 && (
					<li>
						<svg class="fence-swatch" viewBox="0 0 3 1" aria-hidden="true">
							<g class="fence">
								<line x1="0.25" y1="0.5" x2="2.75" y2="0.5" />
								<rect x="0.05" y="0.3" width="0.4" height="0.4" rx="0.05" />
								<rect x="1.3" y="0.3" width="0.4" height="0.4" rx="0.05" />
								<rect x="2.55" y="0.3" width="0.4" height="0.4" rx="0.05" />
							</g>
						</svg>
						柵
					</li>
				)
			}
		</ul>
		{diagram.caption && <p class="caption">{diagram.caption}</p>}
	</figcaption>
</figure>

<script>
	import { setupCourtAnimations } from '../scripts/court-anim';
	setupCourtAnimations();
</script>

