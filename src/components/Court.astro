							<div class="score-bar">
								{Array.from({ length: diagram.score.to * 2 + 1 }, (_, k) => k - diagram.score!.to).map((v) => (
									<span class:list={['score-tick', { zero: v === 0 }]} style={`--pos: ${(v + diagram.score!.to) / (diagram.score!.to * 2)}`}>
										{v > 0 ? `+${v}` : v < 0 ? `−${-v}` : '0'}
									</span>
								))}
								<span class="score-marker" style="--pos: 0.5" />
							</div>
							<span class="score-end">{diagram.score.plus} の勝ち</span>
						</div>
					)
				}
				<div class="anim-controls">
					<button type="button" data-act="prev" aria-label="前の手">◀</button>
					<button type="button" data-act="toggle" aria-label="一時停止">❚❚</button>
					<button type="button" data-act="next" aria-label="次の手">▶</button>
					<span class="anim-steps">
						{panels.map((pn, i) => (
							<button type="button" class="anim-step" data-step-dot={i} aria-label={`${i + 1}手目を見る`}>
								{pn.n !== undefined ? circled(pn.n) : i + 1}
							</button>
						))}
					</span>
				</div>
			</div>
		)
	}
	{
		stillPanel && (
			<div class="panels">
				<div class="panel">
					<CourtFrame
						figures={stillPanel.figures}
						lines={stillPanel.lines}
						viewBox={viewBox}
						zones={diagram.zones}
						fences={diagram.fences}
						uid={`${uid}s`}
						playerR={PLAYER_R}
						title={title}
					/>
				</div>
			</div>
		)
	}
	{/* 複数の手がある図はアニメーションだけを出す。1手だけの図は、止まった図を1枚出す */}
	{!multi && !stillPanel && (
	<div class="panels">
		{
			panels.map((pn, i) => (
				<div class="panel">
					<CourtFrame
						figures={pn.figures}
						lines={pn.lines}
						viewBox={viewBox}
						zones={diagram.zones}
							fences={diagram.fences}
						uid={`${uid}p${i}`}
						playerR={PLAYER_R}
						title={title}
					/>
				</div>
			))
		}
	</div>
	)}
	{diagram.caption && (
		<figcaption>
			<p class="caption">{diagram.caption}</p>
		</figcaption>
	)}
</figure>

