---
/**
 * コート図の1コマ分（コート・人・打球・名前）を描く。
 * Court.astro から、コマ割りの各コマとアニメーションの各場面の両方で使う。
 * スタイルは Court.astro の .court 配下（is:global）で当てる。
 */
import { COURT, keyPoseOf, WAIST_FT, shotSwing, swingOf, zoneRects, type ZoneName } from '../config/court';
import { sideFigure } from '../lib/side-figure';
import { taper } from '../lib/arm-shape';
import { fitPoses } from '../lib/side-render';

type Point = [number, number];
interface Figure {
	id: string;
	role: string;
	label?: string;
	x: number;
	y: number;
	shoulder: Point;
	hand: Point;
	tip: Point;
	/** 横から見た図で描くパドルの高さ（ft） */
	sideH?: number;
	/** 横から見た図の構えに使う打ち方（打つ球、受けるなら次に打つ球） */
	sideType?: string;
	/** パドルの構え（ready / fh / bh） */
	paddle?: string;
}
interface Line {
	type: string;
	from: string | Point;
	d: string;
	mid: Point;
	label?: string;
	bounces?: { pt: Point; at: number }[];
	/** アニメーションのボールの高さ（ft）の列 */
	heights?: string;
	/** アニメーションで飛ぶ（動く）時間（ミリ秒） */
	ms?: number;
	/** 打つ前に弾む位置（afterBounce） */
	pre?: Point;
	/** トラップして弾ませる球: 受けた高さ（ft）。ここから少し上がってから落ちる */
	preFromH?: number;
	/** ボレーのトラップ: 弾ませずに、ポンと上げた球を打つ高さで打つ（弾む印を出さない） */
	prePop?: boolean;
	/** 球出しの球（新しいボールを出す）。アニメーションの連続性を測るときに、ここでボールが跳ぶのは正しい */
	feed?: boolean;
	/** 動き出すまでの遅れ（ミリ秒）。相手の打球を見てから動く人 */
	delay?: number;
	/** 新しいボール（前の球で点が決まったあと、または球出し） */
	fresh?: boolean;
	/** ゲーム形式: この球で点を失った人の上（「失点」を出す位置） */
	lostAt?: Point;
	/** lostAt に出す文（省略時は「失点」。ミスの球では「残りNつ」） */
	lostText?: string;
	/** 失敗した球（miss）。名前と「×」を、ほかと違う色で出す */
	miss?: 'net' | 'out';
	/** 失敗した球の線の長さの割合（ほかの球と同じ速さで飛ばすため） */
	span?: number;
	/** 失敗した球が止まった所・落ちた所（「×」を出す） */
	missAt?: Point;
	/** 人の動きで、体の中心が動く量（線の長さではなく、動く前と後の位置の差） */
	shift?: Point;
	/** ロブに下がる人: 後ろを向いて走り、最後に前足を踏み込んで前を向き直る（横から見た図） */
	run?: boolean;
}
interface Props {
	figures: Figure[];
	lines: Line[];
	viewBox: string;
	zones: ZoneName[];
	fences?: [Point, Point][];
	uid: string;
	playerR: number;
	title: string;
	/** アニメーション用の場面として描く（ボールと data 属性を付ける） */
	animated?: boolean;
	/** 横から見た高さの帯（x0: 地面の線の x、k: 高さ 1ft あたりの長さ） */
	side?: { x0: number; k: number; width: number; top: number; bottom: number };
	step?: number;
	/** ゲーム形式の点: この手の前と後の点 */
	score?: { before: number; after: number };
	/** ゲーム形式: この手で勝ちの点に届いた人（「〇 の勝ち」を出す） */
	win?: string;
	/** 手が終わったときにコートの真ん中に出す文（失敗の決まり: 「失敗 → 4つから出し直し」）。出し方は win と同じ */
	banner?: string;
}
/** 打つ高さ（ft。線の高さの列の最初） */
const hitOf = (l: { heights?: string }) => (l.heights ? Number(l.heights.split(',')[0]) : undefined);
/** 打つ人のパドルの構え（フォア・バックで打つ動きの形を選ぶ） */
const handOf = (from: string | Point) => (typeof from === 'string' ? Astro.props.figures.find((f) => f.id === from)?.paddle : undefined);
const { figures, lines, viewBox, zones, fences = [], uid, playerR, title, animated = false, side, step, score, win, banner } = Astro.props;
const NET_FT = 2.9;
/** 横から見た図: ラインの位置で地面の線の色を変える長さ */
const GROUND_MARK = 0.6;
// 線を伸ばして見せるマスクの範囲。図の表示範囲（viewBox）に余白を足して、どこに引いた線も切れないようにする
const [vbX, vbY, vbW, vbH] = viewBox.split(/\s+/).map(Number);
const maskBox = { x: vbX - 10, y: vbY - 10, width: vbW + 20, height: vbH + 20 };
/**
 * 角を選んで丸くした長方形の形（path の d）。r: 丸める半径、round: [左上, 右上, 右下, 左下] を丸くするか。
 * 上から見た図と横から見た帯は、2つで1枚に見えるよう、向かい合う内側の角を四角にする（書き手と決めた）
 */
const roundRect = (x: number, y: number, w: number, h: number, r: number, [tl, tr, br, bl]: [boolean, boolean, boolean, boolean]) => {
	const a = (on: boolean) => (on ? r : 0);
	return [
		`M${x + a(tl)},${y}`,
		`H${x + w - a(tr)}`,
		tr ? `A${r},${r} 0 0 1 ${x + w},${y + r}` : '',
		`V${y + h - a(br)}`,
		br ? `A${r},${r} 0 0 1 ${x + w - r},${y + h}` : '',
		`H${x + a(bl)}`,
		bl ? `A${r},${r} 0 0 1 ${x},${y + h - r}` : '',
		`V${y + a(tl)}`,
		tl ? `A${r},${r} 0 0 1 ${x + r},${y}` : '',
		'Z',
	].join('');
};
/* 横から見た図の人（棒人間）は src/lib/side-figure.ts で組み立てる */
/** 弾んだ位置の輪の半径（控えめに小さく） */
const MARK = 0.45;
/** 練習役の二重丸: 内側の線を、体の丸のふちから何 ft 内側に引くか */
const INNER_RING_INSET = 0.25;
/**
 * 人の外側の暗い縁。白い線（キッチンラインなど）と人の丸の境目を分かるようにする。
 * 縁を足しても人が大きく見えないよう、丸を BODY_SHRINK だけ小さくし、縁の外側が元の丸の大きさに収まるようにする
 * （縁の線の太さは court.css の .halo、0.4）
 */
const BODY_SHRINK = 0.3;
const HALO_R = BODY_SHRINK - 0.1;
/** 柵の支柱の大きさと間隔（ft） */
const FENCE_POST = 0.5;
const FENCE_POST_GAP = 1.6;
const k1 = COURT.net - COURT.kitchen;
const k2 = COURT.net + COURT.kitchen;
const isSub = (t: string) => t === 'move';
---

<svg
	viewBox={viewBox}
	role="img"
	aria-label={title}
	class:list={['court-svg', { frame: animated }]}
	data-step={step}
	data-score-before={score?.before}
	data-score-after={score?.after}
	data-side-x0={side?.x0}
	data-side-k={side?.k}
	data-side-max={side ? side.width / side.k : undefined}
>
	<defs>
		{/* 矢印の先の三角の大きさ（ft）。前は 1.9 で大きすぎた（書き手の指摘、2026-11-28） */}
		<marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.3" markerHeight="1.3" orient="auto-start-reverse">
			<path d="M0 0 L10 5 L0 10 z" class="arrowhead" />
		</marker>
		<marker id={`${uid}-arrow-sub`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.3" markerHeight="1.3" orient="auto-start-reverse">
			<path d="M0 0 L10 5 L0 10 z" class="arrowhead sub" />
		</marker>
	</defs>

	{/* コートの外まわり（ベースラインの後ろなど）も地面として塗る。人がコートの外に立っても、ページの背景に溶けないようにする */}
	<path class="apron" d={roundRect(vbX, vbY, side ? side.x0 - 0.9 - vbX : vbW, vbH, 0.6, side ? [true, false, false, true] : [true, true, true, true])} />
	<rect class="surface" x="0" y="0" width={COURT.width} height={COURT.length} />
	<rect class="kitchen" x="0" y={k1} width={COURT.width} height={COURT.kitchen * 2} />
	{
		zones.map((z) => {
			const [x, y, w, h] = zoneRects[z];
			return <rect class="zone" x={x} y={y} width={w} height={h} />;
		})
	}
	<g class="lines">
		<rect x="0" y="0" width={COURT.width} height={COURT.length} />
		<line x1="0" y1={k1} x2={COURT.width} y2={k1} />
		<line x1="0" y1={k2} x2={COURT.width} y2={k2} />
		<line x1={COURT.width / 2} y1="0" x2={COURT.width / 2} y2={k1} />
		<line x1={COURT.width / 2} y1={k2} x2={COURT.width / 2} y2={COURT.length} />
	</g>
	<line class="net" x1="-1" y1={COURT.net} x2={COURT.width + 1} y2={COURT.net} />
	{
		// 柵: 細い横木と、一定の間隔の支柱で描く（打球の線と見分けられるよう、色も形も変える）
		fences.map(([a, b]) => {
			const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
			const n = Math.max(1, Math.round(len / FENCE_POST_GAP));
			const posts = Array.from({ length: n + 1 }, (_, i) => [a[0] + ((b[0] - a[0]) * i) / n, a[1] + ((b[1] - a[1]) * i) / n]);
			return (
				<g class="fence">
					<line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />
					{posts.map(([x, y]) => (
						<rect x={x - FENCE_POST / 2} y={y - FENCE_POST / 2} width={FENCE_POST} height={FENCE_POST} rx="0.06" />
					))}
				</g>
			);
		})
	}

	{
		lines.map((l, i) => {
			// アニメーションでは、線（点線・破線を含む）をマスクで少しずつ見せて「伸びる」ように描く
			const reveal = animated && l.type !== 'move';
			return (
				<>
					{reveal && (
						<mask id={`${uid}-m${i}`} maskUnits="userSpaceOnUse" x={maskBox.x} y={maskBox.y} width={maskBox.width} height={maskBox.height}>
							<path class="reveal" d={l.d} data-i={i} fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
						</mask>
					)}
					<path
						class:list={['shot', `t-${l.type}`, { sub: isSub(l.type) }]}
						d={l.d}
						marker-end={`url(#${uid}-${isSub(l.type) ? 'arrow-sub' : 'arrow'})`}
						mask={reveal ? `url(#${uid}-m${i})` : undefined}
						data-i={i}
						data-kind={animated ? (l.type === 'move' ? 'move' : 'ball') : undefined}
						data-player={animated && l.type === 'move' && typeof l.from === 'string' ? l.from : undefined}
						data-hitter={animated && l.type !== 'move' && typeof l.from === 'string' ? l.from : undefined}
						data-type={animated && l.type !== 'move' ? l.type : undefined}
						data-swing={animated && l.type !== 'move' && l.type in shotSwing ? ((sw) => [...sw.back, ...sw.follow, ...sw.turn, ...(sw.via ? sw.via.flat() : [])].join(','))(swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l))) : undefined}
						data-setup={animated && l.type !== 'move' && l.type in shotSwing && swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l)).setup ? '' : undefined}
						data-hold={animated && l.type !== 'move' && l.type in shotSwing && swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l)).hold ? '' : undefined}
						data-pivot={animated && l.type !== 'move' && l.type in shotSwing ? swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l)).pivot : undefined}
						data-straight={animated && l.type !== 'move' && l.type in shotSwing && swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l)).straight ? '' : undefined}
						data-keyposes={animated && l.type !== 'move' && (handOf(l.from) !== 'bh' || (hitOf(l) ?? 0) > WAIST_FT) && keyPoseOf(l.type, hitOf(l)) ? JSON.stringify(keyPoseOf(l.type, hitOf(l))!.poses) : undefined}
						data-pivot-turn={animated && l.type !== 'move' && l.type in shotSwing ? swingOf(l.type as keyof typeof shotSwing, handOf(l.from), hitOf(l)).pivotTurn?.join(',') : undefined}
						data-shift={animated && l.shift ? l.shift.join(',') : undefined}
						data-ms={animated ? l.ms : undefined}
						data-span={animated && l.span ? l.span : undefined}
						data-pre={animated && l.pre ? `${l.pre[0]},${l.pre[1]}` : undefined}
						data-pre-from-h={animated && l.preFromH !== undefined ? l.preFromH : undefined}
						data-pre-pop={animated && l.prePop ? '' : undefined}
						data-run={animated && l.run ? '' : undefined}
						data-fresh={animated && l.type !== 'move' && (l.feed || l.fresh || (l.pre && l.preFromH === undefined)) ? '' : undefined}
						data-delay={animated && l.delay ? l.delay : undefined}
						data-h={animated ? l.heights : undefined}
					/>
				</>
			);
		})
	}

	{
		lines.flatMap((l) => [
			// 打つ前に弾む位置（その手の始まりに出す）
			...(l.pre && !l.prePop
				? [
						<g class:list={['bounce', { on: !animated }]} data-pre-ring>
							<circle cx={l.pre[0]} cy={l.pre[1]} r={MARK} />
						</g>,
					]
				: []),
			...(l.bounces ?? []).map((b) => (
				<g class:list={['bounce', { on: !animated }]} data-at={b.at}>
					<circle cx={b.pt[0]} cy={b.pt[1]} r={MARK} />
				</g>
			)),
		])
	}

	{
		figures.map((p) => (
			<g class={`player role-${p.role}`} data-player-id={animated ? p.id : undefined}>
				<line class="arm" x1={p.shoulder[0]} y1={p.shoulder[1]} x2={p.hand[0]} y2={p.hand[1]} />
				<line class="paddle" x1={p.hand[0]} y1={p.hand[1]} x2={p.tip[0]} y2={p.tip[1]} />
				<circle class="halo" cx={p.x} cy={p.y} r={playerR - HALO_R} />
				<circle class="body" cx={p.x} cy={p.y} r={playerR - BODY_SHRINK} />
				{/* 練習する人（練習役）は、丸の内側に線を入れて二重丸にする（外に足すと人が大きく見えるため）。2人とも練習するときは2人とも */}
				{p.role === 'practice' && <circle class="inner-ring" cx={p.x} cy={p.y} r={playerR - BODY_SHRINK - INNER_RING_INSET} />}
				<text x={p.x} y={p.y}>
					{p.label ?? p.id}
				</text>
			</g>
		))
	}

	{
		lines.map(
			(l) =>
				l.label && (
					<text class:list={['shot-label', { miss: !!l.miss }]} x={l.mid[0]} y={l.mid[1]}>
						{l.label}
					</text>
				),
		)
	}
	{
		/* トラップ（相手から来た球をパドルで受けてポンと上げる）の間だけ、パドルの横に「トラップ」と出す（書き手の希望）。止まった図では出さない */
		animated &&
			lines.map(
				(l) =>
					l.pre &&
					l.preFromH !== undefined && (
						<text class="trap-label" x={l.pre[0] + (l.pre[0] < COURT.width / 2 ? 2.6 : -2.6)} y={l.pre[1]} data-trap-label>
							トラップ
						</text>
					),
			)
	}
	{
		/* ゲーム形式: 勝ちの点に届いた手では、コートの真ん中に「〇 の勝ち」。アニメーションでは手が終わったときにポンと出す */
		win && (
			<text class:list={['win-label', { on: !animated }]} x={COURT.width / 2} y={COURT.net} data-win>
				{win} の勝ち
			</text>
		)
	}
	{
		/* 失敗の決まり: 球が決まりの数まで減った手では、真ん中に「失敗 → 出し直し」。出し方は「〇 の勝ち」と同じ */
		banner && (
			<text class:list={['win-label', 'banner', { on: !animated }]} x={COURT.width / 2} y={COURT.net - 1.2} data-win>
				{/* 1行目を大きく、2行目（出し直しの案内）は小さく。長い1行だとコートからはみ出すため */}
				{banner.split('\n').map((t, k) => (
					<tspan x={COURT.width / 2} dy={k === 0 ? 0 : 3} class:list={{ sub: k > 0 }}>
						{t}
					</tspan>
				))}
			</text>
		)
	}
	{
		/* 失敗した球（miss）: 止まった所・落ちた所に「×」。アニメーションでは、その手が終わったときに出す */
		lines.map(
			(l) =>
				l.missAt && (
					<text class:list={['miss-x', 'lost-label', { on: !animated }]} x={l.missAt[0]} y={l.missAt[1]} data-lost>
						×
					</text>
				),
		)
	}
	{
		/* ゲーム形式: 点を失った人の上に「失点」。アニメーションでは、その手が終わったときにふわっと出す */
		lines.map(
			(l) =>
				l.lostAt && (
					<text class:list={['lost-label', { miss: !!l.miss, on: !animated }]} x={l.lostAt[0]} y={l.lostAt[1]} data-lost>
						{l.lostText ?? '失点'}
					</text>
				),
		)
	}

	{
		// 横から見た高さ: 縦の線が地面、右へ行くほど高い。ネットの高さと、ボールの通り道（高さの変化）を描く
		side && (
			<g class="side">
				{/* 横から見た帯の枠は、上から見たコートの枠（.apron）と上下をそろえる（書き手の指摘: 上下が少しずれていた）。
				    右の端も図の右端（viewBox の右端）にそろえ、角丸が切れないようにする */}
				<path class="side-panel" d={roundRect(side.x0 - 0.7, vbY, vbX + vbW - (side.x0 - 0.7), vbH, 0.6, [false, true, true, false])} />
				{/* 地面の線（補助の図なので1色）。ベースラインとキッチンラインの位置だけ、同じ太さのまま色を変える */}
				<line class="side-ground" x1={side.x0} y1={side.top + 2.2} x2={side.x0} y2={side.bottom - 0.6} />
				{[0, k1, k2, COURT.length]
					.filter((y) => y > side.top + 2.2 && y < side.bottom - 0.6)
					.map((y) => (
						<line class="side-ground side-mark" x1={side.x0} y1={y - GROUND_MARK / 2} x2={side.x0} y2={y + GROUND_MARK / 2} />
					))}
				<line class="side-net" x1={side.x0} y1={COURT.net} x2={side.x0 + NET_FT * side.k} y2={COURT.net} />
				{figures.map((p) => {
					// 決めのポーズ（keyPoses）がある打ち方は、決めのポーズで描く。アニメーションでは、この入力でポーズを組み立て直す
					// この手で打つ球の飛び出す向き（横から見た図の上下の角度。度、上が +）: 高さの列の最初の2つと、線の奥行きの長さから
					const own = lines.find((l) => l.type !== 'move' && l.from === p.id && l.type === p.sideType && l.heights);
					const launch = (() => {
						if (!own?.heights) return undefined;
						const hs = own.heights.split(',').map(Number);
						const ns = own.d.match(/-?\d*\.?\d+/g)?.map(Number) ?? [];
						if (hs.length < 2 || ns.length < 4) return undefined;
						const dy = Math.abs(ns[ns.length - 1] - ns[1]) / (hs.length - 1);
						return (Math.atan2(hs[1] - hs[0], dy || 1e-6) * 180) / Math.PI;
					})();
					const poseInput = {
						launch,
						x0: side.x0,
						k: side.k,
						y: p.y,
						toNet: p.y < COURT.net ? 1 : -1,
						hitH: p.sideH ?? 4,
						shot: p.sideType,
						hand: p.paddle,
						faceY: (p.hand[1] + p.tip[1]) / 2,
					};
					const kp = p.sideType && (p.paddle !== 'bh' || (p.sideH ?? 0) > WAIST_FT) ? keyPoseOf(p.sideType, p.sideH) : undefined;
					// 止まった形は構え（ready）。体の前後の位置は打つ瞬間のポーズに合わせる（動き出しで体が滑らないように）
					// ポーズは打つ高さに合わせる（fitPoses）。体の前後の位置は打つ瞬間に合わせる
					const fit = kp ? fitPoses(poseInput, kp.poses) : undefined;
					const bodyBack = fit?.bodyBack;
					const fig = sideFigure({ ...poseInput, angles: fit?.poses.ready, bodyBack });
					// 決まりの確かめ（ドリルごとに見なくてよいように、全部の図を作るときに測る）: 打つ瞬間のパドルの面の真ん中が球に届いているか。
					// 届かないとき（体を前に置けない、腕が届かないなど）は、ビルドの出力で知らせる
					if (p.sideType) {
						const hitFig = fit ? sideFigure({ ...poseInput, angles: fit.poses.contact, bodyBack }) : fig;
						const [cx1, cy1, cx2, cy2] = hitFig.face;
						const miss = Math.hypot((cx1 + cx2) / 2 - (side.x0 + poseInput.hitH * side.k), (cy1 + cy2) / 2 - poseInput.faceY) / side.k;
						if (miss > 0.5) console.warn(`[図の確かめ] ${Astro.url.pathname} ${p.id}（${p.sideType}）: 打つ瞬間の面が球から ${miss.toFixed(1)}ft 離れている`);
					}
					const [ax1, ay1, ax2, ay2] = fig.upperArm;
					const [fx1, fy1, fx2, fy2] = fig.forearm;
					const [nx1, ny1, nx2, ny2] = fig.neck;
					const [gx1, gy1, gx2, gy2] = fig.grip;
					const [px1, py1, px2, py2] = fig.face;
					return (
						<g class={`side-person role-${p.role}`} data-side-player={animated ? p.id : undefined} data-pose-input={animated ? JSON.stringify(poseInput) : undefined} data-pose-static={animated && fit ? JSON.stringify(fit.poses.ready) : undefined} data-pose-body-back={animated && kp ? bodyBack : undefined}>
							{/* スニーカー、足（足首〜ひざ〜股関節）、胴、首、頭、腕（肩〜ひじ〜手）、パドル */}
							{/* 奥の足（走る・踏み込むときだけ手前の足と離れて見える） */}
							<polygon class="side-shoe2" points={fig.shoe2} />
							<path class="side-lower2" d={fig.lowerBody2} />
							<polygon class="side-shoe" points={fig.shoe} />
							<path class="side-lower" d={fig.lowerBody} />
							<path class="side-torso" d={fig.torso} />
							{/* 股関節のまわりを丸く埋めて、胴と足のつなぎめに切れ目ができないようにする */}
							<path class="side-neck-shape" d={fig.neckShape} />
							<path class="side-head" d={fig.headShape} />
							<path class="side-hair" d={fig.hair} />
							{/* 腕: 線（.side-upperarm・.side-arm）は位置のデータだけ持ち、見える形は太さが変わる台形（lib/arm-shape.ts） */}
							<line class="side-upperarm" x1={ax1} y1={ay1} x2={ax2} y2={ay2} />
							<line class="side-arm" x1={fx1} y1={fy1} x2={fx2} y2={fy2} />
							<path class="side-upperarm-shape" data-w1={fig.widths.arm.shoulder} data-w2={fig.widths.arm.elbowUpper} d={taper(ax1, ay1, ax2, ay2, fig.widths.arm.shoulder, fig.widths.arm.elbowUpper)} />
							<path class="side-forearm-shape" data-w1={fig.widths.arm.elbowFore} data-w2={fig.widths.arm.wrist} d={taper(fx1, fy1, fx2, fy2, fig.widths.arm.elbowFore, fig.widths.arm.wrist)} />
							<circle class="side-elbow" cx={ax2} cy={ay2} r={fig.widths.arm.elbowFore / 2} />
							{/* 腕と手は色を付けて、パドルの大きさと見比べられるようにする */}
							<line class="side-grip" stroke-width={fig.widths.grip} x1={gx1} y1={gy1} x2={gx2} y2={gy2} />
							<line class="side-paddle" stroke-width={fig.widths.face} x1={px1} y1={py1} x2={px2} y2={py2} />
							<circle class="side-hand" cx={fig.hand.cx} cy={fig.hand.cy} r={fig.hand.r} />
						</g>
					);
				})}
				<path class="side-trace" d="" />
				{/* 横から見た図でも、ボールが地面に触れた位置に、コートの図と同じ黄色い輪を同じタイミングで出す */}
				{lines.flatMap((l) =>
					[...(l.pre && !l.prePop ? [{ pt: l.pre, at: -1 }] : []), ...(l.bounces ?? [])].map((b) => (
						<g class:list={['bounce', 'side-bounce', { on: !animated }]} data-at={b.at < 0 ? undefined : b.at} data-pre-ring={b.at < 0 ? '' : undefined}>
							<circle cx={side.x0} cy={b.pt[1]} r={MARK} />
						</g>
					)),
				)}
				<circle class="side-ball" r="0.4" cx="-10" cy="-10" />
			</g>
		)
	}
	{
		// ボールは穴のあいたピックルボールとして描く（半径 1 の形を、アニメーションで位置と大きさに合わせて動かす）
		animated && (
			<g class="ball" transform="translate(-10 -10) scale(0.55)">
				<circle class="ball-body" cx="0" cy="0" r="1" />
				<circle class="hole" cx="0" cy="0" r="0.16" />
				<circle class="hole" cx="0.502" cy="0.290" r="0.14" />
				<circle class="hole" cx="0.000" cy="0.580" r="0.14" />
				<circle class="hole" cx="-0.502" cy="0.290" r="0.14" />
				<circle class="hole" cx="-0.502" cy="-0.290" r="0.14" />
				<circle class="hole" cx="-0.000" cy="-0.580" r="0.14" />
				<circle class="hole" cx="0.502" cy="-0.290" r="0.14" />
			</g>
		)
	}
</svg>
