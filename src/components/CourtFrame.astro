---
/**
 * コート図の1コマ分（コート・人・打球・名前）を描く。
 * Court.astro から、コマ割りの各コマとアニメーションの各場面の両方で使う。
 * スタイルは Court.astro の .court 配下（is:global）で当てる。
 */
import { COURT, zoneRects, type ZoneName } from '../config/court';

type Point = [number, number];
interface Figure {
	id: string;
	role: string;
	label?: string;
	x: number;
	y: number;
	shoulder: Point;
	hand: Point;
	tip: Point;
	/** 横から見た図で描くパドルの高さ（ft） */
	sideH?: number;
}
interface Line {
	type: string;
	from: string | Point;
	d: string;
	mid: Point;
	label?: string;
	bounces?: { pt: Point; at: number }[];
	/** アニメーションのボールの高さ（ft）の列 */
	heights?: string;
	/** アニメーションで飛ぶ（動く）時間（ミリ秒） */
	ms?: number;
	/** 打つ前に弾む位置（afterBounce） */
	pre?: Point;
	/** トラップして弾ませる球: 受けた高さ（ft）。ここから少し上がってから落ちる */
	preFromH?: number;
	/** 球出しの球（新しいボールを出す）。アニメーションの連続性を測るときに、ここでボールが跳ぶのは正しい */
	feed?: boolean;
	/** 動き出すまでの遅れ（ミリ秒）。相手の打球を見てから動く人 */
	delay?: number;
	/** 新しいボール（前の球で点が決まったあと、または球出し） */
	fresh?: boolean;
	/** ゲーム形式: この球で点を失った人の上（「失点」を出す位置） */
	lostAt?: Point;
	/** 人の動きで、体の中心が動く量（線の長さではなく、動く前と後の位置の差） */
	shift?: Point;
}
interface Props {
	figures: Figure[];
	lines: Line[];
	viewBox: string;
	zones: ZoneName[];
	fences?: [Point, Point][];
	uid: string;
	playerR: number;
	title: string;
	/** アニメーション用の場面として描く（ボールと data 属性を付ける） */
	animated?: boolean;
	/** 横から見た高さの帯（x0: 地面の線の x、k: 高さ 1ft あたりの長さ） */
	side?: { x0: number; k: number; width: number; top: number; bottom: number };
	step?: number;
	/** ゲーム形式の点: この手の前と後の点 */
	score?: { before: number; after: number };
	/** ゲーム形式: この手で勝ちの点に届いた人（「〇 の勝ち」を出す） */
	win?: string;
}
const { figures, lines, viewBox, zones, fences = [], uid, playerR, title, animated = false, side, step, score, win } = Astro.props;
const NET_FT = 2.9;
/** 横から見た図: ラインの位置で地面の線の色を変える長さ */
const GROUND_MARK = 0.6;
// 線を伸ばして見せるマスクの範囲。図の表示範囲（viewBox）に余白を足して、どこに引いた線も切れないようにする
const [vbX, vbY, vbW, vbH] = viewBox.split(/\s+/).map(Number);
const maskBox = { x: vbX - 10, y: vbY - 10, width: vbW + 20, height: vbH + 20 };
/**
 * 横から見た図の棒人間の寸法（ft）。大人の平均的な身長 170cm と、体の比率から決める。
 * 頭は実際の比率: 高さ（あご〜頭のてっぺん）が身長の約 1/7.5（約23cm）、前後の奥行きが約19cm の、縦に長い楕円。
 * 腕のつけ根（肩の関節）は身長の約 0.77（約131cm）。肩の骨の一番上（0.82）ではなく、腕が回る所に置き、首が見えるようにする。
 */
const STATURE_FT = 5.58;
const HEAD_FT = STATURE_FT / 7.5;
const HEAD_DEPTH_FT = 0.62;
/**
 * 太さ（ft。図では side.k 倍）: 胴は胸の厚み約24cm、首は約12cm、足は約14cm、腕は約8cm。
 * 胴の線は端が丸いので、丸みの分（太さの半分）だけ内側で止める
 */
const TORSO_W_FT = 0.78;
const NECK_W_FT = 0.4;
const LEG_W_FT = 0.45;
const ARM_W_FT = 0.27;
const TORSO_CAP_FT = (TORSO_W_FT / 2) * 0.8;
const CHIN_FT = STATURE_FT - HEAD_FT;
const SHOULDER_FT = STATURE_FT * 0.77;
/** 腰（股関節）・ひざ・足首の高さ（身長の約 0.53・0.285・0.04） */
const HIP_FT = STATURE_FT * 0.53;
const KNEE_FT = STATURE_FT * 0.285;
const ANKLE_FT = STATURE_FT * 0.04;
/** 肩から、パドルを握る手までの長さ（腕の長さ。身長の約 0.36） */
const ARM_FT = STATURE_FT * 0.36;
/**
 * パドルの寸法（ft）。長さはルールの上限が 17インチで、ふつうは約16インチ（約41cm）。
 * 握る手からパドルの面の真ん中までは約7.5インチ、手から先までは約13インチ
 */
const PADDLE_HAND_TO_FACE_FT = 7.5 / 12;
const PADDLE_HAND_TO_TIP_FT = 13 / 12;
const PADDLE_HAND_TO_BUTT_FT = 3 / 12;
/**
 * 構え（ピックルボールのよい姿勢）: 上体はほぼ起こしたまま、ひざを少し曲げて腰を落とす。
 * いつも READY_KNEE_FT だけ腰を落とし、低い球では、上体を少しだけ前に倒し（MAX_LEAN まで）、ひざをもう少し曲げる
 * （合わせて MAX_CROUCH_FT まで）。それでも届かない分は、腕とパドルを伸ばして届かせる（前かがみやしゃがみ込みはしない）
 */
const READY_KNEE_FT = 0.12;
const MAX_LEAN = (12 * Math.PI) / 180;
const MAX_CROUCH_FT = 0.35;
/**
 * スニーカーの形（足首の真下を 0 として、奥行き ft・高さ ft の点。奥行きはネットの側が +）。
 * 長さ約27cm、かかとの上（はき口）が少し高く、つま先は丸く低い
 */
const SNEAKER: [number, number][] = [
	[-0.26, 0.03], [0.55, 0.03], [0.64, 0.06], [0.66, 0.12], [0.6, 0.17], [0.42, 0.21], [0.2, 0.3], [0.05, 0.36], [-0.17, 0.36], [-0.24, 0.3], [-0.27, 0.15],
];
/** 弾んだ位置の輪の半径（控えめに小さく） */
const MARK = 0.45;
/** 練習役の二重丸: 内側の線を、体の丸のふちから何 ft 内側に引くか */
const INNER_RING_INSET = 0.25;
/**
 * 人の外側の暗い縁。白い線（キッチンラインなど）と人の丸の境目を分かるようにする。
 * 縁を足しても人が大きく見えないよう、丸を BODY_SHRINK だけ小さくし、縁の外側が元の丸の大きさに収まるようにする
 * （縁の線の太さは court.css の .halo、0.4）
 */
const BODY_SHRINK = 0.3;
const HALO_R = BODY_SHRINK - 0.1;
/** 柵の支柱の大きさと間隔（ft） */
const FENCE_POST = 0.5;
const FENCE_POST_GAP = 1.6;
const k1 = COURT.net - COURT.kitchen;
const k2 = COURT.net + COURT.kitchen;
const isSub = (t: string) => t === 'move';
---

<svg
	viewBox={viewBox}
	role="img"
	aria-label={title}
	class:list={['court-svg', { frame: animated }]}
	data-step={step}
	data-score-before={score?.before}
	data-score-after={score?.after}
	data-side-x0={side?.x0}
	data-side-k={side?.k}
	data-side-max={side ? side.width / side.k : undefined}
>
	<defs>
		<marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto-start-reverse">
			<path d="M0 0 L10 5 L0 10 z" class="arrowhead" />
		</marker>
		<marker id={`${uid}-arrow-sub`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto-start-reverse">
			<path d="M0 0 L10 5 L0 10 z" class="arrowhead sub" />
		</marker>
	</defs>

	{/* コートの外まわり（ベースラインの後ろなど）も地面として塗る。人がコートの外に立っても、ページの背景に溶けないようにする */}
	<rect class="apron" x={vbX} y={vbY} width={side ? side.x0 - 0.9 - vbX : vbW} height={vbH} rx="0.6" />
	<rect class="surface" x="0" y="0" width={COURT.width} height={COURT.length} />
	<rect class="kitchen" x="0" y={k1} width={COURT.width} height={COURT.kitchen * 2} />
	{
		zones.map((z) => {
			const [x, y, w, h] = zoneRects[z];
			return <rect class="zone" x={x} y={y} width={w} height={h} />;
		})
	}
	<g class="lines">
		<rect x="0" y="0" width={COURT.width} height={COURT.length} />
		<line x1="0" y1={k1} x2={COURT.width} y2={k1} />
		<line x1="0" y1={k2} x2={COURT.width} y2={k2} />
		<line x1={COURT.width / 2} y1="0" x2={COURT.width / 2} y2={k1} />
		<line x1={COURT.width / 2} y1={k2} x2={COURT.width / 2} y2={COURT.length} />
	</g>
	<line class="net" x1="-1" y1={COURT.net} x2={COURT.width + 1} y2={COURT.net} />
	{
		// 柵: 細い横木と、一定の間隔の支柱で描く（打球の線と見分けられるよう、色も形も変える）
		fences.map(([a, b]) => {
			const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
			const n = Math.max(1, Math.round(len / FENCE_POST_GAP));
			const posts = Array.from({ length: n + 1 }, (_, i) => [a[0] + ((b[0] - a[0]) * i) / n, a[1] + ((b[1] - a[1]) * i) / n]);
			return (
				<g class="fence">
					<line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />
					{posts.map(([x, y]) => (
						<rect x={x - FENCE_POST / 2} y={y - FENCE_POST / 2} width={FENCE_POST} height={FENCE_POST} rx="0.06" />
					))}
				</g>
			);
		})
	}

	{
		lines.map((l, i) => {
			// アニメーションでは、線（点線・破線を含む）をマスクで少しずつ見せて「伸びる」ように描く
			const reveal = animated && l.type !== 'move';
			return (
				<>
					{reveal && (
						<mask id={`${uid}-m${i}`} maskUnits="userSpaceOnUse" x={maskBox.x} y={maskBox.y} width={maskBox.width} height={maskBox.height}>
							<path class="reveal" d={l.d} data-i={i} fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
						</mask>
					)}
					<path
						class:list={['shot', `t-${l.type}`, { sub: isSub(l.type) }]}
						d={l.d}
						marker-end={`url(#${uid}-${isSub(l.type) ? 'arrow-sub' : 'arrow'})`}
						mask={reveal ? `url(#${uid}-m${i})` : undefined}
						data-i={i}
						data-kind={animated ? (l.type === 'move' ? 'move' : 'ball') : undefined}
						data-player={animated && l.type === 'move' && typeof l.from === 'string' ? l.from : undefined}
						data-hitter={animated && l.type !== 'move' && typeof l.from === 'string' ? l.from : undefined}
						data-shift={animated && l.shift ? l.shift.join(',') : undefined}
						data-ms={animated ? l.ms : undefined}
						data-pre={animated && l.pre ? `${l.pre[0]},${l.pre[1]}` : undefined}
						data-pre-from-h={animated && l.preFromH !== undefined ? l.preFromH : undefined}
						data-fresh={animated && l.type !== 'move' && (l.feed || l.fresh || (l.pre && l.preFromH === undefined)) ? '' : undefined}
						data-delay={animated && l.delay ? l.delay : undefined}
						data-h={animated ? l.heights : undefined}
					/>
				</>
			);
		})
	}

	{
		lines.flatMap((l) => [
			// 打つ前に弾む位置（その手の始まりに出す）
			...(l.pre
				? [
						<g class:list={['bounce', { on: !animated }]} data-pre-ring>
							<circle cx={l.pre[0]} cy={l.pre[1]} r={MARK} />
						</g>,
					]
				: []),
			...(l.bounces ?? []).map((b) => (
				<g class:list={['bounce', { on: !animated }]} data-at={b.at}>
					<circle cx={b.pt[0]} cy={b.pt[1]} r={MARK} />
				</g>
			)),
		])
	}

	{
		figures.map((p) => (
			<g class={`player role-${p.role}`} data-player-id={animated ? p.id : undefined}>
				<line class="arm" x1={p.shoulder[0]} y1={p.shoulder[1]} x2={p.hand[0]} y2={p.hand[1]} />
				<line class="paddle" x1={p.hand[0]} y1={p.hand[1]} x2={p.tip[0]} y2={p.tip[1]} />
				<circle class="halo" cx={p.x} cy={p.y} r={playerR - HALO_R} />
				<circle class="body" cx={p.x} cy={p.y} r={playerR - BODY_SHRINK} />
				{/* 練習する人（練習役）は、丸の内側に線を入れて二重丸にする（外に足すと人が大きく見えるため）。2人とも練習するときは2人とも */}
				{p.role === 'practice' && <circle class="inner-ring" cx={p.x} cy={p.y} r={playerR - BODY_SHRINK - INNER_RING_INSET} />}
				<text x={p.x} y={p.y}>
					{p.label ?? p.id}
				</text>
			</g>
		))
	}

	{
		lines.map(
			(l) =>
				l.label && (
					<text class="shot-label" x={l.mid[0]} y={l.mid[1]}>
						{l.label}
					</text>
				),
		)
	}
	{
		/* ゲーム形式: 勝ちの点に届いた手では、コートの真ん中に「〇 の勝ち」。アニメーションでは手が終わったときにポンと出す */
		win && (
			<text class:list={['win-label', { on: !animated }]} x={COURT.width / 2} y={COURT.net} data-win>
				{win} の勝ち
			</text>
		)
	}
	{
		/* ゲーム形式: 点を失った人の上に「失点」。アニメーションでは、その手が終わったときにふわっと出す */
		lines.map(
			(l) =>
				l.lostAt && (
					<text class:list={['lost-label', { on: !animated }]} x={l.lostAt[0]} y={l.lostAt[1]} data-lost>
						失点
					</text>
				),
		)
	}

	{
		// 横から見た高さ: 縦の線が地面、右へ行くほど高い。ネットの高さと、ボールの通り道（高さの変化）を描く
		side && (
			<g class="side">
				<rect class="side-panel" x={side.x0 - 0.7} y={side.top + 0.3} width={side.width + 1} height={side.bottom - side.top - 0.6} rx="0.6" />
				<text class="side-title" x={side.x0 + side.width / 2 - 0.3} y={side.top + 1.4}>横から見た高さ</text>
				{/* 地面の線（補助の図なので1色）。ベースラインとキッチンラインの位置だけ、同じ太さのまま色を変える */}
				<line class="side-ground" x1={side.x0} y1={side.top + 2.2} x2={side.x0} y2={side.bottom - 0.6} />
				{[0, k1, k2, COURT.length]
					.filter((y) => y > side.top + 2.2 && y < side.bottom - 0.6)
					.map((y) => (
						<line class="side-ground side-mark" x1={side.x0} y1={y - GROUND_MARK / 2} x2={side.x0} y2={y + GROUND_MARK / 2} />
					))}
				<line class="side-net" x1={side.x0} y1={COURT.net} x2={side.x0 + NET_FT * side.k} y2={COURT.net} />
				{figures.map((p) => {
					// 棒人間は、高さ（ft）と奥行き（ft）で組み立ててから、図の座標（高さは side.k 倍）に直す
					const toNet = p.y < COURT.net ? 1 : -1;
					const X = (h: number) => side.x0 + h * side.k;
					const hitH = p.sideH ?? 4;
					const faceY = (p.hand[1] + p.tip[1]) / 2;
					const dy = Math.abs(faceY - p.y);
					// 構えと届き方: 少しひざを曲げ、低い球では上体を前に倒し、それでも届かなければさらにひざを曲げる
					const reach = ARM_FT + PADDLE_HAND_TO_FACE_FT;
					const torso = SHOULDER_FT - HIP_FT;
					// 図では高さの向きだけ side.k 倍に縮めているので、体の前後のずれ（奥行き）も同じだけ縮めて、形がゆがまないようにする
					const K = side.k;
					const shoulderAt = (drop: number, lean: number) => ({
						h: HIP_FT - drop + torso * Math.cos(lean),
						d: p.y + toNet * K * torso * Math.sin(lean),
					});
					const reaches = (drop: number, lean: number) => {
						const sh = shoulderAt(drop, lean);
						return Math.hypot(hitH - sh.h, faceY - sh.d) <= reach;
					};
					let drop = READY_KNEE_FT;
					let lean = 0;
					while (lean < MAX_LEAN && !reaches(drop, lean)) lean += Math.PI / 180;
					while (drop < MAX_CROUCH_FT && !reaches(drop, lean)) drop += 0.02;
					const sh = shoulderAt(drop, lean);
					const hipH = HIP_FT - drop;
					// 首と頭は上体と同じ向きに傾ける
					const neck = (CHIN_FT - SHOULDER_FT);
					const chin = { h: sh.h + neck * Math.cos(lean), d: sh.d + toNet * K * neck * Math.sin(lean) };
					const headC = { h: chin.h + (HEAD_FT / 2) * Math.cos(lean), d: chin.d + toNet * K * (HEAD_FT / 2) * Math.sin(lean) };
					// ひざ: 腰と足首を結ぶ線の真ん中から、ネットの側へ出す（太ももとすねの長さは変えない）
					const thigh = HIP_FT - KNEE_FT;
					const legSpan = hipH - ANKLE_FT;
					const kneeFwd = K * Math.sqrt(Math.max(0, thigh * thigh - (legSpan / 2) ** 2));
					const kneeH = ANKLE_FT + legSpan / 2;
					// 腕とパドル: 肩からパドルの面の真ん中へ向かって伸ばし、パドルは腕の延長に持つ
					// （低い球ではヘッドが下がり、高い球では上がる）
					const vh = hitH - sh.h;
					const vd = faceY - sh.d;
					const vl = Math.hypot(vh, vd) || 1;
					const [uh, ud] = [vh / vl, vd / vl];
					const handH = hitH - uh * PADDLE_HAND_TO_FACE_FT;
					const handD = faceY - ud * PADDLE_HAND_TO_FACE_FT;
					const butt = [X(handH - uh * PADDLE_HAND_TO_BUTT_FT), handD - ud * PADDLE_HAND_TO_BUTT_FT];
					const tip = [X(handH + uh * PADDLE_HAND_TO_TIP_FT), handD + ud * PADDLE_HAND_TO_TIP_FT];
					// 頭は縦に長い楕円。高さの向き（図の横）は縮めずに、実際の縦横の比で描く
					const rotDeg = (toNet * lean * 180) / Math.PI;
					const shoe = SNEAKER.map(([d, h]) => `${X(h)},${p.y + toNet * K * d}`).join(" ");
					return (
						<g class={`side-person role-${p.role}`} data-side-player={animated ? p.id : undefined}>
							{/* スニーカー、足（足首〜ひざ〜腰）、胴（腰〜肩、前に倒す）、首、頭、腕（肩〜手）、パドル */}
							<polygon class="side-shoe" points={shoe} />
							<polyline class="side-leg" stroke-width={LEG_W_FT * K} points={`${X(ANKLE_FT)},${p.y} ${X(kneeH)},${p.y + toNet * kneeFwd} ${X(hipH)},${p.y}`} />
							{/* 胴は太く（胸の厚み約24cm）、首は細く描き、胴の上の端が肩（腕のつけ根）だと分かるようにする */}
							<line class="side-torso" stroke-width={TORSO_W_FT * K} x1={X(hipH + TORSO_CAP_FT)} y1={p.y} x2={X(sh.h - TORSO_CAP_FT)} y2={sh.d} />
							<line class="side-neck" stroke-width={NECK_W_FT * K} x1={X(sh.h)} y1={sh.d} x2={X(chin.h)} y2={chin.d} />
							<ellipse class="side-head" cx={X(headC.h)} cy={headC.d} rx={(HEAD_FT / 2) * K} ry={(HEAD_DEPTH_FT / 2) * K} transform={`rotate(${rotDeg} ${X(headC.h)} ${headC.d})`} />
							<line class="side-arm" stroke-width={ARM_W_FT * K} x1={X(sh.h)} y1={sh.d} x2={X(handH)} y2={handD} />
							<line class="side-paddle" x1={butt[0]} y1={butt[1]} x2={tip[0]} y2={tip[1]} />
						</g>
					);
				})}
				<path class="side-trace" d="" />
				{/* 横から見た図でも、ボールが地面に触れた位置に、コートの図と同じ黄色い輪を同じタイミングで出す */}
				{lines.flatMap((l) =>
					[...(l.pre ? [{ pt: l.pre, at: -1 }] : []), ...(l.bounces ?? [])].map((b) => (
						<g class:list={['bounce', 'side-bounce', { on: !animated }]} data-at={b.at < 0 ? undefined : b.at} data-pre-ring={b.at < 0 ? '' : undefined}>
							<circle cx={side.x0} cy={b.pt[1]} r={MARK} />
						</g>
					)),
				)}
				<circle class="side-ball" r="0.4" cx="-10" cy="-10" />
			</g>
		)
	}
	{
		// ボールは穴のあいたピックルボールとして描く（半径 1 の形を、アニメーションで位置と大きさに合わせて動かす）
		animated && (
			<g class="ball" transform="translate(-10 -10) scale(0.55)">
				<circle class="ball-body" cx="0" cy="0" r="1" />
				<circle class="hole" cx="0" cy="0" r="0.16" />
				<circle class="hole" cx="0.502" cy="0.290" r="0.14" />
				<circle class="hole" cx="0.000" cy="0.580" r="0.14" />
				<circle class="hole" cx="-0.502" cy="0.290" r="0.14" />
				<circle class="hole" cx="-0.502" cy="-0.290" r="0.14" />
				<circle class="hole" cx="-0.000" cy="-0.580" r="0.14" />
				<circle class="hole" cx="0.502" cy="-0.290" r="0.14" />
			</g>
		)
	}
</svg>
