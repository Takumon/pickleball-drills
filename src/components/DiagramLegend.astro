---
/**
 * 「図の見方」ページ用の凡例。打球の線・人の描き方を、実際の図と同じスタイル（styles/court.css）で描く。
 */
import { heightLevels, roleLabels, shotHeights, shotLabels, shotSpeedKmh, shotSwing, type Role, type ShotType } from '../config/court';
import { sideFigure } from '../lib/side-figure';
import '../styles/court.css';

const order: ShotType[] = ['speedup', 'smash', 'punch', 'drive', 'roll', 'block', 'serve', 'return', 'reset', 'dink', 'drop', 'volleyDink', 'lob', 'move'];
/** 線の形と太さ（styles/court.css の .t-* と合わせる） */
const style: Record<ShotType, string> = {
	speedup: '実線',
	smash: '実線',
	punch: '実線',
	roll: '実線',
	block: '実線',
	volleyDink: '点線',
	drive: '実線',
	serve: '実線',
	return: '実線',
	reset: '点線',
	dink: '点線',
	drop: '点線',
	lob: '破線',
	move: '灰色の点線',
};
const width: Record<ShotType, string> = {
	speedup: '太い',
	smash: '太い',
	punch: '太い',
	roll: 'ふつう',
	block: 'ふつう',
	volleyDink: '細い',
	drive: '太い',
	serve: 'ふつう',
	return: 'ふつう',
	lob: 'ふつう',
	reset: '細い',
	dink: '細い',
	drop: '細い',
	move: '細い',
};
const isSub = (t: ShotType) => t === 'move';
const roles = Object.keys(roleLabels) as Role[];
/** 見本の線（上から見た図の線はまっすぐ） */
const samplePath = (_t: ShotType) => `M1.2 2 L12.4 2`;
/** 速さの目安（実際の球速。アニメーションは同じ比のままゆっくり再生する） */
const speed = (t: ShotType) => `時速 約${shotSpeedKmh[t]}km`;

/**
 * 打ち方ごとの、横から見た図の構えとパドルの動き。実際の図と同じ組み立て（lib/side-figure.ts）で、打つ高さ（shotHeights）の構えを描き、
 * 打つ動き（shotSwing）の向きを矢印で示す。図は人が立った向き（上が上）に回して描く
 */
const strokeOrder = order.filter((t): t is Exclude<ShotType, 'move'> => t !== 'move');
const strokes = strokeOrder.map((t) => {
	const hitH = heightLevels[shotHeights[t].hit].ft;
	const fig = sideFigure({ x0: 0, k: 1, y: 0, toNet: 1, hitH, faceY: 1.4 });
	const sw = shotSwing[t];
	// 矢印: 振りかぶった所から、打つ所を通って、振り抜いた所まで（立った向きの図では、右 = 前、上 = 上）
	const pt = ([up, fwd]: [number, number]) => `${1.4 + fwd},${-hitH - up}`;
	const arrow = `${pt(sw.back)} ${pt([0, 0])} ${pt(sw.follow)}`;
	return { t, hitH, fig, sw, arrow, level: heightLevels[shotHeights[t].hit].label };
});
---

<div class="court legend-page">
	<h2>打球の線</h2>
	<p>強く速い球は太い実線、柔らかく落とす球は細い点線、ロブは破線で描きます。人の移動は灰色の点線です。</p>
	<p>球出しの線は出す球の種類で描き、「球出し（ディンク）」のように名前を付けます。</p>
	<p>表の速さは実際の球速の目安です。アニメーションでは、同じ種類の球は距離によらず同じ速さで飛びます。目で追えるように、どの球も同じ割合でゆっくり再生しています。</p>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>名前</th><th>線</th><th>太さ</th><th>速さ</th></tr>
		</thead>
		<tbody>
			{
				order.map((t) => (
					<tr>
						<td>
							<svg class="court-svg sample" viewBox="0 0 14 4" aria-hidden="true">
								<defs>
									<marker id={`lg-${t}`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto-start-reverse">
										<path d="M0 0 L10 5 L0 10 z" class:list={['arrowhead', { sub: isSub(t) }]} />
									</marker>
								</defs>
								<rect class="surface" x="0" y="0" width="14" height="4" rx="0.6" />
								<path
									class:list={['shot', `t-${t}`, { sub: isSub(t) }]}
									d={samplePath(t)}
									marker-end={`url(#lg-${t})`}
								/>
							</svg>
						</td>
						<td>{t === 'move' ? '移動' : shotLabels[t]}</td>
						<td>{style[t]}</td>
						<td>{width[t]}</td>
						<td>{speed(t)}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>ボールの高さとバウンド</h2>
	<p>アニメーションでは、ボールは打球の線の上を進み、打つ人と受ける人のパドルの位置を通ります。図の右の淡い帯「横から見た高さ」は、同じ場面を横から見た補助の図です。縦の線が地面、短い横線がネットの高さで、ボールが右にあるほど高い球です。人は地面から右へのびる線で描き、パドルはその人が打つ（受ける）高さに描きます。地面の線で色が薄くなっているところが、ベースラインとキッチンラインの位置です。</p>
	<p>帯のボールが地面の線に触れたところがバウンドです。そのとき、コートの図と帯の両方に、同じ黄色い輪が同時に出ます。輪のない球はノーバウンドで打ちます。手から一度弾ませてから打つ球出しは、手から落としたボールが体の前で弾み（輪が出ます）、打点まで上がってから飛んでいきます。</p>
	<table class="legend-table">
		<thead>
			<tr><th>高さ</th><th>目安</th></tr>
		</thead>
		<tbody>
			{
				Object.values(heightLevels)
					.toReversed()
					.map((l) => (
						<tr>
							<td>{l.label}</td>
							<td>{l.note}</td>
						</tr>
					))
			}
		</tbody>
	</table>

	<h2>人</h2>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>役割</th></tr>
		</thead>
		<tbody>
			{
				roles.map((r) => (
					<tr>
						<td>
							<svg class="court-svg sample person" viewBox="0 0 8 7" aria-hidden="true">
								<rect class="surface" x="0" y="0" width="8" height="7" rx="0.6" />
								<g class={`player role-${r}`}>
									<line class="arm" x1="4.9" y1="4.1" x2="5.55" y2="3.45" />
									<line class="paddle" x1="5.55" y1="3.45" x2="6.05" y2="3" />
									<circle class="body" cx="4" cy="4.6" r="1.3" />
									{r === 'practice' && <circle class="inner-ring" cx="4" cy="4.6" r="1.05" />}
									<text x="4" y="4.6">A</text>
								</g>
							</svg>
						</td>
						<td>{roleLabels[r]}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>横から見た図の構えとパドルの動き</h2>
	<p>横から見た図の人は、打つ球の種類ごとに、打つ高さの構えで描きます。相手の球が飛んでくる間に振りかぶり、打つときは矢印のように、振りかぶった所から打つ所を通って振り抜き、元の構えに戻ります。黄色い丸がボールの位置（打つ高さ）で、右がネットの側です。動きは、ピックルボールのコーチの記事や動画の説明を調べて決めました。</p>
	<p>パドルは、腰より下では腕の延長でヘッドが下がり、腰より上では高くなるほどヘッドが上を向きます。上体はほぼ起こしたまま、ひざを少し曲げた構えで、低い球ほどひざを少し深く曲げます。</p>
	<div class="stroke-grid">
		{
			strokes.map(({ t, hitH, fig, sw, arrow, level }) => (
				<figure class="stroke-card" data-stroke data-swing={[...sw.back, ...sw.follow].join(',')}>
					<svg class="court-svg stroke" viewBox="-1.4 -10 5 10.6" aria-hidden="true">
						<defs>
							<marker id={`sw-${t}`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="0.8" markerHeight="0.8" orient="auto">
								<path d="M0 0 L10 5 L0 10 z" class="swing-head" />
							</marker>
						</defs>
						<line class="side-ground" x1="-1.4" y1="0" x2="3.6" y2="0" />
						<g class="side-person" transform="matrix(0,-1,1,0,0,0)">
							<polygon class="side-shoe" points={fig.shoe} />
							<polyline class="side-leg" stroke-width={fig.widths.leg} points={fig.leg} />
							<path class="side-torso" d={fig.torso} />
							<circle class="side-hip" cx={fig.hip.cx} cy={fig.hip.cy} r={fig.hip.r} />
							<line class="side-neck" stroke-width={fig.widths.neck} x1={fig.neck[0]} y1={fig.neck[1]} x2={fig.neck[2]} y2={fig.neck[3]} />
							<ellipse class="side-head" cx={fig.head.cx} cy={fig.head.cy} rx={fig.head.rx} ry={fig.head.ry} transform={`rotate(${fig.head.rot} ${fig.head.cx} ${fig.head.cy})`} />
							<line class="side-upperarm" stroke-width={fig.widths.upperArm} x1={fig.upperArm[0]} y1={fig.upperArm[1]} x2={fig.upperArm[2]} y2={fig.upperArm[3]} />
							<line class="side-arm" stroke-width={fig.widths.forearm} x1={fig.forearm[0]} y1={fig.forearm[1]} x2={fig.forearm[2]} y2={fig.forearm[3]} />
							<line class="side-grip" stroke-width={fig.widths.grip} x1={fig.grip[0]} y1={fig.grip[1]} x2={fig.grip[2]} y2={fig.grip[3]} />
							<line class="side-paddle" stroke-width={fig.widths.face} x1={fig.face[0]} y1={fig.face[1]} x2={fig.face[2]} y2={fig.face[3]} />
							<circle class="side-hand" cx={fig.hand.cx} cy={fig.hand.cy} r={fig.hand.r} />
						</g>
						<circle class="stroke-ball" cx="1.4" cy={-hitH} r="0.22" data-cx="1.4" data-cy={-hitH} />
						<polyline class="swing-arrow" points={arrow} marker-end={`url(#sw-${t})`} />
					</svg>
					<figcaption>
						<b>{shotLabels[t]}</b>
						<span>{level}（{hitH}ft）</span>
						<span>{sw.note}</span>
					</figcaption>
				</figure>
			))
		}
	</div>
</div>

<script>
	/**
	 * 打ち方の一覧を動かす: 振りかぶった所から、打つ所を通って振り抜き、元の構えに戻る。パドルが打つ所を通る瞬間に、
	 * ボールが振り抜く向きへ飛んでいく。値は実際のアニメーションと同じ shotSwing（data-swing）。「視差効果を減らす」設定では動かさない
	 */
	const PREP_MS = 450;
	const SWING_MS = 300;
	const RETURN_MS = 450;
	const PERIOD_MS = 2200;
	const BALL_MS = 650;
	const ease = (u: number) => (u < 0.5 ? 2 * u * u : 1 - (-2 * u + 2) ** 2 / 2);
	const lerp = (p: number[], q: number[], t: number) => [p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t];
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const cards = [...document.querySelectorAll<HTMLElement>('[data-stroke]')].map((card) => {
			const v = (card.dataset.swing ?? '0,0,0,0').split(',').map(Number);
			const back = [v[0], v[1]];
			const follow = [v[2], v[3]];
			const lb = Math.hypot(back[0], back[1]);
			const lf = Math.hypot(follow[0], follow[1]);
			const forearm = card.querySelector<SVGLineElement>('.side-arm')!;
			const upper = card.querySelector<SVGLineElement>('.side-upperarm')!;
			const ball = card.querySelector<SVGCircleElement>('.stroke-ball')!;
			const num = (el: Element, a: string) => Number(el.getAttribute(a));
			return {
				moving: [...card.querySelectorAll<SVGElement>('.side-paddle, .side-grip, .side-hand')],
				forearm,
				upper,
				f: [num(forearm, 'x1'), num(forearm, 'y1'), num(forearm, 'x2'), num(forearm, 'y2')],
				u2: [num(upper, 'x2'), num(upper, 'y2')],
				ball,
				b: [Number(ball.dataset.cx), Number(ball.dataset.cy)],
				back,
				follow,
				contact: lb + lf > 0 ? lb / (lb + lf) : 0,
				dir: lf > 0 ? [follow[0] / lf, follow[1] / lf] : [0, 1],
			};
		});
		const tick = (now: number) => {
			const t = now % PERIOD_MS;
			for (const c of cards) {
				// ずれ [上, 前]: 振りかぶる → 振る → 戻る
				let off = [0, 0];
				if (t < PREP_MS) off = lerp([0, 0], c.back, ease(t / PREP_MS));
				else if (t < PREP_MS + SWING_MS) off = lerp(c.back, c.follow, ease((t - PREP_MS) / SWING_MS));
				else if (t < PREP_MS + SWING_MS + RETURN_MS) off = lerp(c.follow, [0, 0], ease((t - PREP_MS - SWING_MS) / RETURN_MS));
				// 人の図は高さ（x）と前後（y）で描いて回してあるので、上へ = x、前へ = y に動かす
				const [dx, dy] = off;
				c.moving.forEach((el) => el.setAttribute('transform', dx || dy ? `translate(${dx} ${dy})` : ''));
				c.forearm.setAttribute('x1', String(c.f[0] + dx / 2));
				c.forearm.setAttribute('y1', String(c.f[1] + dy / 2));
				c.forearm.setAttribute('x2', String(c.f[2] + dx));
				c.forearm.setAttribute('y2', String(c.f[3] + dy));
				c.upper.setAttribute('x2', String(c.u2[0] + dx / 2));
				c.upper.setAttribute('y2', String(c.u2[1] + dy / 2));
				// ボール: パドルが打つ所を通る瞬間から、振り抜く向きへ飛び、消える。次の振りかぶりの前に打つ所へ戻る
				const hit = PREP_MS + c.contact * SWING_MS;
				const fly = (t - hit) / BALL_MS;
				if (fly >= 0 && fly <= 1) {
					c.ball.setAttribute('cx', String(c.b[0] + c.dir[1] * 2.4 * fly));
					c.ball.setAttribute('cy', String(c.b[1] - c.dir[0] * 2.4 * fly));
					c.ball.style.opacity = String(1 - fly * 0.85);
				} else {
					c.ball.setAttribute('cx', String(c.b[0]));
					c.ball.setAttribute('cy', String(c.b[1]));
					c.ball.style.opacity = fly > 1 ? '0' : '1';
				}
			}
			requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}
</script>

<style>
	.legend-page {
		max-width: none;
		margin: 0;
	}
	/* 6列あるので、スマホでも収まるよう文字と余白を小さめにする */
	.legend-page .legend-table {
		font-size: 0.85rem;
	}
	.legend-page .legend-table th,
	.legend-page .legend-table td {
		padding: 0.45rem 0.35rem;
	}
	.legend-table td {
		vertical-align: middle;
	}
	/* 太さ・速さは短い値なので折り返さない */
	.legend-table td:nth-child(4),
	.legend-table td:nth-child(5) {
		white-space: nowrap;
	}
	.legend-page svg.sample {
		width: 3.6rem;
		min-width: 3.6rem;
		height: auto;
		display: block;
	}
	.legend-page svg.sample.person {
		width: 3.5rem;
		min-width: 3.5rem;
	}
	/* 打ち方ごとの構え: スマホでは3列、広い画面では4列以上に並べる */
	.legend-page .stroke-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(6.4rem, 1fr));
		gap: 0.75rem;
	}
	.legend-page .stroke-card {
		margin: 0;
		padding: 0.35rem;
		border-radius: 0.5rem;
		background: var(--side-panel);
	}
	.legend-page svg.stroke {
		width: 100%;
		height: auto;
		display: block;
	}
	.legend-page .stroke-card figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		font-size: 0.75rem;
		line-height: 1.35;
		margin-top: 0.3rem;
	}
	.legend-page .stroke-ball {
		fill: var(--ball, #facc15);
	}
	.legend-page .swing-arrow {
		fill: none;
		stroke: var(--side-ink);
		stroke-width: 0.09;
		stroke-dasharray: 0.18 0.12;
	}
	.legend-page .swing-head {
		fill: var(--side-ink);
	}
	/* 一覧では人を見本として見せるので、実際の図より濃く描く */
	.legend-page .stroke-card .side-person {
		opacity: 0.9;
	}
</style>
