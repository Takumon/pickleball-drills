---
/**
 * 「図の見方」ページ用の凡例。打球の線・人の描き方を、実際の図と同じスタイル（styles/court.css）で描く。
 */
import { heightLevels, roleLabels, shotLabels, shotDurationMs, shotCurve, type Role, type ShotType } from '../config/court';
import '../styles/court.css';

const order: ShotType[] = ['speedup', 'smash', 'volley', 'drive', 'serve', 'return', 'reset', 'dink', 'drop', 'lob', 'move'];
/** 線の形と太さ（styles/court.css の .t-* と合わせる） */
const style: Record<ShotType, string> = {
	speedup: '実線',
	smash: '実線',
	volley: '実線',
	drive: '実線',
	serve: '実線',
	return: '実線',
	reset: '点線',
	dink: '点線',
	drop: '点線',
	lob: '破線',
	move: '灰色の点線',
};
const width: Record<ShotType, string> = {
	speedup: '太い',
	smash: '太い',
	volley: '太い',
	drive: '太い',
	serve: 'ふつう',
	return: 'ふつう',
	lob: 'ふつう',
	reset: '細い',
	dink: '細い',
	drop: '細い',
	move: '細い',
};
const isSub = (t: ShotType) => t === 'move';
const roles = Object.keys(roleLabels) as Role[];
/** 見本の線。弧の大きさは実際の図と同じ shotCurve を使う */
const samplePath = (t: ShotType) => `M1.2 2.9 Q6.8 ${(2.9 - 11.2 * shotCurve[t]).toFixed(2)} 12.4 2.9`;
/** 弧の大きさを言葉にする（shotCurve の値から） */
const arcLabel = (c: number) => (c <= 0 ? 'なし' : c < 0.08 ? 'ごくわずか' : c < 0.13 ? '小さい' : c < 0.2 ? 'やや大きい' : '大きい');
const sec = (ms: number) => `${(ms / 1000).toFixed(2).replace(/0$/, '')}秒`;
---

<div class="court legend-page">
	<h2>打球の線</h2>
	<p>強く速い球は太い実線、柔らかく落とす球は細い点線、ロブは破線で描きます。人の移動は灰色の点線です。弧が大きいほど、山なりの球です。</p>
	<p>球出しの線は出す球の種類で描き、「球出し（ディンク）」のように名前を付けます。</p>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>名前</th><th>線</th><th>太さ</th><th>弧</th><th>速さ</th></tr>
		</thead>
		<tbody>
			{
				order.map((t) => (
					<tr>
						<td>
							<svg class="court-svg sample" viewBox="0 0 14 4" aria-hidden="true">
								<defs>
									<marker id={`lg-${t}`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto-start-reverse">
										<path d="M0 0 L10 5 L0 10 z" class:list={['arrowhead', { sub: isSub(t) }]} />
									</marker>
								</defs>
								<rect class="surface" x="0" y="0" width="14" height="4" rx="0.6" />
								<path
									class:list={['shot', `t-${t}`, { sub: isSub(t) }]}
									d={samplePath(t)}
									marker-end={`url(#lg-${t})`}
								/>
							</svg>
						</td>
						<td>{t === 'move' ? '移動' : shotLabels[t]}</td>
						<td>{style[t]}</td>
						<td>{width[t]}</td>
						<td>{arcLabel(shotCurve[t])}</td>
						<td>{sec(shotDurationMs[t])}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>ボールの高さとバウンド</h2>
	<p>アニメーションでは、ボールは打球の線の上を進み、打つ人と受ける人のパドルの位置を通ります。図の右の「高さ」の帯は同じボールを横から見たものです。帯の縦の線が地面、短い横線がネットの高さで、ボールが右にあるほど高い球です。</p>
	<p>帯のボールが地面の線に触れたところがバウンドです。コートの図ではそこに黄色い輪を描きます。輪のない球はノーバウンドで打ちます。</p>
	<table class="legend-table">
		<thead>
			<tr><th>高さ</th><th>目安</th></tr>
		</thead>
		<tbody>
			{
				Object.values(heightLevels)
					.toReversed()
					.map((l) => (
						<tr>
							<td>{l.label}</td>
							<td>{l.note}</td>
						</tr>
					))
			}
		</tbody>
	</table>

	<h2>人</h2>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>役割</th></tr>
		</thead>
		<tbody>
			{
				roles.map((r) => (
					<tr>
						<td>
							<svg class="court-svg sample person" viewBox="0 0 8 7" aria-hidden="true">
								<rect class="surface" x="0" y="0" width="8" height="7" rx="0.6" />
								<g class={`player role-${r}`}>
									<line class="arm" x1="4.9" y1="4.1" x2="5.55" y2="3.45" />
									<line class="paddle" x1="5.55" y1="3.45" x2="6.05" y2="3" />
									<circle class="body" cx="4" cy="4.6" r="1.3" />
									<text x="4" y="4.6">A</text>
								</g>
							</svg>
						</td>
						<td>{roleLabels[r]}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.legend-page {
		max-width: none;
		margin: 0;
	}
	/* 6列あるので、スマホでも収まるよう文字と余白を小さめにする */
	.legend-page .legend-table {
		font-size: 0.85rem;
	}
	.legend-page .legend-table th,
	.legend-page .legend-table td {
		padding: 0.45rem 0.35rem;
	}
	.legend-table td {
		vertical-align: middle;
	}
	/* 太さ・弧・速さは短い値なので折り返さない */
	.legend-table td:nth-child(4),
	.legend-table td:nth-child(5),
	.legend-table td:nth-child(6) {
		white-space: nowrap;
	}
	.legend-page svg.sample {
		width: 3.6rem;
		min-width: 3.6rem;
		height: auto;
		display: block;
	}
	.legend-page svg.sample.person {
		width: 3.5rem;
		min-width: 3.5rem;
	}
</style>
