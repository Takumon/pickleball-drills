---
/**
 * 「図の見方」ページ用の凡例。打球の線・人の描き方を、実際の図と同じスタイル（styles/court.css）で描く。
 */
import { roleLabels, shotLabels, shotDurationMs, type Role, type ShotType } from '../config/court';
import '../styles/court.css';

const order: ShotType[] = ['speedup', 'smash', 'volley', 'drive', 'serve', 'return', 'reset', 'dink', 'drop', 'lob', 'feed', 'move'];
const style: Record<ShotType, string> = {
	speedup: '太い実線（強く速い球）',
	smash: '太い実線（強く速い球）',
	volley: '太い実線（強く速い球）',
	drive: '太い実線（強く速い球）',
	serve: '実線',
	return: '実線',
	reset: '細い点線（柔らかく落とす球）',
	dink: '細い点線（柔らかく落とす球）',
	drop: '細い点線（柔らかく落とす球）',
	lob: '破線の曲線（高く上がる球）',
	feed: '灰色の点線（練習の始まりの球）',
	move: '灰色の点線（人が動く）',
};
const isSub = (t: ShotType) => t === 'feed' || t === 'move';
const roles = Object.keys(roleLabels) as Role[];
const sec = (ms: number) => `${(ms / 1000).toFixed(2).replace(/0$/, '')}秒`;
---

<div class="court legend-page">
	<h2>打球の線</h2>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>名前</th><th>線</th><th>アニメーションの速さ</th></tr>
		</thead>
		<tbody>
			{
				order.map((t) => (
					<tr>
						<td>
							<svg class="court-svg sample" viewBox="0 0 14 4" aria-hidden="true">
								<defs>
									<marker id={`lg-${t}`} viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto-start-reverse">
										<path d="M0 0 L10 5 L0 10 z" class:list={['arrowhead', { sub: isSub(t) }]} />
									</marker>
								</defs>
								<rect class="surface" x="0" y="0" width="14" height="4" rx="0.6" />
								<path
									class:list={['shot', `t-${t}`, { sub: isSub(t) }]}
									d={t === 'lob' ? 'M1.2 3.2 Q7 -1.2 12.4 3' : 'M1.2 2 L12.4 2'}
									marker-end={`url(#lg-${t})`}
								/>
							</svg>
						</td>
						<td>{t === 'move' ? '移動' : shotLabels[t]}</td>
						<td>{style[t]}</td>
						<td>{sec(shotDurationMs[t])}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>人</h2>
	<table class="legend-table">
		<thead>
			<tr><th>見本</th><th>役割</th></tr>
		</thead>
		<tbody>
			{
				roles.map((r) => (
					<tr>
						<td>
							<svg class="court-svg sample person" viewBox="0 0 8 7" aria-hidden="true">
								<rect class="surface" x="0" y="0" width="8" height="7" rx="0.6" />
								<g class={`player role-${r}`}>
									<line class="arm" x1="4.9" y1="4.6" x2="4.9" y2="3" />
									<line class="paddle" x1="4.9" y1="3" x2="4.9" y2="2.2" />
									<circle class="body" cx="4" cy="4.6" r="1.3" />
									<text x="4" y="4.6">A</text>
								</g>
							</svg>
						</td>
						<td>{roleLabels[r]}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.legend-page {
		max-width: none;
		margin: 0;
	}
	.legend-table td {
		vertical-align: middle;
	}
	.legend-page svg.sample {
		width: 6rem;
		min-width: 6rem;
		height: auto;
		display: block;
	}
	.legend-page svg.sample.person {
		width: 3.5rem;
		min-width: 3.5rem;
	}
</style>
