---
import type { Drill } from '../content.config';
import { fieldLabels, rallyLabel, visibleFields, detailGroups, type DrillField } from '../config/drill-display';
import Court from './Court.astro';
import { categories } from '../config/categories';

interface Props {
	drill: Drill;
}
const { drill } = Astro.props;
/**
 * 派生形ごとに図があるドリルは、一番上の図の上に派生形の切り替えボタンを出し、押すと図・「今回」の1行・球出しの文が切り替わる（書き手と決めた 2026-11-28）。
 * 図のない派生形は、上の図（drill.diagram）を使う。図がある派生形が1つもないドリルでは出さない（押しても図が変わらないため）
 */
const switchable = drill.diagram && drill.variants.some((v) => v.diagram);
const defaultKey = drill.variants.find((v) => v.default)?.key;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** カテゴリの印: メインのカテゴリ、サブカテゴリの順。押すとドリル一覧のそのカテゴリへ飛ぶ */
const catTags = [drill.category, ...(drill.subCategories ?? [])].map((code, i) => ({
	code,
	main: i === 0,
	label: categories.find((c) => c.code === code)?.label ?? code,
}));

/** 項目に表示できる中身があるか */
function hasContent(field: DrillField): boolean {
	switch (field) {
		case 'steps':
		case 'points':
		case 'variants':
		case 'links':
			return (drill[field] as unknown[]).length > 0;
		default:
			return !!drill[field];
	}
}
const shown = visibleFields.filter(hasContent);
const groups = detailGroups
	.map((g) => ({ label: g.label, fields: g.fields.filter(hasContent), showWhenEmpty: g.showWhenEmpty }))
	.filter((g) => g.fields.length > 0 || g.showWhenEmpty);
/** リンク先のサービス名（URL のホストから決める） */
const SERVICES: [RegExp, string][] = [
	[/(^|\.)(youtube\.com|youtu\.be)$/, 'YouTube'],
	[/(^|\.)instagram\.com$/, 'Instagram'],
];
const serviceOf = (url: string) => {
	const host = new URL(url).hostname;
	return SERVICES.find(([re]) => re.test(host))?.[1] ?? host.replace(/^www\./, '');
};
---

<div class="drill">
	<p class="tags">
		{catTags.map((c) => <a class="cat-tag" data-main={c.main ? 'yes' : 'no'} href={`${base}/drills/#${c.code}`}>{c.label}</a>)}
		{drill.diagram && <span class="rally-tag" data-rally={drill.diagram.rally === false ? 'no' : 'yes'}>{rallyLabel(drill.diagram.rally)}</span>}
	</p>
	{
		[{ fields: shown, label: undefined }, ...groups].map(({ fields, label }) => {
			// トグルの名前と同じ見出しは、中では繰り返さない
			const showHeading = (field: DrillField) => field !== 'diagram' && !(fields.length === 1 && fieldLabels[field] === label);
			const body = fields.map((field) => (
				<section class="field">
					{showHeading(field) && <h3>{fieldLabels[field]}</h3>}
					{field === 'setup' && <p>{drill.setup}</p>}
					{field === 'feed' && (
						<p
							data-variant-feed={switchable ? JSON.stringify(Object.fromEntries(drill.variants.map((v) => [v.key, v.feed ?? drill.feed]))) : undefined}
						>
							{(switchable && drill.variants.find((v) => v.default)?.feed) || drill.feed}
						</p>
					)}
					{field === 'scene' && <p>{drill.scene}</p>}
					{field === 'purpose' && <p>{drill.purpose}</p>}
					{field === 'focus' && <p>{drill.focus}</p>}
					{field === 'notes' && <p>{drill.notes}</p>}
					{field === 'diagram' && drill.diagram && !switchable && <Court diagram={drill.diagram} title={`${drill.id} の図`} />}
					{field === 'diagram' && switchable && (
						<div class="variant-switch" data-variant-switch data-default={defaultKey}>
							<div class="vs-tabs" role="tablist" aria-label="打ち方">
								{/* 選んでいるボタンの下を滑って動く色の面（書き手の希望: 選んだらスライドしてくる）。位置はスクリプトで合わせる */}
								<span class="vs-thumb" aria-hidden="true" />
								{drill.variants.map((v) => (
									<button type="button" role="tab" data-v={v.key} aria-selected={v.default ? 'true' : 'false'}>
										{v.name}
									</button>
								))}
							</div>
							<div class="vs-panels">
								{drill.variants.map((v) => (
									<div class:list={['vs-panel', { off: !v.default }]} data-v={v.key}>
										<Court diagram={v.diagram ?? drill.diagram!} title={`${drill.id}.${v.key} の図`} />
									</div>
								))}
							</div>
						</div>
					)}
					{/* 今回の派生形（練習メニューで選んだもの）。中身はスクリプトで入れる（src/scripts/variant-now.ts） */}
					{field === 'diagram' && drill.variants.length > 0 && (
						<p
							class="variant-now"
							hidden
							data-variants={JSON.stringify(Object.fromEntries(drill.variants.map((v) => [v.key, { name: v.name, note: v.note, default: v.default }])))}
						>
							<strong class="variant-now-name" />
							<span class="variant-now-note" />
						</p>
					)}
					{/* もしもの場面: 基本の図から切り離して、場面ごとに短い図を出す（書き手と決めた） */}
					{/* 見せ方は案を見比べ中（書き手の希望 2026-11-28）: now 今の形 / a 枠の中で切り替え / b 枠の中に小さく付ける / c 隅の小窓 / d 閉じた欄。
					    開発サーバーでは上のセレクトボックスで切り替える（本番は data-sit-ui の初めの値） */}
					{field === 'diagram' && drill.situations.length > 0 && (
						<div class="situations" data-situations data-sit-ui="b">
							{import.meta.env.DEV && (
								<select class="sit-ui-select" aria-label="もしもの場面の見せ方（開発用）">
									<option value="now">今の形（区切り線の下に同じ大きさ）</option>
									<option value="a">案A 枠の中で切り替える</option>
									<option value="b">案B 枠の中に小さく付ける</option>
									<option value="c">案C 隅の小窓</option>
									<option value="d">案D 閉じた欄</option>
								</select>
							)}
							<div class="sit-open-row">
								{drill.situations.map((s, i) => (
									<button type="button" class="sit-open" data-i={i}>
										もし{s.when} ▸
									</button>
								))}
							</div>
							<details class="sit-details" open>
								<summary>もしもの場面（{drill.situations.length}つ）</summary>
								{drill.situations.map((s, i) => (
									<div class="situation" data-i={i}>
										<div class="sit-head">
											<span class="sit-badge">もしもの場面</span>
											<span class="situation-when">もし{s.when}</span>
											<span class="situation-then">→ {s.then}</span>
											<button type="button" class="sit-back">メインに戻る</button>
										</div>
										<Court diagram={s.diagram} title={`${drill.id} の図（${s.when}: ${s.then}）`} />
									</div>
								))}
							</details>
						</div>
					)}
					{field === 'steps' && (
						<ol>
							{drill.steps.map((s) => (
								<li>{s}</li>
							))}
						</ol>
					)}
					{field === 'links' && (
						<ul class="links">
							{drill.links.map((l) => (
								<li>
									<a href={l.url} target="_blank" rel="noopener">
										{l.title}
									</a>
									<span class="service">{serviceOf(l.url)}</span>
								</li>
							))}
						</ul>
					)}
					{field === 'points' && (
						<ul
							data-variant-points={switchable ? JSON.stringify(Object.fromEntries(drill.variants.map((v) => [v.key, v.points ?? drill.points]))) : undefined}
						>
							{((switchable && drill.variants.find((v) => v.default)?.points) || drill.points).map((s) => (
								<li>{s}</li>
							))}
						</ul>
					)}
					{field === 'variants' && (
						<dl class="variants">
							{drill.variants.map((v) => (
								<>
									<dt>
										{v.name}
										{v.default && !switchable && <span class="diagram-tag">（図はこれ）</span>}
									</dt>
									<dd>
										{v.setup && <p>人数・配置: {v.setup}</p>}
										{v.feed && !switchable && <p>球出し: {v.feed}</p>}
										{v.steps && (
											<ol>
												{v.steps.map((s) => (
													<li>{s}</li>
												))}
											</ol>
										)}
										{v.points && !switchable && (
											<ul>
												{v.points.map((s) => (
													<li>{s}</li>
												))}
											</ul>
										)}
										{v.note && <p>{v.note}</p>}
										{v.diagram && !switchable && <Court diagram={v.diagram} title={`${drill.id}.${v.key} の図`} />}
									</dd>
								</>
							))}
						</dl>
					)}
				</section>
			));
			return label ? (
				<details class="more">
					<summary>{label}</summary>
					{fields.length > 0 ? body : <p class="none">なし</p>}
				</details>
			) : (
				body
			);
		})
	}
</div>

<style>
	/* カテゴリとラリーかどうかの印（題名の下） */
	/*
	 * カテゴリとラリーかどうかの印（題名の下）: 押して何かを選ぶものではないので、枠のない小さな文字にする。
	 * 派生形の切り替え（押して選ぶ）と見分けられるようにするため（書き手の指摘: 見た目が近くて紛らわしい）
	 */
	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0;
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cat-tag {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cat-tag:hover {
		text-decoration: underline;
	}
	.cat-tag[data-main='yes'] {
		color: var(--sl-color-gray-2);
		font-weight: 700;
	}
	/* 印のあいだは「・」で区切る */
	.tags > * + *::before {
		content: '・';
		margin: 0 0.3rem;
		color: var(--sl-color-gray-4);
		font-weight: 400;
		text-decoration: none;
		display: inline-block;
	}
	.rally-tag {
		color: var(--sl-color-gray-3);
	}
	.rally-tag[data-rally='yes'] {
		color: var(--sl-color-accent-high);
	}
	/* 見出しは、サイトの見出しの形（ライムの縦の線）にそろえる（custom.css の h2 と同じ形で、一回り小さく） */
	.field h3 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: var(--sl-text-lg);
		margin-top: 1.25rem;
	}
	.field h3::before {
		content: '';
		flex: none;
		width: 0.3rem;
		height: 1.05em;
		border-radius: 999px;
		background: #c6df4a;
	}
	.more {
		margin-top: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.5rem 1rem;
	}
	.more summary {
		cursor: pointer;
		font-weight: 600;
	}
	/* 箇条書きの字下げは、記号（・や番号）が収まる分だけにする（ブラウザの既定の 40px は広すぎる） */
	.field ul,
	.field ol {
		padding-inline-start: 1.3em;
	}
	.field li + li {
		margin-top: 0.15rem;
	}
	.none {
		color: var(--sl-color-gray-3);
	}
	.links .service {
		margin-inline-start: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.variants dt {
		font-weight: 600;
		margin-top: 0.75rem;
	}
	.variants dd {
		margin-inline-start: 1rem;
	}
	/* ---- もしもの場面（見せ方の案を data-sit-ui で切り替える） ---- */
	.sit-ui-select {
		display: block;
		margin: 0.75rem 0 0.5rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.3rem 0.5rem;
		border-radius: 0.4rem;
		border: 1px solid var(--sl-color-gray-4);
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		max-width: 100%;
	}
	.sit-details > summary {
		display: none;
	}
	.sit-open-row,
	.sit-badge,
	.sit-back {
		display: none;
	}
	.sit-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.6rem;
		margin: 0 0 0.35rem;
	}
	.situation-when {
		font-weight: 700;
	}
	.situation-then {
		font-weight: 700;
		color: var(--sl-color-accent-high);
	}
	.situation + .situation {
		margin-top: 1rem;
	}
	/* 今の形: 区切りの線の下に、同じ大きさで並べる */
	.situations[data-sit-ui='now'] {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 2px dashed var(--sl-color-gray-5);
	}
	.situations[data-sit-ui='now'] .sit-head {
		flex-direction: column;
	}
	.situations[data-sit-ui='now'] .situation-when {
		font-size: var(--sl-text-lg);
	}
	/* 案B・案D: メインの図と同じ枠（カード）に入れ、字下げした小さめの図を薄い背景で付ける */
	.field:has(> .situations[data-sit-ui='b']),
	.field:has(> .situations[data-sit-ui='d']) {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		padding: 0.5rem 0.75rem 0.75rem;
	}
	.situations[data-sit-ui='b'],
	.situations[data-sit-ui='d'] {
		margin: 0.5rem 0 0 1.25rem;
		width: min(70%, 100% - 1.25rem);
	}
	.situations[data-sit-ui='b'] .situation,
	.situations[data-sit-ui='d'] .situation {
		background: var(--sl-color-gray-6);
		border-radius: 0.6rem;
		padding: 0.4rem 0.5rem 0.25rem;
	}
	.situations[data-sit-ui='b'] .situation-when::before,
	.situations[data-sit-ui='d'] .situation-when::before {
		content: '└ ';
		color: var(--sl-color-gray-3);
	}
	.situations[data-sit-ui='b'] .situation-then,
	.situations[data-sit-ui='d'] .situation-then {
		font-size: var(--sl-text-sm);
	}
	@media (max-width: 50rem) {
		.situations[data-sit-ui='b'],
		.situations[data-sit-ui='d'] {
			margin-left: 0.5rem;
			width: calc(100% - 0.5rem);
		}
	}
	.situations[data-sit-ui='d'] .sit-details > summary {
		display: block;
		cursor: pointer;
		font-weight: 700;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		margin-bottom: 0.4rem;
	}
	/* 案A: メインの図の下に小さな枠線のボタン。押すと、同じ枠の中の図がもしもの場面に変わる */
	.situations[data-sit-ui='a'] .sit-open-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.5rem;
	}
	.situations[data-sit-ui='a'] .sit-open {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.situations[data-sit-ui='a'] .situation {
		display: none;
	}
	.situations[data-sit-ui='a'].on .sit-open-row {
		display: none;
	}
	.situations[data-sit-ui='a'].on .situation.on {
		display: block;
		border: 2px solid var(--sl-color-accent);
		border-radius: 0.75rem;
		padding: 0.4rem 0.6rem;
	}
	.situations[data-sit-ui='a'] .sit-badge,
	.situations[data-sit-ui='c'] .sit-badge {
		display: inline-block;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.situations[data-sit-ui='a'] .sit-back {
		display: inline-block;
		margin-left: auto;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	/* メインの図（Court の部品なので :global）を隠す */
	.field.sit-main-off > :global(figure) {
		display: none;
	}
	/* 案C: メインの図の右上に小さな窓（ワイプ）で出す。押すと大きくなる */
	.field:has(> .situations[data-sit-ui='c']) {
		position: relative;
	}
	.situations[data-sit-ui='c'] {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		width: 38%;
		z-index: 3;
		cursor: zoom-in;
	}
	.situations[data-sit-ui='c'] .sit-ui-select {
		display: none;
	}
	.situations[data-sit-ui='c'] .situation {
		background: var(--sl-color-black);
		border: 2px solid var(--sl-color-accent);
		border-radius: 0.6rem;
		padding: 0.25rem;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.45);
	}
	.situations[data-sit-ui='c'] .situation:not([data-i='0']) {
		display: none;
	}
	.situations[data-sit-ui='c'] .situation-when,
	.situations[data-sit-ui='c'] .situation-then {
		display: none;
	}
	.situations[data-sit-ui='c'].big {
		width: calc(100% - 1rem);
		cursor: zoom-out;
	}
	.situations[data-sit-ui='c'].big .situation-when,
	.situations[data-sit-ui='c'].big .situation-then {
		display: inline;
	}
	/* 案C のときも、見せ方の切り替え（開発用）は図の上に出す */
	.sit-ui-float {
		margin: 0.5rem 0;
	}
	.variant-now {
		margin: 0.75rem 0 0;
		padding: 0.5rem 0.75rem;
		border-left: 4px solid var(--sl-color-accent);
		border-radius: 0.3rem;
		background: var(--sl-color-gray-6);
	}
	.diagram-tag {
		margin-inline-start: 0.4em;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 400;
	}
	.variant-now-name {
		margin-inline-end: 0.5em;
	}
	/*
	 * 派生形の切り替え: 1つの枠の中にボタンをつなげて並べ（スマホの切り替えボタンの形）、選んでいるものだけ色を付ける。
	 * 上の小さな文字の印（カテゴリ・ラリー）と違って、押して選ぶものだと分かるようにする
	 */
	.vs-tabs {
		position: relative;
		display: flex;
		width: 100%;
		max-width: 26rem;
		margin: 0 0 0.6rem;
		padding: 0.2rem;
		gap: 0.2rem;
		border-radius: 0.8rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
	}
	.vs-tabs button {
		flex: 1;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.4rem 0.3rem;
		/* スマホの幅でも1行に収める（2行になると切り替えボタンの高さがそろわない） */
		white-space: nowrap;
		border-radius: 0.6rem;
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		margin: 0;
	}
	.vs-tabs button {
		position: relative;
		z-index: 1;
		transition: color 0.25s ease;
	}
	.vs-tabs button[aria-selected='true'] {
		color: var(--sl-color-black);
	}
	/* 色の面は、スクリプトが付けるまで最初のボタンの位置（選んでいる派生形）に置く。動くときは横へ滑る */
	.vs-thumb {
		position: absolute;
		top: 0.2rem;
		bottom: 0.2rem;
		left: 0;
		width: 0;
		border-radius: 0.6rem;
		background: var(--sl-color-accent);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.vs-thumb.instant {
		transition: none;
	}
	/* スクリプトが動く前は、選んでいるボタン自体に色を付けておく（面がまだ置かれていないため） */
	.variant-switch:not([data-ready]) .vs-tabs button[aria-selected='true'] {
		background: var(--sl-color-accent);
	}
	/* 選んでいない派生形の図は、場所を取らずに隠す（アニメーションの長さの計算に要るので、display:none にはしない） */
	.vs-panels {
		position: relative;
	}
	.vs-panel.off {
		position: absolute;
		inset: 0 0 auto 0;
		visibility: hidden;
		pointer-events: none;
	}
</style>

<script>
	import { showVariant } from '../scripts/variant-now';
	import { setupSituations } from '../scripts/situations-ui';
	setupSituations(document);
	// ドリルのページでは URL の ?variant= を読む（練習メニューの画面の中では、メニュー側から呼ぶ）
	showVariant(document, new URLSearchParams(location.search).get('variant'));
</script>
