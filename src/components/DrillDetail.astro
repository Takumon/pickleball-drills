---
import type { Drill } from '../content.config';
import { fieldLabels, rallyLabel, visibleFields, detailGroups, type DrillField } from '../config/drill-display';
import Court from './Court.astro';
import { categories } from '../config/categories';

interface Props {
	drill: Drill;
}
const { drill } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** カテゴリの印: メインのカテゴリ、サブカテゴリの順。押すとドリル一覧のそのカテゴリへ飛ぶ */
const catTags = [drill.category, ...(drill.subCategories ?? [])].map((code, i) => ({
	code,
	main: i === 0,
	label: categories.find((c) => c.code === code)?.label ?? code,
}));

/** 項目に表示できる中身があるか */
function hasContent(field: DrillField): boolean {
	switch (field) {
		case 'steps':
		case 'points':
		case 'variants':
		case 'links':
			return (drill[field] as unknown[]).length > 0;
		default:
			return !!drill[field];
	}
}
const shown = visibleFields.filter(hasContent);
const groups = detailGroups
	.map((g) => ({ label: g.label, fields: g.fields.filter(hasContent), showWhenEmpty: g.showWhenEmpty }))
	.filter((g) => g.fields.length > 0 || g.showWhenEmpty);
/** リンク先のサービス名（URL のホストから決める） */
const SERVICES: [RegExp, string][] = [
	[/(^|\.)(youtube\.com|youtu\.be)$/, 'YouTube'],
	[/(^|\.)instagram\.com$/, 'Instagram'],
];
const serviceOf = (url: string) => {
	const host = new URL(url).hostname;
	return SERVICES.find(([re]) => re.test(host))?.[1] ?? host.replace(/^www\./, '');
};
---

<div class="drill">
	<p class="tags">
		{catTags.map((c) => <a class="cat-tag" data-main={c.main ? 'yes' : 'no'} href={`${base}/drills/#${c.code}`}>{c.label}</a>)}
		{drill.diagram && <span class="rally-tag" data-rally={drill.diagram.rally === false ? 'no' : 'yes'}>{rallyLabel(drill.diagram.rally)}</span>}
	</p>
	{
		[{ fields: shown, label: undefined }, ...groups].map(({ fields, label }) => {
			// トグルの名前と同じ見出しは、中では繰り返さない
			const showHeading = (field: DrillField) => field !== 'diagram' && !(fields.length === 1 && fieldLabels[field] === label);
			const body = fields.map((field) => (
				<section class="field">
					{showHeading(field) && <h3>{fieldLabels[field]}</h3>}
					{field === 'setup' && <p>{drill.setup}</p>}
					{field === 'feed' && <p>{drill.feed}</p>}
					{field === 'scene' && <p>{drill.scene}</p>}
					{field === 'purpose' && <p>{drill.purpose}</p>}
					{field === 'focus' && <p>{drill.focus}</p>}
					{field === 'notes' && <p>{drill.notes}</p>}
					{field === 'diagram' && drill.diagram && <Court diagram={drill.diagram} title={`${drill.id} の図`} />}
					{/* 今回の派生形（練習メニューで選んだもの）。中身はスクリプトで入れる（src/scripts/variant-now.ts） */}
					{field === 'diagram' && drill.variants.length > 0 && (
						<p
							class="variant-now"
							hidden
							data-variants={JSON.stringify(Object.fromEntries(drill.variants.map((v) => [v.key, { name: v.name, note: v.note, default: v.default }])))}
						>
							<strong class="variant-now-name" />
							<span class="variant-now-note" />
						</p>
					)}
					{field === 'steps' && (
						<ol>
							{drill.steps.map((s) => (
								<li>{s}</li>
							))}
						</ol>
					)}
					{field === 'links' && (
						<ul class="links">
							{drill.links.map((l) => (
								<li>
									<a href={l.url} target="_blank" rel="noopener">
										{l.title}
									</a>
									<span class="service">{serviceOf(l.url)}</span>
								</li>
							))}
						</ul>
					)}
					{field === 'points' && (
						<ul>
							{drill.points.map((s) => (
								<li>{s}</li>
							))}
						</ul>
					)}
					{field === 'variants' && (
						<dl class="variants">
							{drill.variants.map((v) => (
								<>
									<dt>
										{v.name}
										{v.default && <span class="diagram-tag">（図はこれ）</span>}
									</dt>
									<dd>
										{v.setup && <p>人数・配置: {v.setup}</p>}
										{v.feed && <p>球出し: {v.feed}</p>}
										{v.steps && (
											<ol>
												{v.steps.map((s) => (
													<li>{s}</li>
												))}
											</ol>
										)}
										{v.points && (
											<ul>
												{v.points.map((s) => (
													<li>{s}</li>
												))}
											</ul>
										)}
										{v.note && <p>{v.note}</p>}
										{v.diagram && <Court diagram={v.diagram} title={`${drill.id}.${v.key} の図`} />}
									</dd>
								</>
							))}
						</dl>
					)}
				</section>
			));
			return label ? (
				<details class="more">
					<summary>{label}</summary>
					{fields.length > 0 ? body : <p class="none">なし</p>}
				</details>
			) : (
				body
			);
		})
	}
</div>

<style>
	/* カテゴリとラリーかどうかの印（題名の下） */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0 0 0.5rem;
	}
	.cat-tag {
		display: inline-block;
		padding: 0.05rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		text-decoration: none;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	.cat-tag[data-main='yes'] {
		border-color: var(--sl-color-gray-3);
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.rally-tag {
		display: inline-block;
		padding: 0.05rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		border: 1px solid var(--sl-color-gray-4);
		color: var(--sl-color-gray-2);
	}
	.rally-tag[data-rally='yes'] {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.field h3 {
		font-size: var(--sl-text-lg);
		margin-top: 1.25rem;
	}
	.more {
		margin-top: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.5rem 1rem;
	}
	.more summary {
		cursor: pointer;
		font-weight: 600;
	}
	/* 箇条書きの字下げは、記号（・や番号）が収まる分だけにする（ブラウザの既定の 40px は広すぎる） */
	.field ul,
	.field ol {
		padding-inline-start: 1.3em;
	}
	.field li + li {
		margin-top: 0.15rem;
	}
	.none {
		color: var(--sl-color-gray-3);
	}
	.links .service {
		margin-inline-start: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.variants dt {
		font-weight: 600;
		margin-top: 0.75rem;
	}
	.variants dd {
		margin-inline-start: 1rem;
	}
	.variant-now {
		margin: 0.75rem 0 0;
		padding: 0.5rem 0.75rem;
		border-left: 4px solid var(--sl-color-accent);
		border-radius: 0.3rem;
		background: var(--sl-color-gray-6);
	}
	.diagram-tag {
		margin-inline-start: 0.4em;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 400;
	}
	.variant-now-name {
		margin-inline-end: 0.5em;
	}
</style>

<script>
	import { showVariant } from '../scripts/variant-now';
	// ドリルのページでは URL の ?variant= を読む（練習メニューの画面の中では、メニュー側から呼ぶ）
	showVariant(document, new URLSearchParams(location.search).get('variant'));
</script>
