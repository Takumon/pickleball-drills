---
import type { Drill } from '../content.config';
import { fieldLabels, visibleFields, detailGroups, type DrillField } from '../config/drill-display';
import Court from './Court.astro';

interface Props {
	drill: Drill;
}
const { drill } = Astro.props;

/** 項目に表示できる中身があるか */
function hasContent(field: DrillField): boolean {
	switch (field) {
		case 'steps':
		case 'points':
		case 'variants':
		case 'links':
			return (drill[field] as unknown[]).length > 0;
		default:
			return !!drill[field];
	}
}
const shown = visibleFields.filter(hasContent);
const groups = detailGroups
	.map((g) => ({ label: g.label, fields: g.fields.filter(hasContent), showWhenEmpty: g.showWhenEmpty }))
	.filter((g) => g.fields.length > 0 || g.showWhenEmpty);
/** リンク先のサービス名（URL のホストから決める） */
const SERVICES: [RegExp, string][] = [
	[/(^|\.)(youtube\.com|youtu\.be)$/, 'YouTube'],
	[/(^|\.)instagram\.com$/, 'Instagram'],
];
const serviceOf = (url: string) => {
	const host = new URL(url).hostname;
	return SERVICES.find(([re]) => re.test(host))?.[1] ?? host.replace(/^www\./, '');
};
---

<div class="drill">
	{
		[{ fields: shown, label: undefined }, ...groups].map(({ fields, label }) => {
			// トグルの名前と同じ見出しは、中では繰り返さない
			const showHeading = (field: DrillField) => field !== 'diagram' && !(fields.length === 1 && fieldLabels[field] === label);
			const body = fields.map((field) => (
				<section class="field">
					{showHeading(field) && <h3>{fieldLabels[field]}</h3>}
					{field === 'setup' && <p>{drill.setup}</p>}
					{field === 'feed' && <p>{drill.feed}</p>}
					{field === 'purpose' && <p>{drill.purpose}</p>}
					{field === 'notes' && <p>{drill.notes}</p>}
					{field === 'diagram' && drill.diagram && <Court diagram={drill.diagram} title={`${drill.id} の図`} />}
					{field === 'steps' && (
						<ol>
							{drill.steps.map((s) => (
								<li>{s}</li>
							))}
						</ol>
					)}
					{field === 'links' && (
						<ul class="links">
							{drill.links.map((l) => (
								<li>
									<a href={l.url} target="_blank" rel="noopener">
										{l.title}
									</a>
									<span class="service">{serviceOf(l.url)}</span>
								</li>
							))}
						</ul>
					)}
					{field === 'points' && (
						<ul>
							{drill.points.map((s) => (
								<li>{s}</li>
							))}
						</ul>
					)}
					{field === 'variants' && (
						<dl class="variants">
							{drill.variants.map((v) => (
								<>
									<dt>
										{v.name}
									</dt>
									<dd>
										{v.setup && <p>人数・配置: {v.setup}</p>}
										{v.feed && <p>球出し: {v.feed}</p>}
										{v.steps && (
											<ol>
												{v.steps.map((s) => (
													<li>{s}</li>
												))}
											</ol>
										)}
										{v.points && (
											<ul>
												{v.points.map((s) => (
													<li>{s}</li>
												))}
											</ul>
										)}
										{v.note && <p>{v.note}</p>}
										{v.diagram && <Court diagram={v.diagram} title={`${drill.id}.${v.key} の図`} />}
									</dd>
								</>
							))}
						</dl>
					)}
				</section>
			));
			return label ? (
				<details class="more">
					<summary>{label}</summary>
					{fields.length > 0 ? body : <p class="none">なし</p>}
				</details>
			) : (
				body
			);
		})
	}
</div>

<style>
	.field h3 {
		font-size: var(--sl-text-lg);
		margin-top: 1.25rem;
	}
	.more {
		margin-top: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.5rem 1rem;
	}
	.more summary {
		cursor: pointer;
		font-weight: 600;
	}
	.none {
		color: var(--sl-color-gray-3);
	}
	.links .service {
		margin-inline-start: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.variants dt {
		font-weight: 600;
		margin-top: 0.75rem;
	}
	.variants dd {
		margin-inline-start: 1rem;
	}
</style>
