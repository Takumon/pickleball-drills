---
/**
 * ドリル一覧の1行のカード: 左に小さな図（共有の画像のコートのタイルだけを切り出す）、右に題名・練習の目的・印。
 * 共有の画像は 1200×630 で、右のコートのタイルは x 736〜1136・y 36〜594 にある（src/pages/og/[id].astro の Bento の形）。
 */
import type { Drill } from '../content.config';
import { rallyLabel } from '../config/drill-display';

interface Props {
	x: { d: Drill; title: string; url: string; thumb?: string };
	/** ほかのカテゴリのドリルとして並べるときの、メインのカテゴリの名前 */
	from?: string;
}
const { x, from } = Astro.props;
---

<li class="row">
	<a href={x.url}>
		<span class="thumb" aria-hidden="true">
			{x.thumb && <img src={x.thumb} alt="" loading="lazy" decoding="async" width="1200" height="630" />}
		</span>
		<span class="body">
			<span class="title">{x.title}</span>
			<span class="focus">{x.d.focus}</span>
			<span class="tags">
				{from && <span class="tag from">{from}</span>}
				<span class="tag rally" data-rally={x.d.diagram?.rally === false ? 'no' : 'yes'}>{rallyLabel(x.d.diagram?.rally)}</span>
			</span>
		</span>
		<span class="chev" aria-hidden="true">›</span>
	</a>
</li>

<style>
	.row {
		margin: 0;
	}
	.row a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 100%;
		padding: 0.5rem 0.6rem 0.5rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		text-decoration: none;
		color: var(--sl-color-white);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.row a:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}
	/* 共有の画像（1200×630）を 0.2 倍にし、右のコートのタイル（400×558 → 80×112）だけを見せる */
	.thumb {
		position: relative;
		flex: none;
		width: 80px;
		height: 112px;
		overflow: hidden;
		border-radius: 0.6rem;
		background: #1b4a2f;
	}
	.thumb img {
		position: absolute;
		left: -147px;
		top: -7px;
		width: 240px;
		height: 126px;
		max-width: none;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
		flex: 1;
	}
	.title {
		font-weight: 700;
		line-height: 1.35;
	}
	/* 練習の目的は2行まで（長いときは … で切る） */
	.focus {
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.tag {
		padding: 0 0.45rem;
		border-radius: 999px;
		font-size: 0.7rem;
		line-height: 1.6;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-3);
	}
	.tag.rally[data-rally='yes'] {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.chev {
		flex: none;
		color: var(--sl-color-gray-3);
		font-size: 1.25rem;
	}
</style>
