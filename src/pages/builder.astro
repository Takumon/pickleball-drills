---
/**
 * 練習メニューのビルダー（PC向け）。サイトの枠（ヘッダー、ライト／ダークの切り替え）の中に置き、サイドバーは出さない。
 * サイドバーやヘッダーからはリンクしない。入口は、トップページの一番下の小さなリンクと、メニュー表示の「このメニューを編集」だけ。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Builder from '../components/builder/Builder';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage frontmatter={{ title: 'メニューを作る', template: 'splash', pagefind: false, head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }] }}>
	<div class="not-content">
		<Builder client:only="preact" base={base} />
	</div>
</StarlightPage>

<style is:global>
	/* 色はサイト（Starlight）の変数に合わせ、ライト／ダークの切り替えに連動させる */
	.builder {
		--bg: var(--sl-color-bg);
		--panel: var(--sl-color-gray-6);
		--fg: var(--sl-color-white);
		--muted: var(--sl-color-gray-3);
		--line: var(--sl-color-gray-5);
		--accent: var(--sl-color-accent);
		--danger: var(--sl-color-red);
		--ok: var(--sl-color-green);
		color: var(--fg);
		font-size: 15px;
	}
	.builder *,
	.builder *::before,
	.builder *::after {
		box-sizing: border-box;
	}
			.builder input,
	.builder select,
	.builder button,
	.builder .button {
		font: inherit;
		color: inherit;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 4px 8px;
	}
	.builder button,
	.builder .button {
		cursor: pointer;
		background: var(--panel);
		text-decoration: none;
		display: inline-block;
	}
	.builder button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.builder input[type='number'] {
		width: 4.2em;
	}
	.builder {
		display: grid;
		grid-template-columns: minmax(260px, 340px) 1fr;
		gap: 20px;
		padding: 0 0 40px;
		align-items: start;
	}
	/* PC向けの画面だが、幅が狭いときは縦に並べ、行の中身を折り返して横にはみ出さないようにする */
	@media (max-width: 760px) {
		.builder {
			grid-template-columns: 1fr;
			padding: 12px;
		}
		.catalog {
			position: static;
			max-height: 50vh;
		}
		.row,
		.body {
			flex-wrap: wrap;
		}
		.menu-head input[type='text'] {
			width: 100%;
		}
	}
	.builder h2 {
		font-size: 1rem;
		margin: 0 0 8px;
	}
	.builder .catalog {
		position: sticky;
		top: calc(var(--sl-nav-height) + 12px);
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 12px;
		max-height: calc(100vh - var(--sl-nav-height) - 24px);
		display: flex;
		flex-direction: column;
	}
	.builder .filters {
		display: grid;
		gap: 6px;
		margin-bottom: 8px;
	}
	.builder .catalog-list {
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-y: auto;
	}
	.builder .catalog-list li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 2px;
		border-bottom: 1px solid var(--line);
	}
	.builder .catalog-list .title {
		flex: 1;
	}
	.builder .catalog-list .variant-adds {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-top: 4px;
	}
	.builder .catalog-list .variant-add {
		padding: 1px 8px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--accent);
		font-size: 0.8rem;
	}
	.builder .catalog-list .variant-add.is-default {
		border-color: var(--accent);
	}
	.builder .catalog-list .default-tag {
		margin-left: 4px;
		color: var(--muted);
		font-size: 0.7rem;
	}
	.builder .catalog-list .meta {
		color: var(--muted);
		font-size: 0.8rem;
		white-space: nowrap;
		display: flex;
		gap: 6px;
	}
	.builder .catalog-list .meta a {
		color: var(--muted);
		text-decoration: none;
	}
	.builder .catalog-list .add {
		padding: 2px 8px;
		color: var(--accent);
		font-weight: 700;
	}
	.builder .empty {
		color: var(--muted);
		padding: 12px 4px;
		list-style: none;
	}
	.builder .menu-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 20px;
		margin-bottom: 10px;
	}
	.builder .menu-head label {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.builder .menu-head input[type='text'] {
		width: 16em;
	}
	.builder .sum {
		margin: 0;
	}
	.builder .sum .remain {
		color: var(--ok);
	}
	.builder .sum .over {
		color: var(--danger);
		font-weight: 700;
	}
	.builder .rows {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.builder .row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 4px;
		border-bottom: 1px solid var(--line);
		background: var(--bg);
	}
	.builder .row.drag-over {
		box-shadow: inset 0 3px 0 var(--accent);
	}
	.builder .row.kind-heading {
		background: var(--panel);
		font-weight: 700;
	}
	.builder .row.kind-break .body {
		color: var(--muted);
	}
	.builder .handle {
		cursor: grab;
		color: var(--muted);
		padding: 0 4px;
		user-select: none;
	}
	.builder .body {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
	}
	.builder .body .grow {
		flex: 1;
		min-width: 6em;
	}
	.builder .body .tag {
		font-size: 0.75rem;
		color: var(--muted);
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 0 6px;
		white-space: nowrap;
	}
	.builder .body .min {
		color: var(--muted);
		font-size: 0.85rem;
		min-width: 3.5em;
		text-align: right;
	}
	.builder .row-actions {
		display: flex;
		gap: 4px;
	}
	.builder .row-actions button {
		padding: 2px 7px;
	}
	.builder .add-buttons,
	.builder .actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
		align-items: center;
	}
	.builder .actions .primary {
		background: var(--sl-color-text-accent);
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-black);
	}
	.builder .actions .danger {
		border-color: var(--danger);
		color: var(--danger);
	}
	.builder .notice {
		color: var(--ok);
		font-size: 0.9rem;
	}
	.builder .import {
		margin-top: 20px;
		color: var(--muted);
	}
	.builder .import summary {
		cursor: pointer;
	}
	.builder .import-row {
		display: flex;
		gap: 8px;
	}
	.builder .import-row input {
		flex: 1;
	}
</style>
