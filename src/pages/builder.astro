---
/**
 * 練習メニューのビルダー（PC向け）。サイドバーやヘッダーからはリンクしない。
 * 入口は、トップページの一番下の小さなリンクと、メニュー表示の「このメニューを編集」だけ。
 */
import Builder from '../components/builder/Builder';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>メニューを作る | ピックルボール ドリル集</title>
	</head>
	<body>
		<header class="site">
			<a href={`${base}/`}>ピックルボール ドリル集</a>
			<h1>メニューを作る</h1>
		</header>
		<Builder client:only="preact" base={base} />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--bg: #ffffff;
		--panel: #f6f7f9;
		--fg: #1a1a1a;
		--muted: #6b7280;
		--line: #d9dce1;
		--accent: #2563eb;
		--danger: #dc2626;
		--ok: #15803d;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17181c;
			--panel: #202228;
			--fg: #ececec;
			--muted: #9ca3af;
			--line: #353841;
			--accent: #60a5fa;
			--danger: #f87171;
			--ok: #4ade80;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: system-ui, -apple-system, 'Hiragino Sans', sans-serif;
		font-size: 15px;
	}
	header.site {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 12px 20px;
		border-bottom: 1px solid var(--line);
	}
	header.site a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.85rem;
	}
	header.site h1 {
		margin: 0;
		font-size: 1.2rem;
	}
	input,
	select,
	button,
	.button {
		font: inherit;
		color: inherit;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 4px 8px;
	}
	button,
	.button {
		cursor: pointer;
		background: var(--panel);
		text-decoration: none;
		display: inline-block;
	}
	button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	input[type='number'] {
		width: 4.2em;
	}
	.builder {
		display: grid;
		grid-template-columns: minmax(260px, 340px) 1fr;
		gap: 20px;
		padding: 16px 20px 40px;
		align-items: start;
	}
	/* PC向けの画面だが、幅が狭いときは縦に並べ、行の中身を折り返して横にはみ出さないようにする */
	@media (max-width: 760px) {
		.builder {
			grid-template-columns: 1fr;
			padding: 12px;
		}
		.catalog {
			position: static;
			max-height: 50vh;
		}
		.row,
		.body {
			flex-wrap: wrap;
		}
		.menu-head input[type='text'] {
			width: 100%;
		}
	}
	.builder h2 {
		font-size: 1rem;
		margin: 0 0 8px;
	}
	.catalog {
		position: sticky;
		top: 12px;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 12px;
		max-height: calc(100vh - 90px);
		display: flex;
		flex-direction: column;
	}
	.filters {
		display: grid;
		gap: 6px;
		margin-bottom: 8px;
	}
	.catalog-list {
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-y: auto;
	}
	.catalog-list li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 2px;
		border-bottom: 1px solid var(--line);
	}
	.catalog-list .title {
		flex: 1;
	}
	.catalog-list .meta {
		color: var(--muted);
		font-size: 0.8rem;
		white-space: nowrap;
		display: flex;
		gap: 6px;
	}
	.catalog-list .meta a {
		color: var(--muted);
		text-decoration: none;
	}
	.catalog-list .add {
		padding: 2px 8px;
		color: var(--accent);
		font-weight: 700;
	}
	.empty {
		color: var(--muted);
		padding: 12px 4px;
		list-style: none;
	}
	.menu-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 20px;
		margin-bottom: 10px;
	}
	.menu-head label {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.menu-head input[type='text'] {
		width: 16em;
	}
	.sum {
		margin: 0;
	}
	.sum .remain {
		color: var(--ok);
	}
	.sum .over {
		color: var(--danger);
		font-weight: 700;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 4px;
		border-bottom: 1px solid var(--line);
		background: var(--bg);
	}
	.row.drag-over {
		box-shadow: inset 0 3px 0 var(--accent);
	}
	.row.kind-heading {
		background: var(--panel);
		font-weight: 700;
	}
	.row.kind-break .body {
		color: var(--muted);
	}
	.handle {
		cursor: grab;
		color: var(--muted);
		padding: 0 4px;
		user-select: none;
	}
	.body {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
	}
	.body .grow {
		flex: 1;
		min-width: 6em;
	}
	.body .tag {
		font-size: 0.75rem;
		color: var(--muted);
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 0 6px;
		white-space: nowrap;
	}
	.body .min {
		color: var(--muted);
		font-size: 0.85rem;
		min-width: 3.5em;
		text-align: right;
	}
	.row-actions {
		display: flex;
		gap: 4px;
	}
	.row-actions button {
		padding: 2px 7px;
	}
	.add-buttons,
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
		align-items: center;
	}
	.actions .primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.actions .danger {
		border-color: var(--danger);
		color: var(--danger);
	}
	.notice {
		color: var(--ok);
		font-size: 0.9rem;
	}
	.import {
		margin-top: 20px;
		color: var(--muted);
	}
	.import summary {
		cursor: pointer;
	}
	.import-row {
		display: flex;
		gap: 8px;
	}
	.import-row input {
		flex: 1;
	}
</style>
