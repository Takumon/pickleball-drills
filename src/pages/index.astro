---
/**
 * トップページ兼メニュー表示。
 * クエリに m（メニュー）があれば、その日の練習メニューを表示する。なければ短いトップページを表示する。
 * メニューの URL 形式は src/lib/menu.ts。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import Court from '../components/Court.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { categories } from '../config/categories';
import { circle } from '../config/circle';
import { Image } from 'astro:assets';
// 練馬ピックルのロゴ（テニスベアのサークルの画像を丸く切り出したもの。書き手が渡した画像）
import circleLogo from '../assets/circle-logo.jpg';
import '../styles/court.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// トップページは、サークルのメンバー（B）とサークルの外の人（C）のためのページ（docs/principles.md の「読者」）。
// 最初に「練習がたくさんあって、図が動くから分かりやすそう」と感じてもらう（書き手と決めた並び: 案A）
const docs = await getCollection('docs', (e) => !!e.data.drill);
const drills = docs.map((e) => e.data.drill!);
// 最初に動かす図（ドリル名やリンクは添えない。トップページでは図だけ見せる。書き手の指摘）: 4種類の球（ディンク・スピードアップ・カウンター・リセット）があり、キッチンだけで動くので横長で収まりやすい（書き手と決めた）
const HERO_ID = 'spd002';
const hero = docs.find((e) => e.data.drill!.id === HERO_ID);
if (!hero?.data.drill?.diagram) throw new Error(`トップページ: ${HERO_ID} の図がない`);
// カテゴリのタイル: メインかサブカテゴリでそのカテゴリに入るドリルの数（ドリル一覧と同じ数え方）。
// ドリルとカテゴリの総数は出さない。タイルが並ぶだけで、たくさんあることが伝わるため（書き手の指摘）
const tiles = categories
	.map((c) => ({ ...c, count: drills.filter((d) => d.category === c.code || d.subCategories.includes(c.code)).length }))
	.filter((c) => c.count > 0);
---

{/* トップページ（と練習メニュー）はサイドバーを出さない（splash）。広い画面でもトップの中身に目が行くようにする（書き手の指摘） */}
<StarlightPage frontmatter={{ title: 'ピックルボール ドリル集', template: 'splash', head: [{ tag: 'title', content: 'ピックルボール ドリル集' }], description: 'ピックルボールの練習方法を、アニメーションで理解するドリル集です。打つ順と球の行き先が図で動くので、練習中にスマホで見てすぐ確かめられます。' }}>
	<div id="top-page">
		{/* デザイン: 深い緑の帯（練馬ピックルのロゴの緑。共有の画像と同じ配色）に、大きな見出しと動く図を載せる */}
		<section class="hero">
			{/* 見出しは1行だけ。図を見れば分かることを先に文で書かない（書き手と決めた） */}
			<p class="tagline">動く図でわかる<br class="br" />練習方法</p>
			<figure class="hero-court">
				<Court diagram={hero.data.drill.diagram} title={`見本: ${HERO_ID}`} />
			</figure>
		</section>

		<section class="block">
			<h2>カテゴリから探す</h2>
			<ul class="tiles">
				{
					tiles.map((c) => (
						<li>
							<a href={`${base}/drills/#${c.code}`}>
								<span class="name">{c.label}</span>
								<span class="foot"><span class="count">{c.count}本</span><span class="arrow" aria-hidden="true">→</span></span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		{/* 「練習会での使い方」は出さない。外の人には通じず、メンバーは周知で知っていて、当日の参加者はメニューのページに直接着くため（書き手の指摘）。
		    サイトと練習会のつながりは、サークル紹介の最後の一文で伝える */}
		<section class="block circle">
			<h2>運営しているサークル</h2>
			<div class="circle-card">
				<div class="circle-head">
					<Image src={circleLogo} alt={`${circle.name}のロゴ`} width={64} height={64} class="avatar" />
					<p class="circle-name">{circle.name}</p>
				</div>
				<p>{circle.intro}</p>
				<a class="circle-link" href={circle.url} target="_blank" rel="noopener">テニスベアの{circle.name}のページ ↗</a>
			</div>
		</section>

		{/* 「ほかのページ」（ドリル一覧・図の見方・大原則・用語集）は出さない。ドリル一覧はカテゴリのタイルから、ほかはサイドバーから行ける。
		    トップで見せても、読み手にしてほしい行動がないため（書き手の指摘） */}
		<ShareButtons text="ピックルボール ドリル集" />
		<p class="builder-link"><a href={`${base}/builder/`}>メニューを作る</a></p>
	</div>

	<div id="menu-view" hidden data-base={base}>
		<p class="menu-summary"><span class="menu-theme"></span><span class="menu-total"></span></p>
		<div class="menu-list"></div>
		<p class="menu-edit"><a href="#">このメニューを編集</a></p>
	</div>
</StarlightPage>

<script>
	import { blocks, chosenVariant, fmtMin, parseMenu, totalMinutes, type CatalogDrill, type MenuItem } from '../lib/menu';
	import { setupCourtAnimations } from '../scripts/court-anim';
	import { showVariant } from '../scripts/variant-now';

	const view = document.getElementById('menu-view')!;
	const base = view.dataset.base ?? '';
	const menu = parseMenu(location.search);

	if (menu) {
		document.getElementById('top-page')!.hidden = true;
		view.hidden = false;
		document.title = `${menu.theme ? `${menu.theme} | ` : ''}練習メニュー | ピックルボール ドリル集`;
		const h1 = document.querySelector('main h1');
		if (h1) h1.textContent = '練習メニュー';
		render(menu);
		view.querySelector<HTMLAnchorElement>('.menu-edit a')!.href = `${base}/builder/${location.search}`;
	}

	async function render(m: NonNullable<typeof menu>) {
		const catalog: CatalogDrill[] = await (await fetch(`${base}/drills.json`)).json();
		const byId = new Map(catalog.map((d) => [d.id, d]));
		view.querySelector('.menu-theme')!.textContent = m.theme ? `テーマ：${m.theme}` : '';
		view.querySelector('.menu-total')!.textContent = `合計 ${fmtMin(totalMinutes(m))}`;
		const list = view.querySelector('.menu-list')!;
		for (const b of blocks(m)) {
			const sec = document.createElement('section');
			sec.className = 'menu-block';
			if (b.heading !== undefined) {
				const h = document.createElement('h2');
				h.className = 'menu-heading';
				h.innerHTML = `<span></span><span class="min"></span>`;
				h.children[0].textContent = `■ ${b.heading}`;
				h.children[1].textContent = b.minutes ? fmtMin(b.minutes) : '';
				sec.append(h);
			}
			for (const it of b.items) sec.append(row(it, byId));
			list.append(sec);
		}
	}

	function row(it: MenuItem, byId: Map<string, CatalogDrill>): HTMLElement {
		const li = document.createElement('div');
		li.className = `menu-item kind-${it.kind}`;
		if (it.kind === 'break') {
			li.textContent = `休憩 ${fmtMin(it.min)}`;
			return li;
		}
		if (it.kind === 'note') {
			li.textContent = it.min ? `${it.text}（${fmtMin(it.min)}）` : it.text;
			return li;
		}
		if (it.kind !== 'drill') return li;
		const d = byId.get(it.id);
		// 図と違う派生形を選んだときだけ、派生形を書く（図で描いている派生形なら書かない）
		const variant = chosenVariant(it, d);
		const name = d ? `${d.title}${variant ? `（${variant.name}）` : ''}` : `見つからないドリル（${it.id}）`;
		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'menu-drill';
		btn.setAttribute('aria-expanded', 'false');
		btn.innerHTML = `<span class="name"></span><span class="time"></span><span class="chev" aria-hidden="true">›</span>`;
		btn.querySelector('.name')!.textContent = name;
		btn.querySelector('.time')!.textContent = `${fmtMin(it.min)}×${it.sets}`;
		li.append(btn);
		if (!d) {
			btn.disabled = true;
			return li;
		}
		const panel = document.createElement('div');
		panel.className = 'menu-panel';
		panel.hidden = true;
		li.append(panel);
		btn.addEventListener('click', async () => {
			const open = panel.hidden;
			panel.hidden = !open;
			btn.setAttribute('aria-expanded', String(open));
			li.classList.toggle('open', open);
			if (open && !panel.dataset.loaded) {
				panel.dataset.loaded = '1';
				panel.textContent = '読み込み中…';
				try {
					const html = await (await fetch(d.fragment)).text();
					panel.innerHTML = html;
					// 中のリンクで別のページへ移るとメニューに戻りにくいので、別のタブで開く
					panel.querySelectorAll('a').forEach((a) => {
						a.target = '_blank';
						a.rel = 'noopener';
					});
					const foot = document.createElement('div');
					foot.className = 'menu-panel-foot';
					foot.innerHTML = `<button type="button" class="menu-close">▲ 閉じる</button><a class="menu-open-page" target="_blank" rel="noopener"></a>`;
					const a = foot.querySelector('a')!;
					a.href = variant ? `${d.url}?variant=${encodeURIComponent(variant.key)}` : d.url;
					a.textContent = 'ページで見る ↗';
					foot.querySelector('button')!.addEventListener('click', () => {
						panel.hidden = true;
						btn.setAttribute('aria-expanded', 'false');
						li.classList.remove('open');
						// 閉じたら、その行が見える位置に戻す
						btn.scrollIntoView({ block: 'nearest' });
					});
					panel.append(foot);
					setupCourtAnimations(panel);
					showVariant(panel, variant?.key);
				} catch {
					panel.textContent = '読み込めませんでした。';
					delete panel.dataset.loaded;
				}
			}
		});
		return li;
	}
</script>

<style>
	/* 配色は共有の画像（src/config/og.ts）と同じ: 深い緑・生成り・ライム */
	#top-page {
		--brand-bg: #123521;
		--brand-tile: #1b4a2f;
		--brand-paper: #f4f1e6;
		--brand-ink: #10241a;
		--brand-lime: #c6df4a;
	}
	/* サイドバーがないので、広い画面では中身の幅を決めて真ん中に置く */
	#top-page {
		max-width: 64rem;
		margin-inline: auto;
	}
	.hero {
		margin: 0.5rem 0 0;
		padding: 1.5rem 1rem 1rem;
		border-radius: 1.25rem;
		background:
			radial-gradient(120% 80% at 100% 0%, rgba(198, 223, 74, 0.18), transparent 60%),
			linear-gradient(160deg, var(--brand-tile), var(--brand-bg));
		color: var(--brand-paper);
		box-shadow: 0 12px 32px -16px rgba(0, 0, 0, 0.5);
	}
	.hero .tagline {
		margin: 0;
		font-size: clamp(1.9rem, 8vw, 2.6rem);
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: 0.01em;
		color: var(--brand-paper);
	}
	/*
	 * スマホでは、帯を画面の左右の端まで広げて角丸をなくし、図の内側の枠も外す。
	 * 枠が重なって線が増え、図に使える横幅が減っていたため（書き手の指摘）。枠は帯の色の境目とコートの線だけにする
	 */
	@media (max-width: 49.99rem) {
		.hero {
			margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
			padding: 1.25rem 0.75rem 0.75rem;
			border-radius: 0;
			box-shadow: none;
		}
		.hero .tagline {
			padding-inline: 0.25rem;
		}
		.hero-court {
			margin-top: 1rem;
			padding: 0;
			background: none;
			border: 0;
			border-radius: 0;
		}
	}
	/* 広い画面では、見出しを左、動く図を右に並べる（紹介ページでよくある形） */
	@media (min-width: 50rem) {
		.hero {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
			align-items: center;
			gap: 2rem;
			padding: 2.5rem;
		}
		.hero .tagline {
			font-size: clamp(2.4rem, 4.2vw, 3.4rem);
		}
		.hero-court {
			margin: 0;
		}
	}
	.hero-court {
		margin: 1.25rem 0 0;
		padding: 0.5rem;
		border-radius: 0.9rem;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(244, 241, 230, 0.12);
	}
	/* 帯の中の操作ボタンは、ライト・ダークのどちらでも、帯の深い緑の上で読める色にする */
	.hero-court :global(.anim-controls button) {
		background: rgba(244, 241, 230, 0.12);
		border-color: rgba(244, 241, 230, 0.25);
		color: var(--brand-paper);
	}
	.block {
		margin-top: 2.5rem;
	}
	.block h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-xl);
	}
	.block h2::before {
		content: '';
		width: 0.35rem;
		height: 1.2em;
		border-radius: 999px;
		background: var(--brand-lime);
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.6rem;
		list-style: none;
		padding: 0;
		margin-top: 1rem;
	}
	.tiles li {
		margin: 0;
	}
	.tiles a {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.5rem;
		height: 100%;
		min-height: 5rem;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--sl-color-gray-7, var(--sl-color-black));
		text-decoration: none;
		color: var(--sl-color-white);
		line-height: 1.35;
		transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.tiles a:hover {
		transform: translateY(-2px);
		border-color: var(--sl-color-accent);
		box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.45);
	}
	.tiles .name {
		font-weight: 700;
		font-size: var(--sl-text-sm);
	}
	.tiles .foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.tiles .count {
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	.tiles .arrow {
		color: var(--sl-color-gray-3);
		transition: transform 0.15s ease;
	}
	.tiles a:hover .arrow {
		transform: translateX(3px);
		color: var(--sl-color-accent-high);
	}
	.circle-card {
		max-width: 48rem;
		margin-top: 1rem;
		padding: 1.25rem;
		border-radius: 1.1rem;
		background: var(--brand-paper);
		color: var(--brand-ink);
	}
	:global(:root[data-theme='dark']) .circle-card {
		background: var(--brand-tile);
		color: var(--brand-paper);
	}
	.circle-card p {
		margin: 0;
		color: inherit;
		line-height: 1.75;
	}
	.circle-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.avatar {
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		flex: none;
		box-shadow: 0 0 0 2px rgba(244, 241, 230, 0.6);
	}
	.circle-card .circle-name {
		font-size: var(--sl-text-xl);
		font-weight: 800;
	}
	.circle-link {
		display: inline-flex;
		align-items: center;
		margin-top: 1rem;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: var(--brand-bg);
		color: var(--brand-paper);
		font-weight: 700;
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	:global(:root[data-theme='dark']) .circle-link {
		background: var(--brand-lime);
		color: var(--brand-ink);
	}
	.circle-link:hover {
		filter: brightness(1.1);
	}
	/* 作り手向けの入口は目立たせない */
	.builder-link {
		margin-top: 3rem;
		font-size: var(--sl-text-xs);
	}
	.builder-link a {
		color: var(--sl-color-gray-3);
	}
</style>

<style is:global>
	/* 練習メニューも サイドバーなし（splash）で表示するので、広い画面では読みやすい幅にして真ん中に置く */
	#menu-view {
		max-width: 45rem;
		margin-inline: auto;
	}
	main:has(#menu-view:not([hidden])) h1#_top {
		max-width: 45rem;
		margin-inline: auto;
	}
	/* トップページでは、ページの見出し（サイト名と同じ）を画面に出さない。画面の上のサイト名と2回続いてうるさいため（書き手の指摘）。
	   読み上げのために見出しは残す。練習メニューを表示するとき（#top-page を隠すとき）は、見出し「練習メニュー」を出す */
	main:has(#top-page:not([hidden])) h1#_top {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	/* 見出しを隠すと、見出しの枠と本文の枠の間の線（Starlight の区切り線）だけが残るので、枠の余白と線も消す（書き手の指摘） */
	main:has(#top-page:not([hidden])) .content-panel:has(h1#_top) {
		padding: 0;
	}
	main:has(#top-page:not([hidden])) .content-panel + .content-panel {
		border-top: 0;
	}
	/* メニューの行は JavaScript で作るので、スコープなしのスタイルを #menu-view の中に限って当てる */
	#menu-view .menu-summary {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		font-weight: 600;
	}
	#menu-view .menu-block {
		margin-top: 1.25rem;
	}
	#menu-view .menu-heading {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-size: var(--sl-text-lg);
		margin: 0 0 0.25rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	#menu-view .menu-heading .min {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		font-weight: 600;
	}
	#menu-view .menu-item {
		margin: 0;
		border-bottom: 1px solid var(--sl-color-gray-6);
	}
	#menu-view .menu-item.kind-note {
		padding: 0.6rem 0.25rem;
		color: var(--sl-color-gray-2);
	}
	/* 休憩は練習の区切りなので、行ではなく、左右に線をのばした仕切りとして見せる */
	#menu-view .menu-item.kind-break {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0.9rem 0;
		padding: 0.2rem 0;
		border-bottom: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
	}
	#menu-view .menu-item.kind-break::before,
	#menu-view .menu-item.kind-break::after {
		content: '';
		flex: 1;
		border-top: 2px dashed var(--sl-color-gray-4);
	}
	#menu-view .menu-drill {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.7rem 0.25rem;
		margin: 0;
		background: none;
		border: 0;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	#menu-view .menu-drill .name {
		flex: 1;
		font-weight: 600;
	}
	#menu-view .menu-drill .time {
		color: var(--sl-color-gray-3);
		white-space: nowrap;
		font-size: var(--sl-text-sm);
	}
	#menu-view .menu-drill .chev {
		color: var(--sl-color-gray-3);
		transition: transform 0.15s;
	}
	#menu-view .menu-drill[aria-expanded='true'] .chev {
		transform: rotate(90deg);
	}
	#menu-view .menu-drill:disabled {
		cursor: default;
		opacity: 0.6;
	}
	/* 開いた行は、見出しの行から中身の終わりまでを1枚の枠で囲み、どこまでが中身か分かるようにする */
	#menu-view .menu-item.open {
