---
/**
 * 共有のプレビュー画像（OGP、1200×630）のもとになるページ。ビルドのあとに、このページを画像にする。
 * 左にカテゴリ・ドリル名・練習の目的・サイト名、右に「決めの場面」のコート図（src/lib/og.ts）。
 * LINE や X はダークモードでも画像の色を変えないので、ライトの配色で固定する。
 */
import { getCollection } from 'astro:content';
import Court from '../../components/Court.astro';
import { categories } from '../../config/categories';
import { ogDiagram } from '../../lib/og';

export async function getStaticPaths() {
	const docs = await getCollection('docs', (e) => !!e.data.drill);
	return docs.map((e) => ({ params: { id: e.data.drill!.id }, props: { title: e.data.title, drill: e.data.drill! } }));
}
const { title, drill } = Astro.props;
const category = categories.find((c) => c.code === drill.category)?.label ?? '';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<style is:global>
			html,
			body {
				margin: 0;
				background: #f6f7f4;
			}
			.og {
				box-sizing: border-box;
				width: 1200px;
				height: 630px;
				display: flex;
				gap: 48px;
				padding: 56px 64px;
				font-family: 'Hiragino Sans', 'Noto Sans JP', system-ui, sans-serif;
				color: #111827;
			}
			.og .text {
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.og .category {
				font-size: 28px;
				font-weight: 700;
				color: #2f6b48;
			}
			.og h1 {
				font-size: 56px;
				line-height: 1.3;
				/* 日本語を文節で折り返す（「スマッ／シュ」のような切れ方を避ける） */
				word-break: auto-phrase;
				margin: 16px 0 28px;
			}
			.og .focus {
				word-break: auto-phrase;
				font-size: 30px;
				line-height: 1.6;
				color: #374151;
				margin: 0;
			}
			.og .site {
				margin-top: auto;
				display: flex;
				align-items: center;
				gap: 12px;
				font-size: 26px;
				font-weight: 700;
				color: #4b5563;
			}
			.og .site .dot {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background: #facc15;
			}
			.og .diagram {
				width: 360px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.og .diagram .court {
				margin: 0;
				max-width: none;
				width: 100%;
			}
			.og .diagram svg {
				display: block;
				max-height: 518px;
				width: auto;
				max-width: 100%;
				margin: 0 auto;
			}
		</style>
	</head>
	<body>
		<div class="og">
			<div class="text">
				<div class="category">{category}</div>
				<h1>{title}</h1>
				<p class="focus">{drill.focus}</p>
				<div class="site"><span class="dot"></span>ピックルボール ドリル集</div>
			</div>
			<div class="diagram">
				{drill.diagram && <Court diagram={ogDiagram(drill.diagram)} title={title} still />}
			</div>
		</div>
	</body>
</html>
