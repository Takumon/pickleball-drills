---
/**
 * サイト共通の共有プレビュー画像（1200×630）のもとになるページ。トップページと練習メニューの URL で使う。
 * `npm run og` で public/og/site.png に書き出す（scripts/og-images.mjs）。ライトの配色で固定する。
 */
import { readFileSync } from 'node:fs';
const ball = readFileSync('public/favicon.svg', 'utf8');
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>ピックルボール ドリル集</title>
		<style>
			html,
			body {
				margin: 0;
				background: #f6f7f4;
			}
			.og {
				box-sizing: border-box;
				width: 1200px;
				height: 630px;
				display: flex;
				align-items: center;
				gap: 64px;
				padding: 0 96px;
				font-family: 'Hiragino Sans', 'Noto Sans CJK JP', 'Noto Sans JP', system-ui, sans-serif;
				color: #111827;
				/* 下にコートの緑の帯を敷いて、ピックルボールのサイトだと分かるようにする */
				background: linear-gradient(to bottom, #f6f7f4 0 78%, #2f6b48 78% 100%);
			}
			.ball {
				width: 240px;
				height: 240px;
				flex: none;
			}
			.ball :global(svg) {
				width: 100%;
				height: 100%;
			}
			h1 {
				font-size: 76px;
				line-height: 1.2;
				margin: 0 0 20px;
			}
			p {
				font-size: 34px;
				color: #374151;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<div class="og">
			<div class="ball" set:html={ball} />
			<div>
				<h1>ピックルボール<br />ドリル集</h1>
				<p>練習会で使うドリルと練習メニュー</p>
			</div>
		</div>
	</body>
</html>
