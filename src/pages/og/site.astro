---
/**
 * サイト共通の共有プレビュー画像（1200×630）のもとになるページ。トップページと練習メニューの URL で使う。
 * `npm run og` で public/og/site.png に書き出す（scripts/og-images.mjs）。
 * デザイン: Bento Grid（角の丸いタイルを並べる）。配色は深い緑（練馬ピックルのロゴの緑）×生成り×ライム。
 * 練馬ピックルの名前は、右下のタイルに小さく入れる（主張は控えめに）。タイルはボールのタイルと同じ濃い緑で、
 * ライム（差し色）はボールとコートの点線だけに使う。
 */
import { getCollection } from 'astro:content';
import { categories } from '../../config/categories';
import { og } from '../../config/og';
import { DEPTHS, LANES } from '../../config/court';
// 右上のタイル: ドリルがあるカテゴリの名前（並びはサイドバーと同じ）。全部ではないと分かるように、最後に etc. を付ける。
// 長い名前は「・」の前だけにする（スピードアップ・ファイヤーファイト → スピードアップ）
const used = new Set((await getCollection('docs')).flatMap((e) => (e.data.drill ? [e.data.drill.category] : [])));
// タイルに収まるのは5行まで（カテゴリが増えても、並び順で先の5つだけを出す）
const shown = categories.filter((c) => used.has(c.code)).slice(0, 5).map((c) => (c.label.length > 9 ? c.label.split('・')[0] : c.label));
// 画像の中ではコートが小さく見えるので、人をドリルの図の K 倍で描く
const K = 1.5;
// 人の絵（ドリルの図と同じ形: 体の丸・腕・パドル）。A は奥で下向き、B は手前で上向き。全員右利き
const person = (id: string, x: number, y: number, me: boolean) => {
	const f = y < 22 ? [0, 1] : [0, -1]; // 前
	const r = [-f[1], f[0]]; // 本人から見た右
	const at = (dr: number, df: number) => [x + (r[0] * dr + f[0] * df) * K, y + (r[1] * dr + f[1] * df) * K];
	const hand = at(1.55, 1.15);
	const tip = at(2.05, 1.6);
	return { id, x, y, me, shoulder: at(0.9, 0.5), hand, tip, face: [(hand[0] + tip[0]) / 2, (hand[1] + tip[1]) / 2] };
};
// クロスのディンク: 2人ともキッチンラインのすぐ後ろで、自分の半面の真ん中（ドリルの図の left・right と同じ値）。これより端に寄せると、拡大したパドルがコートからはみ出す
const A = person('A', LANES.left, DEPTHS.far.kitchen, false);
const B = person('B', LANES.right, DEPTHS.near.kitchen, true);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>ピックルボール ドリル集</title>
		<style define:vars={og}>
			html,
			body {
				margin: 0;
			}
			* {
				box-sizing: border-box;
			}
			svg {
				display: block;
			}
			.og {
				width: 1200px;
				height: 630px;
				overflow: hidden;
				font-family: 'Hiragino Sans', 'Noto Sans CJK JP', 'Noto Sans JP', system-ui, sans-serif;
				background: var(--bg);
				padding: var(--padY) var(--padX);
				display: grid;
				grid-template-columns: 1.55fr 1fr 0.9fr;
				grid-template-rows: 1fr 1fr;
				gap: 16px;
			}
			.tile {
				border-radius: 28px;
				overflow: hidden;
			}
			.main {
				grid-row: 1 / 3;
				background: var(--paper);
				color: var(--ink);
				padding: 44px 48px;
				display: flex;
				flex-direction: column;
			}
			.eyebrow {
				font-size: 18px;
				font-weight: 800;
				letter-spacing: 0.28em;
				color: var(--green);
			}
			h1 {
				font-size: 84px;
				line-height: 1.05;
				margin: 20px 0 0;
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			.sub {
				margin-top: auto;
				font-size: 22px;
				opacity: 0.8;
				white-space: nowrap;
			}
			.court {
				grid-row: 1 / 3;
				background: var(--tile);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 26px;
			}
			.court svg {
				height: 100%;
			}
			.cats {
				background: var(--tile);
				color: var(--paper);
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 22px 26px;
				font-size: 21px;
				font-weight: 800;
				line-height: 1.55;
			}
			.cats .etc {
				color: var(--lime);
			}
			.brand {
				background: var(--tile);
				color: var(--paper);
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 22px 26px;
			}
			.brand small {
				font-size: 15px;
				letter-spacing: 0.2em;
				opacity: 0.7;
				font-weight: 700;
			}
			.brand b {
				font-size: 28px;
				margin-top: 6px;
			}
		</style>
	</head>
	<body>
		<div class="og">
			<div class="tile main">
				<div class="eyebrow">PICKLEBALL DRILLS</div>
				<h1>ピックル<br />ボール<br />ドリル集</h1>
				<div class="sub">アニメーションで理解する練習方法</div>
			</div>
			<div class="tile court">
				<svg viewBox="0 0 20 44" aria-hidden="true">
					<rect width="20" height="44" fill={og.green}></rect>
					<rect y="15" width="20" height="14" fill={og.green2}></rect>
					<g fill="none" stroke={og.paper} stroke-width="0.3">
						<rect width="20" height="44"></rect>
						<line x1="0" y1="15" x2="20" y2="15"></line>
						<line x1="0" y1="29" x2="20" y2="29"></line>
						<line x1="10" y1="0" x2="10" y2="15"></line>
						<line x1="10" y1="29" x2="10" y2="44"></line>
					</g>
					<line x1="-1" y1="22" x2="21" y2="22" stroke={og.paper} stroke-width="0.4" stroke-dasharray="0.8 0.5"></line>
					<line x1={A.face[0]} y1={A.face[1]} x2={B.face[0]} y2={B.face[1]} stroke={og.lime} stroke-width="0.5" stroke-dasharray="0.6 0.5"></line>
					{[A, B].map((p) => (
						<g>
							<line x1={p.shoulder[0]} y1={p.shoulder[1]} x2={p.hand[0]} y2={p.hand[1]} stroke={og.paper} stroke-width={0.3 * K} stroke-linecap="round"></line>
							<line x1={p.hand[0]} y1={p.hand[1]} x2={p.tip[0]} y2={p.tip[1]} stroke={og.paper} stroke-width={0.45 * K} stroke-linecap="round"></line>
							<circle cx={p.x} cy={p.y} r={1.2 * K} fill="none" stroke="rgb(0 0 0 / 0.55)" stroke-width={0.4 * K}></circle>
							<circle cx={p.x} cy={p.y} r={1.0 * K} fill={p.me ? og.paper : og.ink} stroke={og.paper} stroke-width={0.22 * K}></circle>
							{p.me && <circle cx={p.x} cy={p.y} r={0.72 * K} fill="none" stroke={og.ink} stroke-width={0.14 * K}></circle>}
							<text x={p.x} y={p.y} font-size={1.0 * K} font-weight="700" text-anchor="middle" dominant-baseline="central" font-family="system-ui, sans-serif" fill={p.me ? og.ink : og.paper}>{p.id}</text>
						</g>
					))}
				</svg>
			</div>
			<div class="tile cats">
				{shown.map((label) => <div>{label}</div>)}
				<div class="etc">etc.</div>
			</div>
			<div class="tile brand"><small>BY</small><b>練馬ピックル</b></div>
		</div>
	</body>
</html>
